"checksum": "3671341193", "data": "          \"source_file\": source_path.split(\"/\")[-1],\n          \"block_size\": block_size,\n          \"", "line_end": 310, "line_start": 305}, {"block_index": 62, "checksum": "1320764195", "data": "\n      # Create GC parity (par2-two) - weighted XOR\n      gc_blocks = []\n      for i in range(0, len", "line_end": 315, "line_start": 310}, {"block_index": 63, "checksum": "4132351981", "data": "          parity = [0] * block_size\n          for j, block in enumerate(group):\n              for k ", "line_end": 320, "line_start": 315}, {"block_index": 64, "checksum": "1084039402", "data": "              \"chunk_index\": len(gc_blocks),\n              \"parity\": parity,\n              \"block_ra", "line_end": 325, "line_start": 320}, {"block_index": 65, "checksum": "1824162400", "data": "      gc_parity = {\n          \"source_file\": source_path.split(\"/\")[-1],\n          \"chunk_size\": 5,\n", "line_end": 330, "line_start": 325}, {"block_index": 66, "checksum": "748442855", "data": "      }\n\n      # Compute checksums (must use sort_keys=True to match verifier)\n      rs_serialized =", "line_end": 335, "line_start": 330}, {"block_index": 67, "checksum": "1031855860", "data": "\n      gc_serialized = json.dumps(gc_parity, sort_keys=True).encode()\n      gc_checksum = hashlib.sh", "line_end": 340, "line_start": 335}, {"block_index": 68, "checksum": "4213902810", "data": "          \"rs_parity\": rs_parity,\n          \"gc_parity\": gc_parity,\n          \"source_hash\": source_", "line_end": 345, "line_start": 340}, {"block_index": 69, "checksum": "3911624226", "data": "      }\n    except Exception:\n        pass  # exception handled gracefully\n\n", "line_end": 350, "line_start": 345}, {"block_index": 70, "checksum": "1695737777", "data": "def store_parity(source_path: str, parity_data: dict) -> dict:\n    try:\n      \"\"\"Store split parity ", "line_end": 355, "line_start": 350}, {"block_index": 71, "checksum": "2141123698