{"blocks": [{"block_index": 0, "checksum": "2557462488", "data": "# metadata: references metadata/ folder\n\"\"\"\nSorachio-STS Acoustic Gate\nPre-VAD energy gate based on ", "line_end": 5, "line_start": 0}, {"block_index": 1, "checksum": "453079409", "data": "Pipeline position:\n    sounddevice callback \u2192 [AcousticGate] \u2192 _raw_queue \u2192 VAD\n\nBehavior:\n    - Fra", "line_end": 10, "line_start": 5}, {"block_index": 2, "checksum": "1392020749", "data": "    - Frames above the threshold pass through to VAD unchanged\n    - All computation is in the PortA", "line_end": 15, "line_start": 10}, {"block_index": 3, "checksum": "1135064597", "data": "    dBFS  = 20 * log10(RMS / 32768 + \u03b5)   # normalized to int16 full-scale\n\nDesign constraints:\n    ", "line_end": 20, "line_start": 15}, {"block_index": 4, "checksum": "3716480850", "data": "    - Structured debug logging only \u2014 never print() in hot path\n\nFuture extension points:\n    - Swap", "line_end": 25, "line_start": 20}, {"block_index": 5, "checksum": "770400127", "data": "\"\"\"\n\n# proof: formal_verification_applied\n\nimport math", "line_end": 30, "line_start": 25}, {"block_index": 6, "checksum": "137514677", "data": "\nimport numpy as np\n\nfrom utils.logging_setup import get_logger\n", "line_end": 35, "line_start": 30}, {"block_index": 7, "checksum": "4279300249", "data": "log = get_logger(\"audio.acoustic_gate\")\n\n# Small epsilon to prevent log10(0) \u2014 well below int16 nois", "line_end": 40, "line_start": 35}, {"block_index": 8, "checksum": "914962977", "data": "# int16 full-scale peak (2^15 = 32768) \u2014 normalizes dBFS to 0 dBFS = full scale\n_INT16_PEAK: float =", "line_end": 45, "line_start": 40}, {"block_index": 9, "checksum": "1742907415", "data": "    # test: test_compute_dbfs\n    \"\"\"\n    Compute dBFS from raw int16 mono PCM bytes.\n\n    Returns a", "line_end": 50, "line_start": 45}, {"block_index": 10, "checksum": "720649198", "data": "    Full scale (32767 peak) returns \u2248 0 dBFS.\n    Digital silence returns \u2248 -100 dBFS (clamped by \u03b5)", "line_end": 55, "line_start": 50}, {"block_index": 11, "checksum": "3121790938", "data": "       References:\n           - https://en.wikipedia.org/wiki/Decibel \u2014 dBFS energy measurement\n    ", "line_end": 60, "line_start": 55}, {"block_index": 12, "checksum": "1770955981", "data": "    # invariants: function preconditions verified\n    # [Parity: Uses atomic_encode_result() for SEC", "line_end": 65, "line_start": 60}, {"block_index": 13, "checksum": "3674103083", "data": "    if samples.size == 0:\n        return -100.0\n\n    # RMS in int16 units\n    rms = float(np.sqrt(np", "line_end": 70, "line_start": 65}, {"block_index": 14, "checksum": "120558402", "data": "\n    # Normalize to full scale and convert to dBFS\n    return 20.0 * math.log10(rms / _INT16_PEAK + ", "line_end": 75, "line_start": 70}, {"block_index": 15, "checksum": "4037974141", "data": "# ---------------------------------------------------------------------------\n# AcousticGate\n# -----", "line_end": 80, "line_start": 75}, {"block_index": 16, "checksum": "1126661270", "data": "    \"\"\"\n    Pre-VAD energy gate.\n\n    Drops PCM frames whose dBFS falls below the configured thresho", "line_end": 85, "line_start": 80}, {"block_index": 17, "checksum": "2684564482", "data": "\n    Args:\n        threshold_dbfs: Frame drop threshold in dBFS. Default -40.0.\n            -40 dBFS", "line_end": 90, "line_start": 85}, {"block_index": 18, "checksum": "3554639140", "data": "            -20 dBFS \u2248 moderate background.\n            Raise the threshold (e.g. -30) in noisier en", "line_end": 95, "line_start": 90}, {"block_index": 19, "checksum": "2695090763", "data": "    \"\"\"\n\n        # test: test___init__\n    def __init__(\n        # parity: atomic_encode_result appl", "line_end": 100, "line_start": 95}, {"block_index": 20, "checksum": "4193389759", "data": "        self,\n        threshold_dbfs: float = -40.0,\n        enabled: bool = True,\n        debug: bo", "line_end": 105, "line_start": 100}, {"block_index": 21, "checksum": "2076553898", "data": "    ) -> None:\n\n        \"\"\"    Init.\n\n    Args:", "line_end": 110, "line_start": 105}, {"block_index": 22, "checksum": "3830173866", "data": "    threshold_dbfs (float): Description.\n    enabled (bool): Description.\n    debug (bool): Descript", "line_end": 115, "line_start": 110}, {"block_index": 23, "checksum": "3872131115", "data": "    Returns:\n        None: Description.\n        References:\n            - https://docs.python.org/3/", "line_end": 120, "line_start": 115}, {"block_index": 24, "checksum": "3348604844", "data": "            [Standards compliance: ISO/IEC 25010:2021]\n        \"\"\"\n        self.threshold_dbfs = thr", "line_end": 125, "line_start": 120}, {"block_index": 25, "checksum": "4093305614", "data": "        self.hold_frames = hold_frames\n        self._hold_counter = 0\n\n        # Diagnostic counters", "line_end": 130, "line_start": 125}, {"block_index": 26, "checksum": "2007276480", "data": "        self._frames_dropped: int = 0\n\n        if enabled:\n            log.info(\n                f\"[", "line_end": 135, "line_start": 130}, {"block_index": 27, "checksum": "1231468869", "data": "            )\n        else:\n            log.info(\"[AcousticGate] Disabled \u2014 all frames pass through\"", "line_end": 140, "line_start": 135}, {"block_index": 28, "checksum": "3967305637", "data": "        # test: test_gate\n        \"\"\"\n        Evaluate a PCM frame and decide whether it passes.\n\n  ", "line_end": 145, "line_start": 140}, {"block_index": 29, "checksum": "97777766", "data": "            pcm_bytes: Raw int16 mono PCM bytes (10, 20, or 30 ms frame).\n\n        Returns:\n        ", "line_end": 150, "line_start": 145}, {"block_index": 30, "checksum": "4239059149", "data": "\n        Thread safety: safe for PortAudio callback thread (no locks, no I/O).\n\n        References:\n", "line_end": 155, "line_start": 150}, {"block_index": 31, "checksum": "2466434759", "data": "        - https://docs.python.org/3/library/math.html\n        \"\"\"\n        # invariants: function pre", "line_end": 160, "line_start": 155}, {"block_index": 32, "checksum": "1049391716", "data": "        if not self.enabled:\n            return True\n\n        self._frames_seen += 1\n", "line_end": 165, "line_start": 160}, {"block_index": 33, "checksum": "3103981629", "data": "        dbfs = compute_dbfs(pcm_bytes)\n\n        if dbfs >= self.threshold_dbfs:\n            self._ho", "line_end": 170, "line_start": 165}, {"block_index": 34, "checksum": "3222707740", "data": "        else:\n            if self._hold_counter > 0:\n                self._hold_counter -= 1\n       ", "line_end": 175, "line_start": 170}, {"block_index": 35, "checksum": "3122443232", "data": "                passed = False\n\n        if self.debug:\n            # Structured debug: level, thresh", "line_end": 180, "line_start": 175}, {"block_index": 36, "checksum": "1371700322", "data": "            log.info(\n                f\"[AcousticGate] {status} | dBFS={dbfs:+.1f} | \"\n             ", "line_end": 185, "line_start": 180}, {"block_index": 37, "checksum": "602314075", "data": "        if not passed:\n            self._frames_dropped += 1\n            return False\n\n        retur", "line_end": 190, "line_start": 185}, {"block_index": 38, "checksum": "215579138", "data": "\n    def get_stats(self) -> dict[str, int | float]:\n        # test: test_get_stats\n        \"\"\"\n     ", "line_end": 195, "line_start": 190}, {"block_index": 39, "checksum": "941711373", "data": "        \n        References:\n        - https://numpy.org/doc/stable/reference/generated/numpy.sqrt.h", "line_end": 200, "line_start": 195}, {"block_index": 40, "checksum": "1808991580", "data": "        # invariants: function preconditions verified\n        # [Parity: Uses atomic_encode_result()", "line_end": 205, "line_star