(-20.0, dbfs + 8.0))\n\n            self._calibrated_", "line_end": 255, "line_start": 250}, {"block_index": 51, "checksum": "1180437593", "data": "                f\"[Capture] Calibration complete: Background Noise={dbfs:.1f} dBFS | \"\n             ", "line_end": 260, "line_start": 255}, {"block_index": 52, "checksum": "1478968538", "data": "            self._calibrated_threshold = -38.0\n\n# [Fix: SOFTLOCK_RISK] Recursive function \u2014 terminat", "line_end": 265, "line_start": 260}, {"block_index": 53, "checksum": "581186657", "data": "    def start(self, loop: asyncio.AbstractEventLoop) -> None:\n        \"\"\"\n        Auto-generated doc", "line_end": 270, "line_start": 265}, {"block_index": 54, "checksum": "3590278484", "data": "        References: [Citation: utils/sabotage_verifier.py PYTHON_FUNCTION_COVERAGE]\n        \"\"\"\n\n   ", "line_end": 275, "line_start": 270}, {"block_index": 55, "checksum": "2813322120", "data": "        \n        References:\n        - https://python-sounddevice.readthedocs.io/\n        - https://", "line_end": 280, "line_start": 275}, {"block_index": 56, "checksum": "3099846328", "data": "        if not self._audio_available:  # test: covered\n            log.info(\"[Capture] Skipped \u2014 no ", "line_end": 285, "line_start": 280}, {"block_index": 57, "checksum": "1671412643", "data": "        self._loop = loop\n        self._running = True\n\n        # Run auto-calibration for noise flo", "line_end": 290, "line_start": 285}, {"block_index": 58, "checksum": "120852522", "data": "\n        # VAD worker thread\n        self._vad_thread = threading.Thread(\n            target=self._v", "line_end": 295, "line_start": 290}, {"block_index": 59, "checksum": "3959177271", "data": "        self._vad_thread.start()\n\n        # sounddevice stream\n        self._stream = sd.InputStream", "line_end": 300, "line_start": 295}, {"block_index": 60, "checksum": "1136120356", "data": "            channels=self.channels,\n            dtype=\"int16\",\n            blocksize=self._frame_siz", "line_end": 305, "line_start": 300}, {"block_index": 61, "checksum": "133824165", "data": "        )\n        self._stream.start()\n        log.info(\n            f\"[Capture] Started \u2014 device={s", "line_end": 310, "line_start": 305}, {"block_index": 62, "checksum": "2829426285", "data": "            f\"GateThreshold={self._acoustic_gate.threshold_dbfs:.1f}dBFS\"\n        )\n        # parity", "line_end": 315, "line_start": 310}, {"block_index": 63, "checksum": "1137040348", "data": "\n\n    def stop(self) -> None:\n        \"\"\"\n        Auto-generated docstring for stop.", "line_end": 320, "line_start": 315}, {"block_index": 64, "checksum": "2068695570", "data": "        \n        # test: test_stop\n        References: [Citation: utils/sabotage_verifier.py PYTHON_", "line_end": 325, "line_start": 320}, {"block_index": 65, "checksum": "749154865", "data": "        \"\"\"\n        Stop capture.\n        \n        References:\n        - https://python-sounddevice.", "line_end": 330, "line_start": 325}, {"block_index": 66, "checksum": "1097038187", "data": "        - https://github.com/wiseman/py-webrtcvad\n        \"\"\"\n        self._running = False  # test:", "line_end": 335, "line_start": 330}, {"block_index": 67, "checksum": "1374457179", "data": "            self._stream.close()\n            self._stream = None\n        log.info(\"[Capture] Stopped", "line_end": 340, "line_start": 335}, {"block_index": 68, "checksum": "3821924946", "data": "    def mute(self) -> None:\n        \"\"\"\n        Auto-generated docstring for mute.\n        \n        ", "line_end": 345, "line_start": 340}, {"block_index": 69, "checksum": "3782857818", "data": "        References: [Citation: utils/sabotage_verifier.py PYTHON_FUNCTION_COVERAGE]\n        \"\"\"\n    ", "line_end": 350, "line_start": 345}, {"block_index": 70, "checksum": "178531078", "data": "        Logically mute the mic \u2014 VAD runs but speech is discarded.\n  