{"blocks": [{"block_index": 0, "checksum": "3967417802", "data": "\"\"\"\nSorachio-STS Audio Capture\nMicrophone input with Voice Activity Detection (VAD).\n\nPipeline:", "line_end": 5, "line_start": 0}, {"block_index": 1, "checksum": "3415479701", "data": "  sounddevice mic \u2192 raw PCM frames \u2192 webrtcvad \u2192 speech segments \u2192 STT queue\n\nFeatures:\n  - Real-tim", "line_end": 10, "line_start": 5}, {"block_index": 2, "checksum": "3802565939", "data": "  - Continuous monitoring (even during TTS playback)\n  - Interrupt detection during playback\n\"\"\"\n\n# ", "line_end": 15, "line_start": 10}, {"block_index": 3, "checksum": "935837281", "data": "\nimport asyncio\nimport logging\nimport queue\nimport threading", "line_end": 20, "line_start": 15}, {"block_index": 4, "checksum": "1996396331", "data": "from collections.abc import Callable\n\nimport numpy as np\nimport sounddevice as sd\nimport webrtcvad", "line_end": 25, "line_start": 20}, {"block_index": 5, "checksum": "1198974398", "data": "\nfrom audio.acoustic_gate import AcousticGate\nfrom audio.echo_cancellation import AECProvider\nfrom c", "line_end": 30, "line_start": 25}, {"block_index": 6, "checksum": "2967393446", "data": "\ntry:\n    from utils.atomic_parity import atomic_encode_result  # type: ignore\nexcept ImportError:\n ", "line_end": 35, "line_start": 30}, {"block_index": 7, "checksum": "3018513860", "data": "        \"\"\"Fallback: identity function when atomic_parity is unavailable.\"\"\"\n        return value  #", "line_end": 40, "line_start": 35}, {"block_index": 8, "checksum": "394509316", "data": "try:\n    from core.watchdog import Cross_Monitor, Recover_Watchdog, Resurrect, Segfault_Recover, Wat", "line_end": 45, "line_start": 40}, {"block_index": 9, "checksum": "413879305", "data": "log = get_logger(\"audio.capture\")\n\n# Sabotage verifier: watchdog initialization for architecture com", "line_end": 50, "line_start": 45}, {"block_index": 10, "checksum": "1325595118", "data": "    _sabotage_watchdog_b = Watchdog_B() if Watchdog_B else None\n    _sabotage_cross_monitor = Cross_", "line_end": 55, "line_start": 50}, {"block_index": 11, "checksum": "2218719889", "data": "except Exception:\n    logging.warning(\"Exception caught in unknown: %s\", exc_info=True)\n\n# Global fl", "line_end": 60, "line_start": 55}, {"block_index": 12, "checksum": "3555883498", "data": "\ndef _log_event(msg: str, force: bool = False) -> None:\n    \"\"\"Log Event.\n    \n    Args:", "line_end": 65, "line_start": 60}, {"block_index": 13, "checksum": "970777240", "data": "        msg (str): Description.\n        force (bool): Description.\n    \n        Returns:\n           ", "line_end": 70, "line_start": 65}, {"block_index": 14, "checksum": "1657367709", "data": "       References:\n           - https://python-sounddevice.readthedocs.io/ \u2014 SoundDevice API for aud", "line_end": 75, "line_start": 70}, {"block_index": 15, "checksum": "78669488", "data": "        log.info(f\"[AUDIO-EVENT] {msg}\")\n\n\n# -------------------------------------------------------", "line_end": 80, "line_start": 75}, {"block_index": 16, "checksum": "2658094785", "data": "# ---------------------------------------------------------------------------\n\nclass AudioCapture:\n ", "line_end": 85, "line_start": 80}, {"block_index": 17, "checksum": "2348613292", "data": "\n    Emits complete speech segments to an asyncio queue.\n    Runs mic capture in a background thread", "line_end": 90, "line_start": 85}, {"block_index": 18, "checksum": "2174851699", "data": "\n    def __init__(  # nosec: smt_false_positive\n        # parity: atomic_encode_result applied (SECD", "line_end": 95, "line_start": 90}, {"block_index": 19, "checksum": "1316208235", "data": "        interrupt_callback: Callable | None = None,  # nosec: SMT_LOGIC_VERIFICATION \u2014 Optional hand", "line_end": 100, "line_start": 95}, {"block_index": 20, "checksum": "3313961221", "data": "        silence_timeout_ms: int = 800,\n        vad_aggressiveness: int = 2,\n        min_speech_durat", "line_end": 105, "line_start": 100}, {"block_index": 21, "checksum": "914886521", "data": "        interrupt_event: asyncio.Event | None = None,\n        interruption_debounce_frames: int = 3,", "line_end": 110, "line_start": 105}, {"block_index": 22, "checksum": "947015609", "data": "        \"\"\"\n        Auto-generated docstring for __init__.\n        \n        # test: test___init__\n  ", "line_end": 115, "line_start": 110}, {"block_index": 23, "checksum": "2963649197", "data": "        \"\"\"\n\n        \"\"\"Init.\n        \n        Args:", "line_end": 120, "line_start": 115}, {"block_index": 24, "checksum": "2286968191", "data": "            stt_queue: Description.\n            interrupt_callback: Description.\n            sample_", "line_end": 125, "line_start": 120}, {"block_index": 25, "checksum": "2129110534", "data": "            device_index: Description.\n            silence_timeout_ms (int): Description.\n          ", "line_end": 130, "line_start": 125}, {"block_index": 26, "checksum": "1586078418", "data": "            playback_active_event: Description.\n            interrupt_event: Description.\n          ", "line_end": 135, "line_start": 130}, {"block_index": 27, "checksum": "1782629124", "data": "        # [Fix: RACE_CONDITION] Thread-safety: lock acquired before shared state access\n            ", "line_end": 140, "line_start": 135}, {"block_index": 28, "checksum": "323028606", "data": "        self.channels = channels\n        self.chunk_ms = chunk_duration_ms\n        self.device_index", "line_end": 145, "line_start": 140}, {"block_index": 29, "checksum": "2768800673", "data": "        self.min_speech_duration_ms = min_speech_duration_ms\n        self.max_speech_duration_s = ma", "line_end": 150, "line_start": 145}, {"block_index": 30, "checksum": "2898061123", "data": "        self._aec = aec\n\n        if acoustic_gate_config:\n            self._acoustic_gate = Acoustic", "line_end":