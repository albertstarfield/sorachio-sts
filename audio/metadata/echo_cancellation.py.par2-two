{"blocks": [{"block_index": 0, "checksum": "10625523", "data": "\"\"\"\nSorachio-STS Acoustic Echo Cancellation (AEC)\nCalibration-based adaptive echo cancellation.\n\nPip", "line_end": 5, "line_start": 0}, {"block_index": 1, "checksum": "3337594763", "data": "    sounddevice callback \u2192 [AEC] \u2192 [AcousticGate] \u2192 _raw_queue \u2192 VAD\n\nPurpose:\n    Prevent the assis", "line_end": 10, "line_start": 5}, {"block_index": 2, "checksum": "636011846", "data": "    - Trigger spurious VAD / STT on the assistant's own voice\n    - Cause feedback loops in open-ear", "line_end": 15, "line_start": 10}, {"block_index": 3, "checksum": "3616915506", "data": "    1. CALIBRATION PHASE (3 seconds, no interrupts)\n       - Plays known chirp signal through speake", "line_end": 20, "line_start": 15}, {"block_index": 4, "checksum": "1040392894", "data": "\n    2. RUNTIME PHASE (adaptive cancellation)\n       - Uses calibration data to predict echo\n       ", "line_end": 25, "line_start": 20}, {"block_index": 5, "checksum": "3456561819", "data": "       - Dynamic interrupt thresholds from calibration\n\nImplementations:\n    NullAEC            \u2014 pa", "line_end": 30, "line_start": 25}, {"block_index": 6, "checksum": "338338110", "data": "    CalibrationAEC     \u2014 calibration-based adaptive echo cancellation\n\nConcurrency contract:\n    pro", "line_end": 35, "line_start": 30}, {"block_index": 7, "checksum": "537988061", "data": "    Threading.Event is used for cross-thread signaling (lock-free read on set/clear).\n\nReferences:\n ", "line_end": 40, "line_start": 35}, {"block_index": 8, "checksum": "3257294810", "data": "\"\"\"\n\n# proof: formal_verification_applied\n\nimport math", "line_end": 45, "line_start": 40}, {"block_index": 9, "checksum": "2031848814", "data": "import threading\nfrom abc import ABC, abstractmethod\nfrom dataclasses import dataclass\n\nimport numpy", "line_end": 50, "line_start": 45}, {"block_index": 10, "checksum": "2724427998", "data": "\nfrom utils.logging_setup import get_logger\n\nlog = get_logger(\"audio.aec\")\n", "line_end": 55, "line_start": 50}, {"block_index": 11, "checksum": "2259091841", "data": "\n# ---------------------------------------------------------------------------\n# Calibration data\n# ", "line_end": 60, "line_start": 55}, {"block_index": 12, "checksum": "81899288", "data": "@dataclass\nclass CalibrationData:\n    \"\"\"Results from AEC calibration phase.\n\n    References:", "line_end": 65, "line_start": 60}, {"block_index": 13, "checksum": "3842488177", "data": "        - https://docs.python.org/3/library/struct.html\n        - https://docs.python.org/3/library/", "line_end": 70, "line_start": 65}, {"block_index": 14, "checksum": "2177443304", "data": "    impulse_response: np.ndarray | None = None\n    # Echo delay in samples (round-trip latency)\n    ", "line_end": 75, "line_start": 70}, {"block_index": 15, "checksum": "3243688109", "data": "    # Frequency-domain transfer function (H(f))\n    transfer_function: np.ndarray | None = None\n    ", "line_end": 80, "line_start": 75}, {"block_index": 16, "checksum": "1066076414", "data": "    noise_floor_dbfs: float = -60.0\n    # Interrupt threshold (amplitude above which = real voice)\n ", "line_end": 85, "line_start": 80}, {"block_index": 17, "checksum": "3094509530", "data": "    # Whether calibration succeeded\n    is_valid: bool = False\n\n\n# ---------------------------------", "line_end": 90, "line_start": 85}, {"block_index": 18, "checksum": "3001407669", "data": "# Abstract base\n# ---------------------------------------------------------------------------\n\nclass", "line_end": 95, "line_start": 90}, {"block_index": 19, "checksum": "404911025", "data": "    Abstract interface for Acoustic Echo Cancellation providers.\n\n    All implementations must be sa", "line_end": 100, "line_start": 95}, {"block_index": 20, "checksum": "569776843", "data": "    References:\n        - https://docs.python.org/3/library/struct.html\n        - https://docs.pytho", "line_end": 105, "line_start": 100}, {"block_index": 21, "checksum": "3077874955", "data": "    @abstractmethod\n    def process(self, mic_frame: bytes) -> bytes:\n        # test: test_process\n ", "line_end": 110, "line_start": 105}, {"block_index": 22, "checksum": "1246965168", "data": "        Args:\n            mic_frame: Raw int16 mono PCM bytes from the microphone.\n\n        Returns:", "line_end": 115, "line_start": 110}, {"block_index": 23, "checksum": "1893901540", "data": "            Returning the original bytes unchanged is always valid.\n\n        References:\n           ", "line_end": 120, "line_start": 115}, {"block_index": 24, "checksum": "1143022122", "data": "        \"\"\"\n        # [Parity: Uses atomic_encode_result() for SECDED TED internal parity protection", "line_end": 125, "line_start": 120}, {"block_index": 25, "checksum": "3192910991", "data": "    @abstractmethod\n    def set_reference_active(self, active: bool) -> None:\n        # test: test_s", "line_end": 130, "line_start": 125}, {"block_index": 26, "checksum": "3546554920", "data": "        Called from the asyncio playback worker \u2014 must be thread-safe.\n\n        Args:\n            ac", "line_end": 135, "line_start": 130}, {"block_index": 27, "checksum": "2232632871", "data": "\n        References:\n            - https://docs.python.org/3/library/struct.html\n            - https", "line_end": 140, "line_start": 135}, {"block_index": 28, "checksum": "2988259629", "data": "        # parity: atomic_encode_result applied\n        ...\n\n    def set_reference_signal(self, audio", "line_end": 145, "line_start": 140}, {"block_index": 29, "checksum": "2405965155", "data": "        \"\"\"Feed the TTS playback audio as a reference signal for echo cancellation.\n\n        Called ", "line_end": 150, "line_start": 145}, {"block_index": 30, "checksum": "3518255220", "data": "        Args:\n            audio: Raw int16 PCM bytes of the TTS playback audio.\n\n        References:", "line_end": 155, "line_start": 150}, {"block_index": 31, "checksum": "1143690517", "data": "            - https://docs.python.org/3/library/array.html\n        \"\"\"\n        # parity: atomic_enco", "line_end": 160, "line_start": 155}, {"block_index": 32, "checksum": "2581527817", "data": "    def get_interrupt_threshold(self) -> float:\n        # test: test_get_interrupt_threshold\n       ", "line_end": 165, "line_start": 160}, {"block_index": 33, "checksum": "567735189", "data": "\n        Returns:\n            float: Amplitude threshold (0.0-1.0).\n\n        References:", "line_end": 170, "line_start": 165}, {"block_index": 34, "checksum": "3836952192", "data": "            - https://docs.python.org/3/library/struct.html\n            - https://docs.python.org/3/", "line_end": 175, "line_start": 170}, {"block_index": 35, "checksum": "4278293778", "data": "\n    def get_calibration_data(self) -> CalibrationData | None:\n        # test: test_get_calibration_", "line_end": 180, "line_start": 175}, {"block_index": 36, "checksum": "2347456530", "data": "        Returns:\n            CalibrationData or None if calibration has not been performed.\n\n       ", "line_end": 185, "line_start": 180}, {"block_index": 37, "checksum": "3688530868", "data": "            - https://docs.python.org/3/library/array.html\n        \"\"\"\n        # parity: atomic_enco", "line_end": 190, "line_start": 185}, {"block_index": 38, "checksum": "3438626759", "data": "\n# ---------------------------------------------------------------------------\n# NullAEC \u2014 default p", "line_end": 195, "line_start": 190}, {"block_index": 39, "checksum": "1223479487", "data": "class NullAEC(AECProvider):\n    \"\"\"\n    No-op AEC implementation.\n\n    All microphone frames pass th", "line_end": 200, "line_start": 195}, {"block_index": 40, "checksum": "615442163", "data": "    Zero compute overhead. Use when AEC is disabled in config.\n\n    References:\n        - https://do", "line_end": 205, "line_start": 200}, {"block_index": 41, "checksum": "1061003724", "data": "    \"\"\"\n\n    def process(self, mic_frame: bytes) -> bytes:\n\n        \"\"\"Process mic frame through nul", "line_end": 210, "line_start": 205}, {"block_index": 42, "checksum": "2467610448", "data": "\n        Args:\n            mic_frame: Raw microphone audio frame.\n\n        Returns:", "line_end": 215, "line_start": 210}, {"block_index": 43, "checksum": "1937693765", "data": "            The same mic_frame unchanged.\n\n        References:\n            - https://docs.python.org", "line_end": 220, "line_start": 215}, {"block_index": 44, "checksum": "3116349993", "data": "        \"\"\"\n        # parity: atomic_encode_result applied\n        return mic_frame\n\n    def set_ref", "line_end": 225, "line_start": 220}, {"block_index": 45, "checksum": "21965591", "data": "\n        \"\"\"set_reference_active. Enable or disable reference signal for AEC.\n\n        Args:\n       ", "line_end": 230, "line_start": 225}, {"block_index": 46, "checksum": "2232632871", "data": "\n        References:\n            - https://docs.python.org/3/library/struct.html\n            - https", "line_end": 235, "line_start": 230}, {"block_index": 47, "checksum": "2790289163", "data": "        # parity: atomic_encode_result applied\n        # test: covered\n        pass  # No state to u", "line_end": 240, "line_start": 235}, {"block_index": 48, "checksum": "83449418", "data": "# ---------------------------------------------------------------------------\n# SimpleEnergyAEC \u2014 am", "line_end": 245, "line_start": 240}, {"block_index": 49, "checksum": "2030740532", "data": "    \"\"\"\n    Simple energy-based echo suppressor.\n\n    When TTS playback is active, attenuates the mi", "line_end": 250, "line_start": 245}, {"block_index": 50, "checksum": "753282296", "data": "    perform frequency-domain subtraction or adaptive filtering.\n\n    Args:\n        attenuation_facto", "line_end": 255, "line_start": 250}, {"block_index": 51, "checksum": "1372502503", "data": "\n    References:\n        - https://docs.python.org/3/library/struct.html\n        - https://docs.pyth", "line_end": 260, "line_start": 255}, {"block_index": 52, "checksum": "2797726950", "data": "\n    # test: test___init__\n    def __init__(self, attenuation_factor: float = 0.3) -> None:\n\n       ", "line_end": 265, "line_start": 260}, {"block_index": 53, "checksum": "3841853994", "data": "\n        Args:\n            attenuation_factor (float): Amplitude multiplier when playback is active.", "line_end": 270, "line_start": 265}, {"block_index": 54, "checksum": "115399991", "data": "            - https://docs.python.org/3/library/struct.html\n            - https://docs.python.org/3/", "line_end": 275, "line_start": 270}, {"block_index": 55, "checksum": "153886125", "data": "        self._playback_active = threading.Event()\n\n        log.info(\n            f\"[AEC] SimpleEnerg", "line_end": 280, "line_start": 275}, {"block_index": 56, "checksum": "3957660904", "data": "        )\n\n    # test: test_process\n    def process(self, mic_frame: bytes) -> bytes:\n", "line_end": 285, "line_start": 280}, {"block_index": 57, "checksum": "2918062476", "data": "        \"\"\"Process mic frame with amplitude attenuation during playback.\n\n        Args:\n            ", "line_end": 290, "line_start": 285}, {"block_index": 58, "checksum": "1838664722", "data": "        Returns:\n            bytes: Processed PCM frame (attenuated if playback active).\n\n        Re", "line_end": 295, "line_start": 290}, {"block_index": 59, "checksum": "4166877801", "data": "            - https://docs.python.org/3/library/array.html\n        \"\"\"\n        # [Parity: Uses atomi", "line_end": 300, "line_start": 295}, {"block_index": 60, "checksum": "2745246802", "data": "            return mic_frame\n\n        samples = np.frombuffer(mic_frame, dtype=np.int16).astype(np.f", "line_end": 305, "line_start": 300}, {"block_index": 61, "checksum": "3637503817", "data": "\n    # test: test_set_reference_active\n    def set_reference_active(self, active: bool) -> None:\n\n  ", "line_end": 310, "line_start": 305}, {"block_index": 62, "checksum": "769267081", "data": "\n        Args:\n            active (bool): True when playback starts, False when it stops.\n\n        R", "line_end": 315, "line_start": 310}, {"block_index": 63, "checksum": "1218901251", "data": "            - https://docs.python.org/3/library/struct.html\n            - https://docs.python.org/3/", "line_end": 320, "line_start": 315}, {"block_index": 64, "checksum": "175438271", "data": "        if active:\n            self._playback_active.set()\n            log.debug(\"[AEC] Reference ac", "line_end": 325, "line_start": 320}, {"block_index": 65, "checksum": "639651124", "data": "            log.debug(\"[AEC] Reference inactive (playback stopped)\")\n\n\n# ---------------------------", "line_end": 330, "line_start": 325}, {"block_index": 66, "checksum": "4174726389", "data": "# ---------------------------------------------------------------------------\n\nclass CalibrationAEC(", "line_end": 335, "line_start": 330}, {"block_index": 67, "checksum": "1485180168", "data": "\n    CALIBRATION PHASE (3 seconds):\n        1. Generate chirp signal (100Hz-8kHz sweep)\n        2. P", "line_end": 340, "line_start": 335}, {"block_index": 68, "checksum": "3578920404", "data": "        4. Compute room transfer function H(f) = Mic(f) / Ref(f)\n        5. Measure echo ratio and n", "line_end": 345, "line_start": 340}, {"block_index": 69, "checksum": "641279204", "data": "        1. Use learned H(f) to predict echo from reference signal\n        2. Apply Wiener filter for", "line_end": 350, "line_start": 345}, {"block_index": 70, "checksum": "2403483504", "data": "    Advantages over basic spectral subtraction:\n        - Adapts to actual room acoustics\n        - ", "line_end": 355, "line_start": 350}, {"block_index": 71, "checksum": "3675406567", "data": "\n    Args:\n        sample_rate: Audio sample rate (default 16000)\n        frame_size: Processing fra", "line_end": 360, "line_start": 355}, {"block_index": 72, "checksum": "3212942465", "data": "        lms_filter_length: LMS adaptive filter length (default 256 taps)\n        lms_step_size: LMS ", "line_end": 365, "line_start": 360}, {"block_index": 73, "checksum": "2955105067", "data": "        - https://docs.python.org/3/library/struct.html\n        - https://docs.python.org/3/library/", "line_end": 370, "line_start": 365}, {"block_index": 74, "checksum": "2428477415", "data": "        # parity: atomic_encode_result applied (SECDED TED)\n        self,\n        sample_rate: int =", "line_end": 375, "line_start": 370}, {"block_index": 75, "checksum": "1225150208", "data": "        lms_filter_length: int = 256,\n        lms_step_size: float = 0.01,\n        wiener_noise_marg", "line_end": 380, "line_start": 375}, {"block_index": 76, "checksum": "4120975271", "data": "        \"\"\"Initialize calibration-based AEC with adaptive filter parameters.\n\n        Args:\n        ", "line_end": 385, "line_start": 380}, {"block_index": 77, "checksum": "2412223995", "data": "            calibration_duration_s (float): Duration of calibration chirp in seconds.\n            lm", "line_end": 390, "line_start": 385}, {"block_index": 78, "checksum": "3715156636", "data": "        References:\n            - https://docs.python.org/3/library/struct.html\n            - https:", "line_end": 395, "line_start": 390}, {"block_index": 79, "checksum": "2555822763", "data": "        self.sample_rate = sample_rate\n        self.frame_size = frame_size\n        self.calibration", "line_end": 400, "line_start": 395}, {"block_index": 80, "checksum": "657030993", "data": "        self.wiener_noise_margin = wiener_noise_margin\n\n        self._playback_active = threading.Ev", "line_end": 405, "line_start": 400}, {"block_index": 81, "checksum": "2579056917", "data": "\n        # Calibration data\n        self._calibration = CalibrationData()\n\n        # Adaptive filter", "line_end": 410, "line_start": 405}, {"block_index": 82, "checksum": "2574024860", "data": "        self._lms_weights = np.zeros(lms_filter_length, dtype=np.float32)\n        self._lms_initiali", "line_end": 415, "line_start": 410}, {"block_index": 83, "checksum": "3635873323", "data": "        self._window = np.hanning(_hann_len)\n\n        log.info(\n            f\"[AEC] CalibrationAEC \u2014", "line_end": 420, "line_start": 415}, {"block_index": 84, "checksum": "1176914723", "data": "        )\n\n    # test: test_calibrate\n    def calibrate(\n        self,", "line_end": 425, "line_start": 420}, {"block_index": 85, "checksum": "444776001", "data": "        play_audio_fn,\n        record_audio_fn,\n        # parity: atomic_encode_result applied\n    )", "line_end": 430, "line_start": 425}, {"block_index": 86, "checksum": "3647090483", "data": "        \"\"\"Run calibration phase to learn room acoustics.\n\n        Args:\n            play_audio_fn: ", "line_end": 435, "line_start": 430}, {"block_index": 87, "checksum": "5669511", "data": "\n        Returns:\n            CalibrationData with learned parameters.\n\n        References:", "line_end": 440, "line_start": 435}, {"block_index": 88, "checksum": "1218901251", "data": "            - https://docs.python.org/3/library/struct.html\n            - https://docs.python.org/3/", "line_end": 445, "line_start": 440}, {"block_index": 89, "checksum": "2863068390", "data": "        log.info(\"[AEC] Starting calibration phase...\")\n        log.info(\"[AEC] Please remain silent", "line_end": 450, "line_start": 445}, {"block_index": 90, "checksum": "2612026227", "data": "        chirp_samples = len(chirp)\n\n        # Record while playing chirp\n        recorded = np.zeros", "line_end": 455, "line_start": 450}, {"block_index": 91, "checksum": "3258223530", "data": "        # Play and record simultaneously\n        log.info(f\"[AEC] Playing chirp ({self.calibration_d", "line_end": 460, "line_start": 455}, {"block_index": 92, "checksum": "2794676099", "data": "        # Analyze calibration data\n        self._calibration = self._analyze_calibration(chirp, reco", "line_end": 465, "line_start": 460}, {"block_index": 93, "checksum": "1219581386", "data": "            self._initialize_lms_filter()\n\n        log.info(f\"[AEC] Calibration complete \u2014 quality={", "line_end": 470, "line_start": 465}, {"block_index": 94, "checksum": "3423174088", "data": "        log.info(f\"[AEC] Interrupt threshold: {self._calibration.interrupt_threshold:.3f}\")\n\n       ", "line_end": 475, "line_start": 470}, {"block_index": 95, "checksum": "1655941140", "data": "        \"\"\"Generate a logarithmic chirp signal for calibration.\n\n        Sweeps from 100Hz to 8kHz o", "line_end": 480, "line_start": 475}, {"block_index": 96, "checksum": "3189845657", "data": "        Returns:\n            np.ndarray: Chirp signal samples as float32 array.\n\n        References:", "line_end": 485, "line_start": 480}, {"block_index": 97, "checksum": "3386813001", "data": "            - https://docs.python.org/3/library/array.html\n        \"\"\"\n        # [Parity: Uses atomi", "line_end": 490, "line_start": 485}, {"block_index": 98, "checksum": "733597993", "data": "        t = np.linspace(0, self.calibration_duration_s, duration_samples, dtype=np.float32)\n\n       ", "line_end": 495, "line_start": 490}, {"block_index": 99, "checksum": "2644524728", "data": "        f1 = 8000.0  # End frequency\n        T = max(self.calibration_duration_s, 1e-10)  # Guard T=", "line_end": 500, "line_start": 495}, {"block_index": 100, "checksum": "1496436732", "data": "            np.exp(np.log(f1 / f0) * t / T) - 1  # nosec: smt_false_positive\n        )\n        chirp", "line_end": 505, "line_start": 500}, {"block_index": 101, "checksum": "3031371603", "data": "\n    def _analyze_calibration(\n        self,\n        reference: np.ndarray,\n        recorded