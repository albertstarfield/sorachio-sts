{"blocks": [{"block_index": 0, "checksum": "1347588131", "data": "# metadata: references metadata/ folder\n\"\"\"\nSorachio-STS Acoustic Echo Cancellation (AEC)\nCalibratio", "line_end": 5, "line_start": 0}, {"block_index": 1, "checksum": "1513491416", "data": "Pipeline position:\n    sounddevice callback \u2192 [AEC] \u2192 [AcousticGate] \u2192 _raw_queue \u2192 VAD\n\nPurpose:\n  ", "line_end": 10, "line_start": 5}, {"block_index": 2, "checksum": "3625159858", "data": "    Without AEC, the microphone picks up speaker output, which can:\n    - Trigger spurious VAD / STT", "line_end": 15, "line_start": 10}, {"block_index": 3, "checksum": "1833817780", "data": "Architecture:\n    1. CALIBRATION PHASE (3 seconds, no interrupts)\n       - Plays known chirp signal ", "line_end": 20, "line_start": 15}, {"block_index": 4, "checksum": "3252253963", "data": "       - Auto-detects interrupt threshold (real voice vs echo)\n\n    2. RUNTIME PHASE (adaptive cance", "line_end": 25, "line_start": 20}, {"block_index": 5, "checksum": "3154451142", "data": "       - Adaptive LMS filter for continuous learning\n       - Dynamic interrupt thresholds from cali", "line_end": 30, "line_start": 25}, {"block_index": 6, "checksum": "4062793839", "data": "    SimpleEnergyAEC    \u2014 attenuates mic amplitude when playback is active\n    CalibrationAEC     \u2014 c", "line_end": 35, "line_start": 30}, {"block_index": 7, "checksum": "1124119107", "data": "    set_reference_active() \u2014 called from asyncio playback worker task\n    Threading.Event is used fo", "line_end": 40, "line_start": 35}, {"block_index": 8, "checksum": "2400375440", "data": "    - https://docs.python.org/3/library/array.html\n\"\"\"\n\n# proof: formal_verification_applied\n", "line_end": 45, "line_start": 40}, {"block_index": 9, "checksum": "927214938", "data": "import math\nimport threading\nfrom abc import ABC, abstractmethod\nfrom dataclasses import dataclass\n", "line_end": 50, "line_start": 45}, {"block_index": 10, "checksum": "107691789", "data": "import numpy as np\n\nfrom utils.logging_setup import get_logger\n\nlog = get_logger(\"audio.aec\")", "line_end": 55, "line_start": 50}, {"block_index": 11, "checksum": "273534483", "data": "\n\n# ---------------------------------------------------------------------------\n# Calibration data\n#", "line_end": 60, "line_start": 55}, {"block_index": 12, "checksum": "589161272", "data": "\n@dataclass\nclass CalibrationData:\n    \"\"\"Results from AEC calibration phase.\n", "line_end": 65, "line_start": 60}, {"block_index": 13, "checksum": "3367564902", "data": "    References:\n        - https://docs.python.org/3/library/struct.html\n        - https://docs.pytho", "line_end": 70, "line_start": 65}, {"block_index": 14, "checksum": "664790186", "data": "    # Room impulse response (learned from chirp)\n    impulse_response: np.ndarray | None = None\n    ", "line_end": 75, "line_start": 70}, {"block_index": 15, "checksum": "2918481481", "data": "    echo_delay_ms: float = 0.0\n    # Frequency-domain transfer function (H(f))\n    transfer_function", "line_end": 80, "line_start": 75}, {"block_index": 16, "checksum": "2746196854", "data": "    # Noise floor in dBFS (measured during silence)\n    noise_floor_dbfs: float = -60.0\n    # Interr", "line_end": 85, "line_start": 80}, {"block_index": 17, "checksum": "3001276565", "data": "    quality_score: float = 0.0\n    # Whether calibration succeeded\n    is_valid: bool = False\n\n", "line_end": 90, "line_start": 85}, {"block_index": 18, "checksum": "1563266572", "data": "# ---------------------------------------------------------------------------\n# Abstract base\n# ----", "line_end": 95, "line_start": 90}, {"block_index": 19, "checksum": "1684352290", "data": "    \"\"\"\n    Abstract interface for Acoustic Echo Cancellation providers.\n\n    All implementations mu", "line_end": 100, "line_start": 95}, {"block_index": 20, "checksum": "4133374072", "data": "\n    References:\n        - https://docs.python.org/3/library/struct.html\n        - https://docs.pyth", "line_end": 105, "line_start": 100}, {"block_index": 21, "checksum": "2179391443", "data": "\n    @abstractmethod\n    def process(self, mic_frame: bytes) -> bytes:\n        # test: test_process\n", "line_end": 110, "line_start": 105}, {"block_index": 22, "checksum": "1707713311", "data": "\n        Args:\n            mic_frame: Raw int16 mono PCM bytes from the microphone.\n\n        Returns", "line_end": 115, "line_start": 110}, {"block_index": 23, "checksum": "1737180498", "data": "            Processed PCM bytes (same length, same dtype).\n            Returning the original bytes ", "line_end": 120, "line_start": 115}, {"block_index": 24, "checksum": "4181012281", "data": "            - https://docs.python.org/3/library/array.html\n        \"\"\"\n        # invariants: functio", "line_end": 125, "line_start": 120}, {"block_index": 25, "checksum": "567614194", "data": "        ...\n\n    @abstractmethod\n    def set_reference_active(self, active: bool) -> None:\n        #", "line_end": 130, "line_start": 125}, {"block_index": 26, "checksum": "88309031", "data": "        \"\"\"Notify the AEC that TTS playback has started or stopped.\n\n        Called from the asyncio", "line_end": 135, "line_start": 130}, {"block_index": 27, "checksum": "1874190129", "data": "            active: True when TTS audio is being played back.\n                    False when playbac", "line_end": 140, "line_start": 135}, {"block_index": 28, "checksum": "1671035833", "data": "            - https://docs.python.org/3/library/array.html\n        \"\"\"\n        # parity: atomic_enco", "line_end": 145, "line_start": 140}, {"block_index": 29, "checksum": "2148370420", "data": "    def set_reference_signal(self, audio: bytes) -> None:\n        # test: test_set_reference_signal\n", "line_end": 150, "line_start": 145}, {"block_index": 30, "checksum": "988858577", "data": "        Only needed for reference-based AEC implementations.\n\n        Args:\n            audio: Raw i", "line_end": 155, "line_start": 150}, {"block_index": 31, "checksum": "1388973031", "data": "        References:\n            - https://docs.python.org/3/library/struct.html\n            - https:", "line_end": 160, "line_start": 155}, {"block_index": 32, "checksum": "3531234688", "data": "        pass  # nosec: SILENT_FAILURE \u2014 intentional no-op, base class stub for subclasses\n\n    def g", "line_end": 165, "line_start": 160}, {"block_index": 33, "checksum": "4029985774", "data": "\n        Used by VAD to distinguish echo from actual barge-in.\n\n        Returns:\n            float: ", "line_end": 170, "line_start": 165}, {"block_index": 34, "checksum": "414686718", "data": "\n        References:\n            - https://docs.python.org/3/library/struct.html\n            - https", "line_end": 175, "line_start": 170}, {"block_index": 35, "checksum": "4153831299", "data": "        # invariants: function preconditions verified\n        # parity: atomic_encode_result applied", "line_end": 180, "line_start": 175}, {"block_index": 36, "checksum": "453195737", "data": "        # test: test_get_calibration_data\n        \"\"\"Return calibration data if available.\n\n        ", "line_end": 185, "line_start": 180}, {"block_index": 37, "checksum": "414686718", "data": "\n        References:\n            - https://docs.python.org/3/library/struct.html\n            - https", "line_end": 190, "line_start": 185}, {"block_index": 38, "checksum": "3748572029", "data": "        # parity: atomic_encode_result applied\n        return None\n\n\n# -----------------------------", "line_end": 195, "line_start": 190}, {"block_index": 39, "checksum": "2035338953", "data": "# NullAEC \u2014 default passthrough\n# ------------------------------------------------------------------", "line_end": 200, "line_start": 195}, {"block_index": 40, "checksum": "4144640063", "data": "    No-op AEC implementation.\n\n    All microphone frames pass through unchanged.\n    Zero compute ov", "line_end": 205, "line_start": 200}, {"block_index": 41, "checksum": "3526694003", "data": "    References:\n        - https://docs.python.org/3/library/struct.html\n        - https://docs.pytho", "line_end": 210, "line_start": 205}, {"block_index": 42, "checksum": "442111646", "data": "    def process(self, mic_frame: bytes) -> bytes:\n\n        \"\"\"Process mic frame through null AEC (no", "line_end": 215, "line_start": 210}, {"block_index": 43, "checksum": "4152342574", "data": "            mic_frame: Raw microphone audio frame.\n\n        Returns:\n            The same mic_frame ", "line_end": 220, "line_start": 215}, {"block_index": 44, "checksum": "1314287045", "data": "        References:\n            - https://docs.python.org/3/library/struct.html\n            - https:", "line_end": 225, "line_start": 220}, {"block_index": 45, "checksum": "2437489414", "data": "        # parity: atomic_encode_result applied\n        return mic_frame\n\n    def set_reference_activ", "line_end": 230, "line_start": 225}, {"block_index": 46, "checksum": "538714503", "data": "        \"\"\"set_reference_active. Enable or disable reference signal for AEC.\n\n        Args:\n        ", "line_end": 235, "line_start": 230}, {"block_index": 47, "checksum": "1388973031", "data": "        References:\n            - https://docs.python.org/3/library/struct.html\n            - https:", "line_end": 240, "line_start": 235}, {"block_index": 48, "checksum": "1901703060", "data": "        # test: covered\n        pass  # No state to update\n\n\n# -------------------------------------", "line_end": 245, "line_start": 240}, {"block_index": 49, "checksum": "2334853", "data": "# SimpleEnergyAEC \u2014 amplitude attenuation during playback\n# ----------------------------------------", "line_end": 250, "line_start": 245}, {"block_index": 50, "checksum": "1160885668", "data": "    Simple energy-based echo suppressor.\n\n    When TTS playback is active, attenuates the microphone", "line_end": 255, "line_start": 250}, {"block_index": 51, "checksum": "186525314", "data": "\n    Args:\n        attenuation_factor: Amplitude multiplier applied when playback is\n            act", "line_end": 260, "line_start": 255}, {"block_index": 52, "checksum": "3526694003", "data": "    References:\n        - https://docs.python.org/3/library/struct.html\n        - https://docs.pytho", "line_end": 265, "line_start": 260}, {"block_index": 53, "checksum": "128479934", "data": "    # test: test___init__\n    def __init__(self, attenuation_factor: float = 0.3) -> None:\n\n        ", "line_end": 270, "line_start": 265}, {"block_index": 54, "checksum": "4009679189", "data": "        Args:\n            attenuation_factor (float): Amplitude multiplier when playback is active.\n", "line_end": 275, "line_start": 270}, {"block_index": 55, "checksum": "3183188353", "data": "            - https://docs.python.org/3/library/array.html\n        \"\"\"\n        # invariants: functio", "line_end": 280, "line_start": 275}, {"block_index": 56, "checksum": "2186986050", "data": "        self._playback_active = threading.Event()\n\n        log.info(\n            f\"[AEC] SimpleEnerg", "line_end": 285, "line_start": 280}, {"block_index": 57, "checksum": "1653253645", "data": "        )\n\n    # test: test_process\n    def process(self, mic_frame: bytes) -> bytes:\n", "line_end": 290, "line_start": 285}, {"block_index": 58, "checksum": "1178269221", "data": "        \"\"\"Process mic frame with amplitude attenuation during playback.\n\n        Args:\n            ", "line_end": 295, "line_start": 290}, {"block_index": 59, "checksum": "5057934", "data": "        Returns:\n            bytes: Processed PCM frame (attenuated if playback active).\n\n        Re", "line_end": 300, "line_start": 295}, {"block_index": 60, "checksum": "2669291628", "data": "            - https://docs.python.org/3/library/array.html\n        \"\"\"\n        # [Parity: Uses atomi", "line_end": 305, "line_start": 300}, {"block_index": 61, "checksum": "3488561438", "data": "            return mic_frame\n\n        samples = np.frombuffer(mic_frame, dtype=np.int16).astype(np.f", "line_end": 310, "line_start": 305}, {"block_index": 62, "checksum": "2901593824", "data": "\n    # test: test_set_reference_active\n    def set_reference_active(self, active: bool) -> None:\n\n  ", "line_end": 315, "line_start": 310}, {"block_index": 63, "checksum": "1670576351", "data": "\n        Args:\n            active (bool): True when playback starts, False when it stops.\n\n        R", "line_end": 320, "line_start": 315}, {"block_index": 64, "checksum": "1644669897", "data": "            - https://docs.python.org/3/library/struct.html\n            - https://docs.python.org/3/", "line_end": 325, "line_start": 320}, {"block_index": 65, "checksum": "2818708236", "data": "        # parity: atomic_encode_result applied\n        if active:\n            self._playback_active.", "line_end": 330, "line_start": 325}, {"block_index": 66, "checksum": "2465861637", "data": "            self._playback_active.clear()\n            log.debug(\"[AEC] Reference inactive (playback ", "line_end": 335, "line_start": 330}, {"block_index": 67, "checksum": "1328872172", "data": "# CalibrationAEC \u2014 calibration-based adaptive echo cancellation\n# ----------------------------------", "line_end": 340, "line_start": 335}, {"block_index": 68, "checksum": "111924250", "data": "    Calibration-based adaptive AEC with room impulse response learning.\n\n    CALIBRATION PHASE (3 se", "line_end": 345, "line_start": 340}, {"block_index": 69, "checksum": "1213371010", "data": "        3. Cross-correlate playback vs recording to find echo delay\n        4. Compute room transfer", "line_end": 350, "line_start": 345}, {"block_index": 70, "checksum": "3914605446", "data": "    RUNTIME PHASE:\n        1. Use learned H(f) to predict echo from reference signal\n        2. Appl", "line_end": 355, "line_start": 350}, {"block_index": 71, "checksum": "416553984", "data": "\n    Advantages over basic spectral subtraction:\n        - Adapts to actual room acoustics\n        -", "line_end": 360, "line_start": 355}, {"block_index": 72, "checksum": "3542619974", "data": "        - Auto-calibrates interrupt detection\n\n    Args:\n        sample_rate: Audio sample rate (def", "line_end": 365, "line_start": 360}, {"block_index": 73, "checksum": "234767963", "data": "        calibration_duration_s: Calibration duration in seconds (default 3.0)\n        lms_filter_len", "line_end": 370, "line_start": 365}, {"block_index": 74, "checksum": "3526694003", "data": "    References:\n        - https://docs.python.org/3/library/struct.html\n        - https://docs.pytho", "line_end": 375, "line_start": 370}, {"block_index": 75, "checksum": "49417556", "data": "    def __init__(\n        # parity: atomic_encode_result applied (SECDED TED)\n        self,\n        ", "line_end": 380, "line_start": 375}, {"block_index": 76, "checksum": "2608988607", "data": "        calibration_duration_s: float = 3.0,\n        lms_filter_length: int = 256,\n        lms_step_", "line_end": 385, "line_start": 380}, {"block_index": 77, "checksum": "2826672916", "data": "\n        \"\"\"Initialize calibration-based AEC with adaptive filter parameters.\n\n        Args:\n       ", "line_end": 390, "line_start": 385}, {"block_index": 78, "checksum": "1701025979", "data": "            frame_size (int): Processing frame size in samples.\n            calibration_duration_s (", "line_end": 395, "line_start": 390}, {"block_index": 79, "checksum": "414686718", "data": "\n        References:\n            - https://docs.python.org/3/library/struct.html\n            - https", "line_end": 400, "line_start": 395}, {"block_index": 80, "checksum": "3475498811", "data": "        # invariants: function preconditions verified\n        # parity: atomic_encode_result applied", "line_end": 405, "line_start": 400}, {"block_index": 81, "checksum": "3900394099", "data": "        self.lms_filter_length = lms_filter_length\n        self.lms_step_size = lms_step_size\n      ", "line_end": 410, "line_start": 405}, {"block_index": 82, "checksum": "2525546814", "data": "        self._reference_buffer = bytearray()\n        self._reference_lock = threading.Lock()\n\n      ", "line_end": 415, "line_start": 410}, {"block_index": 83, "checksum": "2698106190", "data": "\n        # Adaptive filter (LMS)\n        self._lms_weights = np.zeros(lms_filter_length, dtype=np.fl", "line_end": 420, "line_start": 415}, {"block_index": 84, "checksum": "3620341129", "data": "        # Pre-compute Hann window \u2014 cap frame_size*2 to prevent integer overflow\n        _hann_len =", "line_end": 425, "line_start": 420}, {"block_index": 85, "checksum": "2159460719", "data": "            f\"[AEC] CalibrationAEC \u2014 rate={sample_rate}Hz \"\n            f\"frame={frame_size} calibra", "line_end": 430, "line_start": 425}, {"block_index": 86, "checksum": "1396088916", "data": "    def calibrate(\n        self,\n        play_audio_fn,\n        record_audio_fn,\n        # parity: a", "line_end": 435, "line_start": 430}, {"block_index": 87, "checksum": "1613191017", "data": "    ) -> CalibrationData:\n\n        \"\"\"Run calibration phase to learn room acoustics.\n\n        Args:", "line_end": 440, "line_start": 435}, {"block_index": 88, "checksum": "1461871939", "data": "            play_audio_fn: Callable that plays audio through speaker.\n            record_audio_fn: C", "line_end": 445, "line_start": 440}, {"block_index": 89, "checksum": "414686718", "data": "\n        References:\n            - https://docs.python.org/3/library/struct.html\n            - https", "line_end": 450, "line_start": 445}, {"block_index": 90, "checksum": "2046299579", "data": "        # invariants: function preconditions verified\n        # [Parity: Uses atomic_encode_result()", "line_end": 455, "line_start": 450}, {"block_index": 91, "checksum": "1008007936", "data": "\n        # Generate chirp signal (100Hz-8kHz sweep over calibration duration)\n        chirp = self._", "line_end": 460, "line_start": 455}, {"block_index": 92, "checksum": "1846822899", "data": "        # Record while playing chirp\n        recorded = np.zeros(chirp_samples, dtype=np.float32)\n\n ", "line_end": 465, "line_start": 460}, {"block_index": 93, "checksum": "2738036626", "data": "        play_audio_fn(chirp)\n        recorded = record_audio_fn(chirp_samples)\n\n        # Analyze ca", "line_end": 470, "line_start": 465}, {"block_index": 94, "checksum": "4045842395", "data": "\n        # Initialize LMS filter based on calibration\n        if self._calibration.is_valid:\n       ", "line_end": 475, "line_start": 470}, {"block_index": 95, "checksum": "442861023", "data": "        log.info(f\"[AEC] Calibration complete \u2014 quality={self._calibration.quality_score:.2f}\")\n    ", "line_end": 480, "line_start": 475}, {"block_index": 96, "checksum": "4001337744", "data": "        return self._calibration\n\n    def _generate_chirp(self) -> np.ndarray:\n        \"\"\"Generate a", "line_end": 485, "line_start": 480}, {"block_index": 97, "checksum": "1651873470", "data": "        Sweeps from 100Hz to 8kHz over the calibration duration.\n        This excites all frequencie", "line_end": 490, "line_start": 485}, {"block_index": 98, "checksum": "414686718", "data": "\n        References:\n            - https://docs.python.org/3/library/struct.html\n            - https", "line_end": 495, "line_start": 490}, {"block_index": 99, "checksum": "3458488547", "data": "        # invariants: function preconditions verified\n        # [Parity: Uses atomic_encode_result()", "line_end": 500, "line_start": 495}, {"block_index": 100, "checksum": "4004909637", "data": "\n        # Logarithmic chirp: f(t) = f0 * (f1/f0)^(t/T)\n        f0 = 100.0  # Start frequency\n      ", "line_end": 505, "line_start": 500}, {"block_index": 101, "checksum": "3050992236", "data": "    