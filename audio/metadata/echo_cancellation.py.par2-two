ign reference with recorded (compensate for delay)\n        if lag > 0:\n            a", "line_end": 560, "line_start": 555}, {"block_index": 112, "checksum": "2117835444", "data": "        elif lag < 0:\n            aligned_ref = reference[:len(reference) + lag]\n            aligned", "line_end": 565, "line_start": 560}, {"block_index": 113, "checksum": "2781089495", "data": "            aligned_rec = recorded\n\n        # Ensure same length\n        min_len = min(len(aligned_r", "line_end": 570, "line_start": 565}, {"block_index": 114, "checksum": "2579164422", "data": "        aligned_rec = aligned_rec[:min_len]\n\n        # 3. Compute transfer function H(f) = Mic(f) / ", "line_end": 575, "line_start": 570}, {"block_index": 115, "checksum": "3746630651", "data": "\n        # Avoid division by zero\n        ref_power = np.abs(ref_spectrum) ** 2\n        ref_power = ", "line_end": 580, "line_start": 575}, {"block_index": 116, "checksum": "486546412", "data": "        # Transfer function (complex) \u2014 guard ref_spectrum elements to prevent division by zero\n    ", "line_end": 585, "line_start": 580}, {"block_index": 117, "checksum": "2884492154", "data": "        ref_energy = np.sqrt(np.mean(aligned_ref ** 2))\n        rec_energy = np.sqrt(np.mean(aligned", "line_end": 590, "line_start": 585}, {"block_index": 118, "checksum": "2844264962", "data": "        else:\n            cal.echo_ratio = 0.0\n\n        # 5. Estimate noise floor (from silent parts", "line_end": 595, "line_start": 590}, {"block_index": 119, "checksum": "3612454630", "data": "        frame_size = 480\n        n_frames = min_len // frame_size\n        frame_energies = []\n\n     ", "line_end": 600, "line_start": 595}, {"block_index": 120, "checksum": "3975379168", "data": "            # [INVARIANT: Loop body maintains safety condition per DO-178C MC/DC]\n            start ", "line_end": 605, "line_start": 600}, {"block_index": 121, "checksum": "2760940569", "data": "            frame_energies.app