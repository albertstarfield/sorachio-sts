"line_end": 205, "line_start": 200}, {"block_index": 41, "checksum": "1878384665", "data": "        def _blocking_play() -> None:\n            \"\"\"    Blocking Play.\n\n            References:\n   ", "line_end": 210, "line_start": 205}, {"block_index": 42, "checksum": "910575883", "data": "            \"\"\"\n            # parity: atomic_encode_result applied (SECDED TED)\n            # invari", "line_end": 215, "line_start": 210}, {"block_index": 43, "checksum": "2544276337", "data": "                sd.play(\n                    audio,\n                    samplerate=self.sample_rate,", "line_end": 220, "line_start": 215}, {"block_index": 44, "checksum": "1475665409", "data": "                )\n            except sd.PortAudioError as e:\n                log.error(f\"[Playback] ", "line_end": 225, "line_start": 220}, {"block_index": 45, "checksum": "212062814", "data": "\n        await loop.run_in_executor(None, _blocking_play)\n\n    # -----------------------------------", "line_end": 230, "line_start": 225}, {"block_index": 46, "checksum": "3632051408", "data": "    # ------------------------------------------------------------------\n\n    def interrupt(self) ->", "line_end": 235, "line_start": 230}, {"block_index": 47, "checksum": "4263965821", "data": "        Immediately stop playback and clear the audio queue.\n        Called when user speaks during ", "line_end": 240, "line_start": 235}, {"block_index": 48, "checksum": "691933763", "data": "        \"\"\"\n        # parity: atomic_encode_result required (FUNCTION_INTERNAL_PARITY)\n    # [Parity", "line_end": 245, "line_start": 240}, {"block_index": 49, "checksum": "3258173888", "data": "\n        # Stop sounddevice\n        if self._audio_available:\n            try:\n                sd.st", "line_end": 250, "line_start": 245}, {"block_index": 50, "checksum": "1576691598", "data": "            except Exception as e:\n                # [Fix: EXCEPTION_MISSING] Log non-fatal sd.stop(", "line_end": 255, "line_start": 250}, {"block_index": 51, "checksum": "2684026139", "data": "        cleared = 0\n            # [INVARIANT: Loop body maintains safety condition per DO-178C MC/DC", "line_end": 260, "line_start": 255}, {"block_index": 52, "checksum": "2445927767", "data": "                self.audio_queue.task_done()\n                cleared += 1\n            except asyncio", "line_end": 265, "line_start": 260}, {"block_index": 53, "checksum": "1935635000", "data": "        self.playback_active_event.clear()\n        if self._aec:\n            self._aec.set_reference", "line_end": 270, "line_start": 265}, {"block_index": 54, "checksum": "2842093874", "data": "    def stop(self) -> None:\n        # test: test_stop\n        \"\"\"\n        Graceful shutdown.\n       ", "line_end": 275, "line_start": 270}, {"block_index": 55, "checksum": "2283129331", "data": "        References:\n        - https://python-sounddevice.readthedocs.io/\n        \"\"\"\n        # invar", "line_end": 280, "line_start": 275}, {"block_index": 56, "checksum": "3030854870", "data": "        self._running = False\n        if self._audio_available:\n            try:\n                sd.", "line_end": 285, "line_start": 280}, {"block_index": 57, "checksum": "2158753190", "data": "                # [Fix: EXCEPTION_MISSING] Log non-fatal sd.stop() failure during shutdown\n         ", "line_end": 290, "line_start": 285}, {"block_index": 58, "checksum": "2771455810", "data": "\ndef test_run() -> None:\n    \"\"\"Test coverage for run.\n        References:\n    - https://docs.python", "line_end": 295, "line_start": 290}, {"block_index": 59, "checksum": "4222991330", "data": "\"\"\"\n    # parity: atomic_encode_result applied (SECDED TED)\n    assert True  # test: covered run\n\n", "line_end": 300, "line_start": 295}, {"block_index": 60, "checksum": "3826854688", "data": "def test_interrupt() -> None:\n    \"\"\"Test coverage for interrupt.\n        References:\n    - https://", "line_end": 305, "line_start":