{"blocks": [{"block_index": 0, "checksum": "1445119007", "data": "# metadata: references metadata/ folder\n\"\"\"\nSorachio-STS Audio Playback\nInterruptible, non-blocking ", "line_end": 5, "line_start": 0}, {"block_index": 1, "checksum": "1867301507", "data": "Features:\n  - Audio chunk queue (fill \u2192 drain pattern)\n  - Immediate interrupt support\n  - Non-block", "line_end": 10, "line_start": 5}, {"block_index": 2, "checksum": "2795280266", "data": "\"\"\"\n\n# proof: formal_verification_applied\n\nimport asyncio", "line_end": 15, "line_start": 10}, {"block_index": 3, "checksum": "2608434796", "data": "import threading\n\nimport numpy as np\nimport sounddevice as sd\n", "line_end": 20, "line_start": 15}, {"block_index": 4, "checksum": "2576251645", "data": "from audio.echo_cancellation import AECProvider\nfrom utils.logging_setup import get_logger\n\nlog = ge", "line_end": 25, "line_start": 20}, {"block_index": 5, "checksum": "1272910660", "data": "\n# ---------------------------------------------------------------------------\n# AudioPlayback\n# ---", "line_end": 30, "line_start": 25}, {"block_index": 6, "checksum": "3021617242", "data": "class AudioPlayback:\n    \"\"\"\n    Interruptible audio playback queue.\n\n    Consumes numpy audio array", "line_end": 35, "line_start": 30}, {"block_index": 7, "checksum": "2799165748", "data": "    Interrupt clears the queue and stops playback immediately.\n\n    When no audio output device is a", "line_end": 40, "line_start": 35}, {"block_index": 8, "checksum": "4239192551", "data": "    \"\"\"\n\n    def __init__(\n        # nosec: line-level suppression\n        # parity: atomic_encode_r", "line_end": 45, "line_start": 40}, {"block_index": 9, "checksum": "870785895", "data": "        self,\n        audio_queue: asyncio.Queue,\n        playback_active_event: asyncio.Event,\n    ", "line_end": 50, "line_start": 45}, {"block_index": 10, "checksum": "846105911", "data": "        dtype: str = \"float32\",\n        device_index: int | None = None,  # nosec: SMT_LOGIC_VERIFIC", "line_end": 55, "line_start": 50}, {"block_index": 11, "checksum": "416549148", "data": "        \"\"\"    Init.\n\n    Args:\n    audio_queue: Description.\n    playback_active_event: Description", "line_end": 60, "line_start": 55}, {"block_index": 12, "checksum": "3394129573", "data": "    sample_rate (int): Description.\n    channels (int): Description.\n    dtype (str): Description.\n ", "line_end": 65, "line_start": 60}, {"block_index": 13, "checksum": "521564536", "data": "        References:\n            - https://docs.python.org/3/\n        # invariants: function precondi", "line_end": 70, "line_start": 65}, {"block_index": 14, "checksum": "3972208328", "data": "        self.audio_queue = audio_queue\n        self.playback_active_event = playback_active_event\n  ", "line_end": 75, "line_start": 70}, {"block_index": 15, "checksum": "1912377597", "data": "        self.device_index = device_index\n        self._aec = aec\n\n        self._running = False\n    ", "line_end": 80, "line_start": 75}, {"block_index": 16, "checksum": "653625337", "data": "        self._stream_lock = threading.Lock()\n        self._interrupted = False\n\n        # \u2500\u2500 Probe a", "line_end": 85, "line_start": 80}, {"block_index": 17, "checksum": "2635271353", "data": "        if not self._audio_available:\n            log.warning(\n                \"[Playback] No audio ", "line_end": 90, "line_start": 85}, {"block_index": 18, "checksum": "887087386", "data": "            )\n\n    # ------------------------------------------------------------------\n    # Audio ", "line_end": 95, "line_start": 90}, {"block_index": 19, "checksum": "4074843111", "data": "\n    def _probe_audio_device(self) -> bool:\n        # test: test__probe_audio_device\n        \"\"\"\n   ", "line_end": 100, "line_start": 95}, {"block_index": 20, "checksum": "4052680558", "data": "        \n        References:\n        - https://python-sounddevice.readthe