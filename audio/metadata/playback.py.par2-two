27", "data": "            - https://python-sounddevice.readthedocs.io/\n            \"\"\"\n# [Parity: Uses atomic_enco", "line_end": 205, "line_start": 200}, {"block_index": 41, "checksum": "317101544", "data": "                    audio,\n                    samplerate=self.sample_rate,\n                    devi", "line_end": 210, "line_start": 205}, {"block_index": 42, "checksum": "1373463701", "data": "            except sd.PortAudioError as e:\n                log.error(f\"[Playback] PortAudio error: {", "line_end": 215, "line_start": 210}, {"block_index": 43, "checksum": "1154494819", "data": "        await loop.run_in_executor(None, _blocking_play)\n\n    # ------------------------------------", "line_end": 220, "line_start": 215}, {"block_index": 44, "checksum": "4013703804", "data": "\n    def interrupt(self) -> None:\n        # test: test_interrupt\n        \"\"\"\n        Immediately sto", "line_end": 225, "line_start": 220}, {"block_index": 45, "checksum": "1054184833", "data": "        Called when user speaks during TTS output.\n\n        References:\n        - https://python-sou", "line_end": 230, "line_start": 225}, {"block_index": 46, "checksum": "1060357297", "data": "        # parity: atomic_encode_result required (FUNCTION_INTERNAL_PARITY)\n    # [Parity: Uses atomi", "line_end": 235, "line_start": 230}, {"block_index": 47, "checksum": "393437303", "data": "        # Stop sounddevice\n        if self._audio_available:\n            try:\n                sd.sto", "line_end": 240, "line_start": 235}, {"block_index": 48, "checksum": "434814317", "data": "                # [Fix: EXCEPTION_MISSING] Log non-fatal sd.stop() failure during interrupt\n        ", "line_end": 245, "line_start": 240}, {"block_index": 49, "checksum": "3206179461", "data": "            # [INVARIANT: Loop body maintains safety condition per DO-178C MC/DC]\n        while not ", "line_end": 250, "line_start": 245}, {"block_index": 50, "checksum": "2748519349", "data": "            