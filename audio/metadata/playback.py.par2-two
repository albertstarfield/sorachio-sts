{"blocks": [{"block_index": 0, "checksum": "3308670108", "data": "\"\"\"\nSorachio-STS Audio Playback\nInterruptible, non-blocking audio playback queue for TTS output.\n\nFe", "line_end": 5, "line_start": 0}, {"block_index": 1, "checksum": "3032627073", "data": "  - Audio chunk queue (fill \u2192 drain pattern)\n  - Immediate interrupt support\n  - Non-blocking put/ge", "line_end": 10, "line_start": 5}, {"block_index": 2, "checksum": "2000729452", "data": "\n# proof: formal_verification_applied\n\nimport asyncio\nimport threading", "line_end": 15, "line_start": 10}, {"block_index": 3, "checksum": "1310504291", "data": "\nimport numpy as np\nimport sounddevice as sd\n\nfrom audio.echo_cancellation import AECProvider", "line_end": 20, "line_start": 15}, {"block_index": 4, "checksum": "3626177319", "data": "from utils.logging_setup import get_logger\n\nlog = get_logger(\"audio.playback\")\n\n", "line_end": 25, "line_start": 20}, {"block_index": 5, "checksum": "775210142", "data": "# ---------------------------------------------------------------------------\n# AudioPlayback\n# ----", "line_end": 30, "line_start": 25}, {"block_index": 6, "checksum": "1927720882", "data": "    \"\"\"\n    Interruptible audio playback queue.\n\n    Consumes numpy audio arrays from a queue and pl", "line_end": 35, "line_start": 30}, {"block_index": 7, "checksum": "2393030127", "data": "\n    When no audio output device is available (e.g. WSL / headless Linux),\n    playback is silently ", "line_end": 40, "line_start": 35}, {"block_index": 8, "checksum": "1454727101", "data": "\n    def __init__(  # nosec: smt_false_positive\n        # parity: atomic_encode_result applied (SECD", "line_end": 45, "line_start": 40}, {"block_index": 9, "checksum": "1451185153", "data": "        playback_active_event: asyncio.Event,\n        sample_rate: int = 24000,\n        channels: in", "line_end": 50, "line_start": 45}, {"block_index": 10, "checksum": "1839206095", "data": "        aec: AECProvider | None 