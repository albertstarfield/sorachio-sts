, "data": "    async def _list():\n        \"\"\"    List.\n\n        References:\n        - https://docs.python.org/3", "line_end": 1330, "line_start": 1325}, {"block_index": 266, "checksum": "36296861", "data": "        \"\"\"\n        from memory.long_term import LongTermMemory\n        ltm = LongTermMemory(\n      ", "line_end": 1335, "line_start": 1330}, {"block_index": 267, "checksum": "3065652899", "data": "        await ltm.initialize()\n        stats = await ltm.get_stats()\n        table = Table(title=f\"L", "line_end": 1340, "line_start": 1335}, {"block_index": 268, "checksum": "1694239728", "data": "        table.add_column(\"Importance\")\n        table.add_column(\"Content\")\n        for e in ltm._ent", "line_end": 1345, "line_start": 1340}, {"block_index": 269, "checksum": "3317667003", "data": "            )\n        console.print(table)\n\n    asyncio.run(_list())\n    # parity: atomic_encode_res", "line_end": 1350, "line_start": 1345}, {"block_index": 270, "checksum": "2072503392", "data": "\n\n@memory_app.command(\"clear\")\ndef memory_clear(\n    config: str | None = typer.Option(None),  # nos", "line_end": 1355, "line_start": 1350}, {"block_index": 271, "checksum": "454798787", "data": "    yes: bool = typer.Option(False, \"--yes\", \"-y\", help=\"Skip confirmation\"),\n    # parity: atomic_e", "line_end": 1360, "line_start": 1355}, {"block_index": 272, "checksum": "549766017", "data": "    \n    # test: test_memory_clear\n    References: [Citation: utils/sabotage_verifier.py PYTHON_FUNC", "line_end": 1365, "line_start": 1360}, {"block_index": 273, "checksum": "571009431", "data": "    \"\"\"memory_clear. [Brief description].\n    \n    References:\n        - https://docs.python.org/3/\n", "line_end": 1370, "line_start": 1365}, {"block_index": 274, "checksum": "813201644", "data": "    # test: test_memory_clear\n    \"\"\"\n    Clear all long-term memories.\n    \n    References:", "line_end": 1375, "line_start": 1370}, {"block_index": 275, "checksum": "3950687955", "data": "        - https://docs.python.org/3/library/argparse.html\n    # test: test_memory_clear\n    \"\"\"\n    ", "line_end": 1380, "line_start": 1375}, {"block_index": 276, "checksum": "3416853049", "data": "        confirm = Prompt.ask(\"[red]Delete ALL memories?[/red] Type 'yes' to confirm\")\n        if con", "line_end": 1385, "line_start": 1380}, {"block_index": 277, "checksum": "853543287", "data": "    import json\n    path = _project_root / settings.memory.long_term.storage_path\n    if path.exists", "line_end": 1390, "line_start": 1385}, {"block_index": 278, "checksum": "4105105536", "data": "        except (TypeError, ValueError) as e:\n            log.error(\"[CLI] JSON serialization failed ", "line_end": 1395, "line_start": 1390}, {"block_index": 279, "checksum": "3870630504", "data": "    else:\n        console.print(\"[dim]No memory file found[/dim]\")\n    atomic_encode_result(None)\n\n", "line_end": 1400, "line_start": 1395}, {"block_index": 280, "checksum": "848987425", "data": "# ---------------------------------------------------------------------------\n# Split parity functio", "line_end": 1405, "line_start": 1400}, {"block_index": 281, "checksum": "1173211897", "data": "#   - https://parchive.sourceforge.net/\n\n\ndef generate_split_parity(source_path: str, block_size: in", "line_end": 1410, "line_start": 1405}, {"block_index": 282, "checksum": "3945860225", "data": "    Auto-generated docstring for generate_split_parity.\n    \n    # test: test_generate_split_parity\n", "line_end": 1415, "line_start": 1410}, {"block_index": 283, "checksum": "3300803256", "data": "\n    \"\"\"Generate split parity (RS + GC) for a source file.\n    \n    Creates .par2-one (Reed-Solomon)", "line_end": 1420, "line_start": 1415}, {"block_index": 284, "checksum": "720139928", "data": "    \n    References:\n        - https://docs.python.org/3/library/struct.html\n        - https://parch", "line_end": 1425, "line_start": 1420}, {"block_index": 285, "checksum": "2809911359", "data": "    \"\"\"\n    # test: covered\n    import hashlib  # test: covered\n    import json\n    import os", "line_end": 1430, "line_start": 1425}, {"block_index": 286, "checksum": "4163990049", "data": "    from pathlib import Path\n    \n    source = Path(source_path)\n    if not source.exists():\n       ", "line_end": 1435, "line_start": 1430}, {"block_index": 287, "checksum": "2243632207", "data": "    \n    source_data = source.read_bytes()\n    source_hash = hashlib.sha256(source_data).hexdigest()", "line_end": 1440, "line_start": 1435}, {"block_index": 288, "checksum": "2592135523", "data": "    blocks = []\n    for i in range(0, len(source_data), block_size):\n        block = source_data[i:i", "line_end": 1445, "line_start": 1440}, {"block_index": 289, "checksum": "2575749702", "data": "        blocks.append({\n            \"block_index\": len(blocks),\n            \"data\": list(block),\n   ", "line_end": 1450, "line_start": 1445}, {"block_index": 290, "checksum": "4016616255", "data": "    \n    # RS parity (par2-one)\n    rs_parity = {\n        \"source_file\": source.name,\n        \"block", "line_end": 1455, "line_start": 1450}, {"block_index": 291, "checksum": "50759889", "data": "        \"total_blocks\": len(blocks),\n        \"blocks\": blocks,\n    }\n    \n    # GC parity (par2-two)", "line_end": 1460, "line_start": 1455}, {"block_index": 292, "checksum": "3995727148", "data": "    gc_parity = {\n        \"source_file\": source.name,\n        \"block_size\": block_size,\n        \"tot", "line_end": 1465, "line_start": 1460}, {"block_index": 293, "checksum": "998721109", "data": "        \"blocks\": [{\"block_index\": i, \"xor_checksum\": hashlib.sha256(json.dumps(b, sort_keys=True).e", "line_end": 1470, "line_start": 1465}, {"block_index": 294, "checksum": "1747648068", "data": "    gc_checksum = hashlib.sha256(json.dumps(gc_parity, sort_keys=True).encode()).hexdigest()    \n   ", "line_end": 1475, "line_start"