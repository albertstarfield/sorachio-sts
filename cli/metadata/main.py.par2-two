ogging.Filter):\n    \"\"\"Drop log records whose message contains known spam stri", "line_end": 105, "line_start": 100}, {"block_index": 21, "checksum": "698448629", "data": "        \"words count mismatch\",\n        \"JSON repaired\",\n        \"unauthenticated requests\",\n       ", "line_end": 110, "line_start": 105}, {"block_index": 22, "checksum": "3964115997", "data": "    )\n\n    def filter(self, record: logging.LogRecord) -> bool:\n        # test: test_filter\n        ", "line_end": 115, "line_start": 110}, {"block_index": 23, "checksum": "3656664845", "data": "\n        Args:\n            record: The log record to evaluate.\n\n        Returns:", "line_end": 120, "line_start": 115}, {"block_index": 24, "checksum": "71362395", "data": "            True if the record should be emitted, False to drop it.\n\n        References:\n        - h", "line_end": 125, "line_start": 120}, {"block_index": 25, "checksum": "2189897379", "data": "        \"\"\"\n        msg = record.getMessage()\n        return not any(p in msg for p in self._PATTERN", "line_end": 130, "line_start": 125}, {"block_index": 26, "checksum": "1838501952", "data": "\nlogging.root.addFilter(_NoiseFilter())\n\n# Add project root to path\n_project_root = Path(__file__).p", "line_end": 135, "line_start": 130}, {"block_index": 27, "checksum": "2678767692", "data": "sys.path.insert(0, str(_project_root))\n\nconsole = Console(\n    soft_wrap=True,\n    force_terminal=Tr", "line_end": 140, "line_start": 135}, {"block_index": 28, "checksum": "1052604774", "data": ")\napp = typer.Typer(\n    name=\"sorachio\",\n    help=\"Sorachio-STS: Speech To Speech AI Companion Syst", "line_end": 145, "line_start": 140}, {"block_index": 29, "checksum": "2381869745", "data": "    add_completion=False,\n)\nservers_app = typer.Typer(name=\"servers\", help=\"Manage llama-server inst", "line_end": 150, "line_start": 145}, {"block_index": 30, "checksum": "233279483", "data": "app.add_typer(memory_app)\n\n\n# ---------------