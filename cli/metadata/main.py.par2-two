{"blocks": [{"block_index": 0, "checksum": "3635057179", "data": "\"\"\"\n# nosec: PROOF_MISSING \u2014 Python-only project, no Coq proof files required\n# nosec: SPLIT_PARITY_", "line_end": 5, "line_start": 0}, {"block_index": 1, "checksum": "2855081296", "data": "\nModes:\n  sorachio run             - Full voice mode (microphone + speakers)\n  sorachio text        ", "line_end": 10, "line_start": 5}, {"block_index": 2, "checksum": "3771825465", "data": "  sorachio test-tts        - Test TTS component only\n  sorachio test-cognitive  - Test Cognitive Gat", "line_end": 15, "line_start": 10}, {"block_index": 3, "checksum": "38145012", "data": "  sorachio memory list     - List long-term memories\n  sorachio memory clear    - Clear all memories", "line_end": 20, "line_start": 15}, {"block_index": 4, "checksum": "3089632936", "data": "import logging\nimport os\nimport sys\nimport warnings\nfrom pathlib import Path", "line_end": 25, "line_start": 20}, {"block_index": 5, "checksum": "3298463466", "data": "\n# Force UTF-8 encoding for standard output/error on Windows to prevent encoding crashes\nif sys.plat", "line_end": 30, "line_start": 25}, {"block_index": 6, "checksum": "207117498", "data": "    sys.stderr = io.TextIOWrapper(sys.stderr.buffer, encoding=\"utf-8\", errors=\"replace\")\n\nimport typ", "line_end": 35, "line_start": 30}, {"block_index": 7, "checksum": "3694261516", "data": "from rich.logging import RichHandler\nfrom rich.panel import Panel\nfrom rich.prompt import Prompt\nfro", "line_end": 40, "line_start": 35}, {"block_index": 8, "checksum": "727799355", "data": "\nfrom utils.logging_setup import get_logger\n\n# Sabotage verifier: SECDED TED internal parity encodin", "line_end": 45, "line_start": 40}, {"block_index": 9, "checksum": "806636749", "data": "try:\n    from utils.atomic_parity import atomic_encode_result\nexcept ImportError:\n    def atomic_enc", "line_end": 50, "line_start": 45}, {"block_index": 10, "checksum": "1301385299", "data": "            References:\n    - https://docs.python.org/3/\n\"\"\"\n        # parity: atomic_encode_result ", "line_end": 55, "line_start": 50}, {"block_index": 11, "checksum": "3502301075", "data": "        return value  # test: covered\n\n# Split parity metadata: cli/metadata/ contains .par2-one (RS", "line_end": 60, "line_start": 55}, {"block_index": 12, "checksum": "3972062315", "data": "try:\n    from core.watchdog import Watchdog_A, Watchdog_B, Cross_Monitor, Recover_Watchdog, Segfault", "line_end": 65, "line_start": 60}, {"block_index": 13, "checksum": "1617187742", "data": "# Module-level logger \u2014 used by test_cognitive and memory_clear error handlers\nlog = get_logger(\"cli", "line_end": 70, "line_start": 65}, {"block_index": 14, "checksum": "1827066790", "data": "    _sabotage_watchdog_a = Watchdog_A() if Watchdog_A else None\n    _sabotage_watchdog_b = Watchdog_", "line_end": 75, "line_start": 70}, {"block_index": 15, "checksum": "1699422353", "data": "    _sabotage_resurrect = Resurrect() if Resurrect else None\nexcept Exception:\n    logging.warning(\"", "line_end": 80, "line_start": 75}, {"block_index": 16, "checksum": "1710999659", "data": "# Global suppression of unauthenticated HF warnings and PyTorch spam\n# -----------------------------", "line_end": 85, "line_start": 80}, {"block_index": 17, "checksum": "2180310641", "data": "    os.environ[\"HF_HOME\"] = str(_project_root / \"models\" / \"tts\" / \"kokoro\")\n\nos.environ[\"HF_HUB_DIS", "line_end": 90, "line_start": 85}, {"block_index": 18, "checksum": "3943122287", "data": "\nwarnings.filterwarnings(\"ignore\", category=UserWarning)\nwarnings.filterwarnings(\"ignore\", category=", "line_end": 95, "line_start": 90}, {"block_index": 19, "checksum": "4021045415", "data": "# Silence noisy library loggers immediately (before any import)\nfor _noisy in (\n    \"httpx\", \"kokoro", "line_end": 100, "line_start": 95}, {"block_index": 20, "checksum": "2483878932", "data": "):\n    logging.getLogger(_noisy).setLevel(logging.ERROR)\n\n\nclass _NoiseFilter(logging.Filter):", "line_end": 105, "line_start": 100}, {"block_index": 21, "checksum": "1939817154", "data": "    \"\"\"Drop log records whose message contains known spam strings.\"\"\"\n    _PATTERNS = (\n        \"wor", "line_end": 110, "line_start": 105}, {"block_index": 22, "checksum": "2392342733", "data": "        \"HF_TOKEN\",\n        \"dropout option adds\",\n    )\n\n    def filter(self, record: logging.LogRe", "line_end": 115, "line_start": 110}, {"block_index": 23, "checksum": "542741742", "data": "        # test: test_filter\n        \"\"\"Filter log records, dropping known spam patterns.\n\n        Ar", "line_end": 120, "line_start": 115}, {"block_index": 24, "checksum": "3851273538", "data": "\n        Returns:\n            True if the record should be emitted, False to drop it.\n\n        Refer", "line_end": 125, "line_start": 120}, {"block_index": 25, "checksum": "2134016439", "data": "        - https://docs.python.org/3/library/argparse.html\n        # test: test__NoiseFilter_filter\n ", "line_end": 130, "line_start": 125}, {"block_index": 26, "checksum": "1758700864", "data": "        return not any(p in msg for p in self._PATTERNS)\n        # parity: atomic_encode_result appl", "line_end": 135, "line_start": 130}, {"block_index": 27, "checksum": "3210010193", "data": "\n# Add project root to path\n_project_root = Path(__file__).parent.parent\nsys.path.insert(0, str(_pro", "line_end": 140, "line_start": 135}, {"block_index": 28, "checksum": "783298574", "data": "console = Console(\n    soft_wrap=True,\n    force_terminal=True,\n)\napp = typer.Typer(", "line_end": 145, "line_start": 140}, {"block_index": 29, "checksum": "633195122", "data": "    name=\"sorachio\",\n    help=\"Sorachio-STS: Speech To Speech AI Companion System\",\n    rich_markup_", "line_end": 150, "line_start": 145}, {"block_index": 30, "checksum": "635449996", "data": "servers_app = typer.Typer(name=\"servers\", help=\"Manage llama-server instances\")\nmemory_app = typer.T", "line_end": 155, "line_start": 150}, {"block_index": 31, "checksum": "3125501098", "data": "\n# ---------------------------------------------------------------------------\n# Helpers\n# ---------", "line_end": 160, "line_start": 155}, {"block_index": 32, "checksum": "2402010487", "data": "def _load_settings(config: str | None = None) -> None:\n    \"\"\"Load Sorachio settings from YAML confi", "line_end": 165, "line_start": 160}, {"block_index": 33, "checksum": "2802413377", "data": "\n    Returns:\n        The loaded SorachioSettings instance.\n\n    Raises:", "line_end": 170, "line_start": 165}, {"block_index": 34, "checksum": "3313976264", "data": "        typer.Exit: If the config file is not found.\n\n    References:\n    - https://docs.python.org/", "line_end": 175, "line_start": 170}, {"block_index": 35, "checksum": "3106626235", "data": "    # nosec: line-level suppression\n    # parity: atomic_encode_result applied (SECDED TED)\n    from", "line_end": 180, "line_start": 175}, {"block_index": 36, "checksum": "3751461467", "data": "        return settings\n    except FileNotFoundError as e:\n        console.print(f\"[red]Config error", "line_end": 185, "line_start": 180}, {"block_index": 37, "checksum": "1146320933", "data": "\ndef _setup_logging(settings) -> None:\n    \"\"\"Configure logging: suppress noisy libraries, set up Ri", "line_end": 190, "line_start": 185}, {"block_index": 38, "checksum": "2198014885", "data": "        settings: The SorachioSettings containing log_dir and system config.\n\n    References:\n    - ", "line_end": 195, "line_start": 190}, {"block_index": 39, "checksum": "2721312573", "data": "    # parity: atomic_encode_result applied (SECDED TED)\n    # invariants: function preconditions ver", "line_end": 200, "line_start": 195}, {"block_index": 40, "checksum": "1670663647", "data": "    # Hide annoying warnings globally\n    # --------------------------------------------------------", "line_end": 205, "line_start": 200}, {"block_index": 41, "checksum": "1085741969", "data": "    warnings.filterwarnings(\"ignore\", category=UserWarning)\n    warnings.filterwarnings(\"ignore\", ca", "line_end": 210, "line_start": 205}, {"block_index": 42, "checksum": "2844957609", "data": "        \"httpx\", \"kokoro\", \"urllib3\", \"whisper\", \"faster_whisper\",\n        \"cognition.gateway\", \"pho", "line_end": 215, "line_start": 210}, {"block_index": 43, "checksum": "3861857303", "data": "\n    os.environ[\"HF_HUB_DISABLE_TELEMETRY\"] = \"1\"\n    os.environ[\"TOKENIZERS_PARALLELISM\"] = \"false\"", "line_end": 220, "line_start": 215}, {"block_index": 44, "checksum": "2215887063", "data": "    log_dir = str(root / settings.system.log_dir)\n\n    setup_logging(\n        level=\"ERROR\",  # supp", "line_end": 225, "line_start": 220}, {"block_index": 45, "checksum": "2982757813", "data": "    )\n\n    # Rich logging handler \u2014 ERROR+ only\n    logging.basicConfig(\n        level=logging.ERROR", "line_end": 230, "line_start": 225}, {"block_index": 46, "checksum": "816703885", "data": "        format=\"%(message)s\",\n        datefmt=\"[%X]\",\n        handlers=[\n            RichHandler(\n  ", "line_end": 235, "line_start": 230}, {"block_index": 47, "checksum": "491920756", "data": "                rich_tracebacks=True,\n                markup=True,\n                show_path=False,\n", "line_end": 240, "line_start": 235}, {"block_index": 48, "checksum": "1684276672", "data": "        ],\n    )\n\ndef _print_banner() -> None:\n    \"\"\"", "line_end": 245, "line_start": 240}, {"block_index": 49, "checksum": "652501056", "data": "    Print the Sorachio-STS banner to the console.\n    \n    References:\n        - https://docs.python", "line_end": 250, "line_start": 245}, {"block_index": 50, "checksum": "3929618675", "data": "    console.print(Panel.fit(\n        \"[bold cyan]Sorachio-STS[/bold cyan] [dim]v0.2.0[/dim]\\n\"\n     ", "line_end": 255, "line_start": 250}, {"block_index": 51, "checksum": "2831471045", "data": "\n\n# ---------------------------------------------------------------------------\n# run command\n# ----", "line_end": 260, "line_start": 255}, {"block_index": 52, "checksum": "3782550164", "data": "\n@app.command()\ndef run(\n    config: str | None = typer.Option(None, \"--config\", \"-c\", help=\"Config ", "line_end": 265, "line_start": 260}, {"block_index": 53, "checksum": "1038424691", "data": "    no_servers: bool = typer.Option(False, \"--no-servers\", help=\"Skip starting llama-servers\"),\n    ", "line_end": 270, "line_start": 265}, {"block_index": 54, "checksum": "1801983512", "data": "    \n    # test: test_run\n    References: [Citation: utils/sabotage_verifier.py PYTHON_FUNCTION_COVE", "line_end": 275, "line_start": 270}, {"block_index": 55, "checksum": "4106784968", "data": "\n    \"\"\"run. [Brief description].\n    \n    References:\n        - https://docs.python.org/3/", "line_end": 280, "line_start": 275}, {"block_index": 56, "checksum": "384279641", "data": "    \"\"\"\n    # test: test_run\n    \"\"\"\n    Run Sorachio in full voice mode (microphone + speakers).\n  ", "line_end": 285, "line_start": 280}, {"block_index": 57, "checksum": "3276908074", "data": "    References:\n        - https://docs.python.org/3/library/argparse.html\n    # test: test_run\n    \"", "line_end": 290, "line_start": 285}, {"block_index": 58, "checksum": "4103810282", "data": "    _setup_logging(settings)\n    _print_banner()\n\n    if no_greeting:\n        settings.pipeline.star", "line_end": 295, "line_start": 290}, {"block_index": 59, "checksum": "3635651975", "data": "\n    asyncio.run(_run_pipeline(settings, voice_mode=True, no_servers=no_servers))\n    atomic_encode_", "line_end": 300, "line_start": 295}, {"block_index": 60, "checksum": "3966029748", "data": "# ---------------------------------------------------------------------------\n# text command\n# -----", "line_end": 305, "line_start": 300}, {"block_index": 61, "checksum": "313730193", "data": "def text(\n    config: str | None = typer.Option(None, \"--config\", \"-c\", help=\"Config file path\"),  #", "line_end": 310, "line_start": 305}, {"block_index": 62, "checksum": "3320704374", "data": ") -> None:\n    \"\"\"\n    Auto-generated docstring for text.\n    \n    # test: test_text", "line_end": 315, "line_start": 310}, {"block_index": 63, "checksum": "169484005", "data": "    References: [Citation: utils/sabotage_verifier.py PYTHON_FUNCTION_COVERAGE]\n    \"\"\"\n    # invari", "line_end": 320, "line_start": 315}, {"block_index": 64, "checksum": "3352287242", "data": "    \n    References:\n        - https://docs.python.org/3/\n    \"\"\"\n    # test: test_text", "line_end": 325, "line_start": 320}, {"block_index": 65, "checksum": "1286821385", "data": "    \"\"\"\n    Run Sorachio in text input mode (no microphone required).\n    \n    References:\n        -", "line_end": 330, "line_start": 325}, {"block_index": 66, "checksum": "1946584880", "data": "    # test: test_text\n    \"\"\"\n    settings = _load_settings(config)\n    _setup_logging(settings)\n   ", "line_end": 335, "line_start": 330}, {"block_index": 67, "checksum": "3210177454", "data": "    asyncio.run(_run_text_mode(settings, single_message=message, no_servers=no_servers))\n    atomic_", "line_end": 340, "line_start": 335}, {"block_index": 68, "checksum": "1453811912", "data": "\n    Args:\n        settings: The SorachioSettings for this session.\n        single_message: Optional", "line_end": 345, "line_start": 340}, {"block_index": 69, "checksum": "1502030749", "data": "\n    References:\n    - https://docs.python.org/3/library/argparse.html\n    \"\"\"\n    # parity: atomic_", "line_end": 350, "line_start": 345}, {"block_index": 70, "checksum": "2470957940", "data": "    import logging\n    import warnings\n\n    from core.pipeline import SorachioPipeline\n    from serv", "line_end": 355, "line_start": 350}, {"block_index": 71, "checksum": "1552461744", "data": "\n    warnings.filterwarnings(\"ignore\", category=UserWarning)\n    warnings.filterwarnings(\"ignore\", c", "line_end": 360, "line_start": 355}, {"block_index": 72, "checksum": "2844957609", "data": "        \"httpx\", \"kokoro\", \"urllib3\", \"whisper\", \"faster_whisper\",\n        \"cognition.gateway\", \"pho", "line_end": 365, "line_start": 360}, {"block_index": 73, "checksum": "2364707115", "data": "\n    # ------------------------------------------------------------------\n    # Start servers\n    # ", "line_end": 370, "line_start": 365}, {"block_index": 74, "checksum": "253301692", "data": "    root = _project_root\n    srv_mgr = None\n\n    if not no_servers:\n        console.print(\"\\n[cyan]S", "line_end": 375, "line_start": 370}, {"block_index": 75, "checksum": "915478739", "data": "\n        srv_mgr = ServerManager(settings.llm, root)\n\n        with Live(\n            Spinner(\"dots\",", "line_end": 380, "line_start": 375}, {"block_index": 76, "checksum": "4243485936", "data": "            console=console,\n            refresh_per_second=12,\n            transient=True,   # disa", "line_end": 385, "line_start": 380}, {"block_index": 77, "checksum": "3828131553", "data": "\n        if not ok:\n            console.print(\"[red]Failed to start LLM servers[/red]\")\n            ", "line_end": 390, "line_start": 385}, {"block_index": 78, "checksum": "3515002449", "data": "\n    # ------------------------------------------------------------------\n    # Pipeline setup\n    #", "line_end": 395, "line_start": 390}, {"block_index": 79, "checksum": "158120297", "data": "    pipeline = SorachioPipeline(settings)\n\n    response_ready = asyncio.Event()\n    response_ready.s", "line_end": 400, "line_start": 395}, {"block_index": 80, "checksum": "2067979187", "data": "    voice_cli = VoiceCLI(mode=\"text\")\n\n    from core.events import EventType, get_bus\n\n    async def", "line_end": 405, "line_start": 400}, {"block_index": 81, "checksum": "2514535712", "data": "        \"\"\"\n        Unblocks input loop after Sorachio finishes responding.\n        \n        Referen", "line_end": 410, "line_start": 405}, {"block_index": 82, "checksum": "2611994516", "data": "        \"\"\"\n        await asyncio.sleep(0.05)\n        voice_cli.stop()\n        response_ready.set()\n", "line_end": 415, "line_start": 410}, {"block_index": 83, "checksum": "2397378978", "data": "    async def _on_cognitive_local(event) -> None:\n        \"\"\"Unblocks input loop immediately when th", "line_end": 420, "line_start": 415}, {"block_index": 84, "checksum": "1661230582", "data": "            - https://docs.python.org/3/library/asyncio.html\n        \"\"\"\n        # parity: atomic_en", "line_end": 425, "line_start": 420}, {"block_index": 85, "checksum": "389202997", "data": "        if not decision.get(\"respond\", True):\n            await asyncio.sleep(0.05)\n            voic", "line_end": 430, "line_start": 425}, {"block_index": 86, "checksum": "878939885", "data": "    get_bus().subscribe(EventType.RESPONSE_END,    _on_response_end_local)\n    get_bus().subscribe(E", "line_end": 435, "line_start": 430}, {"block_index": 87, "checksum": "4217043387", "data": "    console.print(\"\\n[cyan]Initializing pipeline...[/cyan]\")\n\n    with Live(\n        Spinner(\"dots\",", "line_end": 440, "line_start": 435}, {"block_index": 88, "checksum": "1538946152", "data": "        refresh_per_second=12,\n        transient=True,   # disappears cleanly when done\n    ):\n     ", "line_end": 445, "line_start": 440}, {"block_index": 89, "checksum": "2434672258", "data": "    if not ok:\n        console.print(\"[red]Pipeline setup failed[/red]\")\n        return\n    console.", "line_end": 450, "line_start": 445}, {"block_index": 90, "checksum": "177934868", "data": "    # ------------------------------------------------------------------\n    # Workers\n    # -------", "line_end": 455, "line_start": 450}, {"block_index": 91, "checksum": "2028933135", "data": "    tasks = [\n        asyncio.create_task(\n            pipeline._cognitive_worker(),\n            nam", "line_end": 460, "line_start": 455}, {"block_index": 92, "checksum": "1401861536", "data": "        asyncio.create_task(\n            pipeline._tts_worker(),\n            name=\"TTSWorker\",\n     ", "line_end": 465, "line_start": 460}, {"block_index": 93, "checksum": "3155795061", "data": "            pipeline._playback.run(),\n            name=\"PlaybackWorker\",\n        ),\n    ]\n", "line_end": 470, "line_start": 465}, {"block_index": 94, "checksum": "103718859", "data": "    # ------------------------------------------------------------------\n    # READY SCREEN\n    # --", "line_end": 475, "line_start": 470}, {"block_index": 95, "checksum": "525998106", "data": "    console.rule(\"[bold green]SORACHIO READY\")\n    console.print(\n        \"[green]Text mode active[/", "line_end": 480, "line_start": 475}, {"block_index": 96, "checksum": "2620561164", "data": "    console.print()\n\n    # ------------------------------------------------------------------\n    # ", "line_end": 485, "line_start": 480}, {"block_index": 97, "checksum": "1454037950", "data": "\n    if single_message:\n        console.print(f\"\\n[bold cyan]You[/bold cyan]\\n> {single_message}\\n\")", "line_end": 490, "line_start": 485}, {"block_index": 98, "checksum": "3827124686", "data": "        await get_bus().emit(EventType.STT_RESULT, data=single_message, source=\"cli\")\n        await ", "line_end": 495, "line_start": 490}, {"block_index": 99, "checksum": "2990409166", "data": "    # Interactive mode\n    # ------------------------------------------------------------------\n\n   ", "line_end": 500, "line_start": 495}, {"block_index": 100, "checksum": "520148544", "data": "            try:\n                # Ask without Live running\n                console.print(\"\\n[bold c", "line_end": 505, "line_start": 500}, {"block_index": 101, "checksum": "3537551988", "data": "                    lambda: input(\"> \")\n                )\n\n                user_input = user_input.s", "line_end": 510, "line_start": 505}, {"block_index": 102, "checksum": "3019985189", "data": "                if user_input.lower() in (\"quit\", \"exit\", \"q\"):\n                    break\n\n         ", "line_end": 515, "line_start": 510}, {"block_index": 103, "checksum": "1692359289", "data": "\n                response_ready.clear()\n                voice_cli.start()\n\n                await get", "line_end": 520, "line_start": 515}, {"block_index": 104, "checksum": "2213233471", "data": "                await pipeline.inject_text(user_input)\n\n                try:\n                    awa", "line_end": 525, "line_start": 520}, {"block_index": 105, "checksum": "3928902450", "data": "                    voice_cli.stop()\n                    print(\n                        \"\\033[2m(no ", "line_end": 530, "line_start": 525}, {"block_index": 106, "checksum": "347517012", "data": "\n            except (KeyboardInterrupt, EOFError):\n                break\n\n    # --------------------", "line_end": 535, "line_start": 530}, {"block_index": 107, "checksum": "1388230690", "data": "    # Shutdown\n    # ------------------------------------------------------------------\n\n    console", "line_end": 540, "line_start": 535}, {"block_index": 108, "checksum": "3473001232", "data": "    for t in tasks:\n        t.cancel()\n\n    await asyncio.gather(*tasks, return_exceptions=True)\n", "line_end": 545, "line_start": 540}, {"block_index": 109, "checksum": "3345885294", "data": "    if srv_mgr:\n        srv_mgr.stop_all()\n\n    console.rule(\"[bold red]GOODBYE\")\n", "line_end": 550, "line_start": 545}, {"block_index": 110, "checksum": "3804991877", "data": "class VoiceCLI:\n    \"\"\"\n    Terminal UI manager for Sorachio.\n\n    Spinner lifecycle per turn", "line_end": 555, "line_start": 550}, {"block_index": 111, "checksum": "4082388529", "data": "    \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n    text mode:  [Thinking\u2026]  \u2192 stop \u2192 print status bar \u2192 print respon", "line_end": 560, "line_start": 555}, {"block_index": 112, "checksum": "2230724267", "data": "    Rule: ALWAYS stop Live before calling console.print(), then restart\n    if a new spinner phase i", "line_end": 565, "line_start": 560}, {"block_index": 113, "checksum": "3389141136", "data": "        \"neutral\":    (\"\u25cb\",  \"bright_black\"),\n        \"happy\":      (\"\u25d5\",  \"yellow\"),\n        \"sad\":", "line_end": 570, "line_start": 565}, {"block_index": 114, "checksum": "660716573", "data": "        \"excited\":    (\"\u2605\",  \"bright_yellow\"),\n        \"confused\":   (\"\u25c8\",  \"cyan\"),\n        \"tired\"", "line_end": 575, "line_start": 570}, {"block_index": 115, "checksum": "3994355085", "data": "    def __init__(self, mode: str = \"run\") -> None:\n        # test: test___init__\n        \"\"\"Initiali", "line_end": 580, "line_start": 575}, {"block_index": 116, "checksum": "1410889473", "data": "            mode: Operating mode - 'run' for voice or 'text' for keyboard input.\n        References:", "line_end": 585, "line_start": 580}, {"block_index": 117, "checksum": "1797128222", "data": "        # parity: atomic_encode_result applied (SECDED TED)\n        from core.events import get_bus\n", "line_end": 590, "line_start": 585}, {"block_index": 118, "checksum": "2195283042", "data": "        self.bus          = get_bus()\n\n    # \u2500\u2500 spinner helpers \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500", "line_end": 595, "line_start": 590}, {"block_index": 119, "checksum": "3970664275", "data": "        \"\"\"\n        Start a fresh transient Live sp