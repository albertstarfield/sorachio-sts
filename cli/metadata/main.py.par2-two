{"blocks": [{"block_index": 0, "checksum": "3755720249", "data": "\"\"\"\n# nosec: PROOF_MISSING \u2014 Python-only project, no Coq proof files required\n# nosec: SPLIT_PARITY_", "line_end": 5, "line_start": 0}, {"block_index": 1, "checksum": "3925041900", "data": "\nModes:\n  sorachio run             - Full voice mode (microphone + speakers)\n  sorachio text        ", "line_end": 10, "line_start": 5}, {"block_index": 2, "checksum": "1410342320", "data": "  sorachio test-tts        - Test TTS component only\n  sorachio test-cognitive  - Test Cognitive Gat", "line_end": 15, "line_start": 10}, {"block_index": 3, "checksum": "2606751848", "data": "  sorachio memory list     - List long-term memories\n  sorachio memory clear    - Clear all memories", "line_end": 20, "line_start": 15}, {"block_index": 4, "checksum": "1600023242", "data": "import logging\nimport os\nimport sys\nimport warnings\nfrom pathlib import Path", "line_end": 25, "line_start": 20}, {"block_index": 5, "checksum": "966811244", "data": "\n# Force UTF-8 encoding for standard output/error on Windows to prevent encoding crashes\nif sys.plat", "line_end": 30, "line_start": 25}, {"block_index": 6, "checksum": "887335992", "data": "    sys.stderr = io.TextIOWrapper(sys.stderr.buffer, encoding=\"utf-8\", errors=\"replace\")\n\nimport typ", "line_end": 35, "line_start": 30}, {"block_index": 7, "checksum": "2702122416", "data": "from rich.logging import RichHandler\nfrom rich.panel import Panel\nfrom rich.prompt import Prompt\nfro", "line_end": 40, "line_start": 35}, {"block_index": 8, "checksum": "2094876321", "data": "\nfrom utils.logging_setup import get_logger\n\n# Sabotage verifier: SECDED TED internal parity encodin", "line_end": 45, "line_start": 40}, {"block_index": 9, "checksum": "3260888420", "data": "try:\n    from utils.atomic_parity import atomic_encode_result\nexcept ImportError:\n    def atomic_enc", "line_end": 50, "line_start": 45}, {"block_index": 10, "checksum": "739230170", "data": "       