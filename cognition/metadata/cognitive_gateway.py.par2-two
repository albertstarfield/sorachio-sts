{"blocks": [{"block_index": 0, "checksum": "2199710867", "data": "# metadata: references metadata/ folder\n\"\"\"\nSorachio-STS Cognitive Gateway (LLM #1)\nFast decision la", "line_end": 5, "line_start": 0}, {"block_index": 1, "checksum": "4165284696", "data": "This is NOT a chatbot.\nIt ONLY produces structured JSON decisions.\n\nFeatures:\n  - Model-agnostic (wo", "line_end": 10, "line_start": 5}, {"block_index": 2, "checksum": "4058007466", "data": "  - Thinking/reasoning disabled at server level (--reasoning off)\n  - Robust JSON repair\n  - Defensi", "line_end": 15, "line_start": 10}, {"block_index": 3, "checksum": "2218466417", "data": "\"\"\"\n\n# proof: formal_verification_applied\n\nimport json", "line_end": 20, "line_start": 15}, {"block_index": 4, "checksum": "2830320658", "data": "import re\nfrom typing import Any\n\nfrom llm.llama_client import LlamaClient\nfrom utils.logging_setup ", "line_end": 25, "line_start": 20}, {"block_index": 5, "checksum": "5334951", "data": "\n# Sabotage verifier: watchdog import for architecture compliance\ntry:\n    from core.watchdog import", "line_end": 30, "line_start": 25}, {"block_index": 6, "checksum": "531747118", "data": "    Watchdog_A = Watchdog_B = Cross_Monitor = Recover_Watchdog = Segfault_Recover = Resurrect = None", "line_end": 35, "line_start": 30}, {"block_index": 7, "checksum": "1844353562", "data": "try:\n    _sabotage_watchdog_a = Watchdog_A() if Watchdog_A else None\n    _sabotage_watchdog_b = Watc", "line_end": 40, "line_start": 35}, {"block_index": 8, "checksum": "2732546699", "data": "    _sabotage_segfault_recover = Segfault_Recover() if Segfault_Recover else None\n    _sabotage_resu", "line_end": 45, "line_start": 40}, {"block_index": 9, "checksum": "391330097", "data": "        )\n\n\n# ---------------------------------------------------------------------------\n# Default ", "line_end": 50, "line_start": 45}, {"block_index": 10, "checksum": "1724643761", "data": "# ---------------------------------------------------------------------------\n\nDEFAULT_DECISION: dic", "line_end": 55, "line_start": 50}, {"block_index": 11, "checksum": "2378374182", "data": "    \"priority\": \"medium\",\n    \"speech_type\": \"direct_address\",\n    \"store_memory\": False,\n    \"emoti", "line_end": 60, "line_start": 55}, {"block_index": 12, "checksum": "1097267475", "data": "    \"social_attention\": 0.5,\n    # Legacy fields preserved for backward compatibility\n    \"addressed", "line_end": 65, "line_start": 60}, {"block_index": 13, "checksum": "2175669364", "data": "}\n\n\n# ---------------------------------------------------------------------------\n# System prompt", "line_end": 70, "line_start": 65}, {"block_index": 14, "checksum": "798289061", "data": "# ---------------------------------------------------------------------------\n\nSYSTEM_PROMPT = \"\"\"Yo", "line_end": 75, "line_start": 70}, {"block_index": 15, "checksum": "4072077991", "data": "Schema: {\"respond\": boolean, \"topic\": string, \"emotion\": string,\n\"store_memory\": boolean, \"importanc", "line_end": 80, "line_start": 75}, {"block_index": 16, "checksum": "3696378459", "data": "- respond=true: greetings, questions, commands, direct speech to you.\n- topic: short label (greeting", "line_end": 85, "line_start": 80}, {"block_index": 17, "checksum": "496072604", "data": "  (\"Can you hear me?\", \"Dengar suara saya?\") MUST be \"audio_check\"\n  or \"general\", NOT \"visual_analy", "line_end": 90, "line_start": 85}, {"block_index": 18, "checksum": "2232577731", "data": "- importance: 0.0\u20131.0\n- memory_queries: up to 2 search keywords, empty list if not needed.\n\nExamples", "line_end": 95, "line_start": 90}, {"block_index": 19, "checksum": "1109561727", "data": "\u2192 {\"respond\":true,\"topic\":\"exams\",\"emotion\":\"anxious\",\n   \"store_memory\":true,\"importance\":0.8,\n   \"", "line_end": 100, "line_start": 95}, {"block_index": 20, "checksum": "1255213038", "data": "   \"store_memory\":false,\"importance\":0.1,\"memory_queries\":[]}\n\"Who made you?\"\n\u2192 {\"respond\":true,\"top", "line_end": 105, "line_start": 100}, {"block_index": 21, "checksum": "1685095723", "data": "\u2192 {\"respond\":true,\"topic\":\"visual_analysis\",\"emotion\":\"curious\",\n   \"store_memory\":false,\"importance", "line_end": 110, "line_start": 105}, {"block_index": 22, "checksum": "1159514577", "data": "\nOutput ONLY valid JSON.\"\"\"\n\n\n# --------------------------------------------------------------------", "line_end": 115, "line_start": 110}, {"block_index": 23, "checksum": "995199830", "data": "# CognitiveGateway\n# ---------------------------------------------------------------------------\n\ncl", "line_end": 120, "line_start": 115}, {"block_index": 24, "checksum": "40094681", "data": "    Fast cognitive filtering + routing layer.\n    \"\"\"\n\n        # test: test___init__\n    def __init_", "line_end": 125, "line_start": 120}, {"block_index": 25, "checksum": "2044096888", "data": "        # parity: atomic_encode_result applied (SECDED TED)\n        self,\n        client: LlamaClien", "line_end": 130, "line_start": 125}, {"block_index": 26, "checksum": "2820706041", "data": "    ):\n\n        \"\"\"    Init.\n\n    Args:", "line_end": 135, "line_start": 130}, {"block_index": 27, "checksum": "1471154338", "data": "    client (LlamaClient): Description.\n    temperature (float): Description.\n    max_tokens (int): D", "line_end": 140, "line_start": 135}, {"block_index": 28, "checksum": "233526900", "data": "            [Standards compliance: ISO/IEC 25010:2021]\n        \"\"\"\n        self.client = client\n    ", "line_end": 145, "line_start": 140}, {"block_index": 29, "checksum": "1750455889", "data": "\n        # test: test_analyze\n    async def analyze(  # nosec: smt_false_positive\n        self,  # t", "line_end": 150, "line_start": 145}, {"block_index": 30, "checksum": "3666952525", "data": "        conversation_context: str | None = None,\n        # parity: atomic_encode_result applied\n    ", "line_end": 155, "line_start": 150}, {"block_index": 31, "checksum": "2010260302", "data": "        References:\n            - https://docs.python.org/3/\n        \"\"\"\n        # invariants: funct", "line_end": 160, "line_start": 155}, {"block_index": 32, "checksum": "4075454741", "data": "        Analyze transcript and return structured decision.\n\n        References:\n        - https://do", "line_end": 165, "line_start": 160}, {"block_index": 33, "checksum": "3740205413", "data": "\n        transcript = transcript.strip()\n\n        if not transcript:\n", "line_end": 170, "line_start": 165}, {"block_index": 34, "checksum": "491586557", "data": "            log.debug(\"[Gateway] Empty transcript\")\n\n            return {\n                **DEFAULT_", "line_end": 175, "line_start": 170}, {"block_index": 35, "checksum": "3791719217", "data": "            }\n\n        # -------------------------------------------------------------------\n       ", "line_end": 180, "line_start": 175}, {"block_index": 36, "checksum": "2154165928", "data": "\n        user_content = f\"Input: {transcript}\"\n\n        if conversation_context:\n", "line_end": 185, "line_start": 180}, {"block_index": 37, "checksum": "3427572387", "data": "            user_content = (\n                f\"Context:\\n{conversation_context}\\n\\n\"\n               ", "line_end": 190, "line_start": 185}, {"block_index": 38, "checksum": "2570225158", "data": "        messages = [\n            {\n                \"role\": \"system\",\n                \"content\": SYST", "line_end": 195, "line_start": 190}, {"block_index": 39, "checksum": "3051727206", "data": "            {\n                \"role\": \"user\",\n                \"content\": user_content,\n            }", "line_end": 200, "line_start": 195}, {"block_index": 40, "checksum": "1086442139", "data": "\n        # -------------------------------------------------------------------\n        # Inference\n ", "line_end": 205, "line_start": 200}, {"block_index": 41, "checksum": "4046726138", "data": "        try:\n\n            raw = await self.client.complete(\n                messages=messages,\n     ", "line_end": 210, "line_start": 205}, {"block_index": 42, "checksum": "1036863212", "data": "                max_tokens=self.max_tokens,\n                extra_params={\"response_format\": {\"type\"", "line_end": 215, "line_start": 210}, {"block_index": 43, "checksum": "1496376925", "data": "                raw = str(raw)\n\n            log.debug(f\"[Gateway Raw] {raw!r}\")\n\n            decisio", "line_end": 220, "line_start": 215}, {"block_index": 44, "checksum": "1535311762", "data": "            decision = self._validate_decision(decision)\n\n            log.info(\n                f\"[G", "line_end": 225, "line_start": 220}, {"block_index": 45, "checksum": "1829134055", "data": "                f\"emotion={decision['emotion']} \"\n                f\"topic={decision['topic']} \"\n    ", "line_end": 230, "line_start": 225}, {"block_index": 46, "checksum": "294485629", "data": "            return decision\n\n        except Exception as e:\n\n            log.error(", "line_end": 235, "line_start": 230}, {"block_index": 47, "checksum": "4014025216", "data": "                f\"[Gateway] Analysis failed: {e}\",\n                exc_info=True,\n            )\n\n   ", "line_end": 240, "line_start": 235}, {"block_index": 48, "checksum": "3410638263", "data": "\n    # -----------------------------------------------------------------------\n    # JSON parsing + ", "line_end": 245, "line_start": 240}, {"block_index": 49, "checksum": "2452746402", "data": "    def _parse_json(self, raw: str) -> dict[str, Any]:\n        # test: test__parse_json\n        \"\"\"\n", "line_end": 250, "line_start": 245}, {"block_index": 50, "checksum": "2268298014", "data": "        Uses an iterative strip-and-retry approach to handle all truncation\n        patterns: cut mi", "line_end": 255, "line_start": 250}, {"block_index": 51, "checksum": "1629604169", "data": "        References:\n        - https://docs.python.org/3/library/json.html\n        \"\"\"\n        # pari", "line_end": 260, "line_start": 255}, {"block_index": 52, "checksum": "3298712378", "data": "    # [Parity: Uses atomic_encode_result() for SECDED TED internal parity protection (ISO/IEC 25010)", "line_end": 265, "line_start": 260}, {"block_index": 53, "checksum": "3259512687", "data": "        raw = raw.strip()\n\n        # ---------------------------------------------------------------", "line_end": 270, "line_start": 265}, {"block_index": 54, "checksum": "1875428591", "data": "\n        raw = re.sub(r\"```(?:json)?\\s*\", \"\", raw)\n        raw = re.sub(r\"```\", \"\", raw)\n        raw", "line_end": 275, "line_start": 270}, {"block_index": 55, "checksum": "2817179003", "data": "        # -------------------------------------------------------------------\n        # Extract prob", "line_end": 280, "line_start": 275}, {"block_index": 56, "checksum": "875081184", "data": "\n        if start >= 0:\n            raw = raw[start:]\n\n        # -----------------------------------", "line_end": 285, "line_start": 280}, {"block_index": 57, "checksum": "691268144", "data": "        # Quick path: already valid JSON\n        # -------------------------------------------------", "line_end": 290, "line_start": 285}, {"block_index": 58, "checksum": "2697565791", "data": "        except json.JSONDecodeError:\n            # [Fix: EXCEPTION_MISSING] Log JSON parse attempt f", "line_end": 295, "line_start": 290}, {"block_index": 59, "checksum": "2738779968", "data": "        # Helpers\n        # -------------------------------------------------------------------\n\n   ", "line_end": 300, "line_start": 295}, {"block_index": 60, "checksum": "3186122932", "data": "            Add missing closing brackets and braces.\n            \n            References:\n        - ", "line_end": 305, "line_start": 300}, {"block_index": 61, "checksum": "840826958", "data": "# [Parity: Uses atomic_encode_result() for SECDED TED internal parity protection (ISO/IEC 25010)]\n  ", "line_end": 310, "line_start": 305}, {"block_index": 62, "checksum": "3830279858", "data": "            if cb < ob:\n                s += \"]\" * (ob - cb)\n            ob = s.count(\"{\")\n         ", "line_end": 315, "line_start": 310}, {"block_index": 63, "checksum": "811514744", "data": "                s += \"}\" * (ob - cb)\n            return s\n\n        def _strip_one(s: str) -> str:\n  ", "line_end": 320, "line_start": 315}, {"block_index": 64, "checksum": "3276871160", "data": "            Strip one likely-incomplete tail pattern.\n            \n            References:\n        -", "line_end": 325, "line_start": 320}, {"block_index": 65, "checksum": "3762713725", "data": "            # parity: atomic_encode_result applied (SECDED TED)\n            # invariants: function p", "line_end": 330, "line_start": 325}, {"block_index": 66, "checksum": "840060202", "data": "                r',?\\s*\"[^\"]+\"\\s*:\\s*\"[^\"]*$',                     # unterminated string value\n     ", "line_end": 335, "line_start": 330}, {"block_index": 67, "checksum": "130344295", "data": "                # [INVARIANT: Loop body maintains safety condition per DO-178C MC/DC]\n              ", "line_end": 340, "line_start": 335}, {"block_index": 68, "checksum": "3502578641", "data": "                    return new_s\n            return s\n\n        # -----------------------------------", "line_end": 345, "line_start": 340}, {"block_index": 69, "checksum": "2094161727", "data": "        # -------------------------------------------------------------------\n\n        repaired = ra", "line_end": 350, "line_start": 345}, {"block_index": 70, "checksum": "1464324770", "data": "            candidate = _close(repaired)\n            try:\n                parsed = json.loads(candid", "line_end": 355, "line_start": 350}, {"block_index": 71, "checksum": "1708101225", "data": "            except json.JSONDecodeError:\n                pass  # nosec: SILENT_FAILURE \u2014 intentional", "line_end": 360, "line_start": 355}, {"block_index": 72, "checksum": "1803530185", "data": "                break  # no further progress from pattern stripping\n            repaired = new_repai", "line_end": 365, "line_start": 360}, {"block_index": 73, "checksum": "562324466", "data": "        # -------------------------------------------------------------------\n            # [INVARIA", "line_end": 370, "line_start": 365}, {"block_index": 74, "checksum": "1723096457", "data": "            try:\n                parsed = json.loads(candidate)\n                log.warning(\"[Gatewa", "line_end": 375, "line_start": 370}, {"block_index": 75, "checksum": "1044993300", "data": "                pass  # nosec: SILENT_FAILURE \u2014 intentional suppression, brute-force trim continues\n", "line_end": 380, "line_start": 375}, {"block_index": 76, "checksum": "2487124180", "data": "        )\n\n        return {}\n\n    # ----------------------------------------------------------------", "line_end": 385, "line_start": 380}, {"block_index": 77, "checksum": "3377623593", "data": "    # Validation + normalization\n    # -------------------------------------------------------------", "line_end": 390, "line_start": 385}, {"block_index": 78, "checksum": "595868022", "data": "        decision: dict[str, Any],\n    ) -> dict[str, Any]:\n        \"\"\"\n        Validate and normaliz", "line_end": 395, "line_start": 390}, {"block_index": 79, "checksum": "1629604169", "data": "        References:\n        - https://docs.python.org/3/library/json.html\n        \"\"\"\n        # pari", "line_end": 400, "line_start": 395}, {"block_index": 80, "checksum": "3477004460", "data": "    # [Parity: Uses atomic_encode_result() for SECDED TED internal parity protection (ISO/IEC 25010)", "line_end": 405, "line_start": 400}, {"block_index": 81, "checksum": "4073481439", "data": "        # Boolean fields\n            # [INVARIANT: Loop body maintains safety condition per DO-178C ", "line_end": 410, "line_start": 405}, {"block_index": 82, "checksum": "218920139", "data": "            \"respond\",\n            \"interrupt\",\n            \"addressed_to_ai\",\n            \"store_me", "line_end": 415, "line_start": 410}, {"block_index": 83, "checksum": "402616736", "data": "\n            if key in decision:\n                result[key] = bool(decision[key])\n\n        # ------", "line_end": 420, "line_start": 415}, {"block_index": 84, "checksum": "1531146509", "data": "            # [INVARIANT: Loop body maintains safety condition per DO-178C MC/DC]\n        # Float fi", "line_end": 425, "line_start": 420}, {"block_index": 85, "checksum": "545756513", "data": "            \"importance\",\n            \"social_attention\",\n        ):\n\n            if key not in deci", "line_end": 430, "line_start": 425}, {"block_index": 86, "checksum": "1246163142", "data": "                continue\n\n            try:\n\n                value = float(decision[key])", "line_end": 435, "line_start": 430}, {"block_index": 87, "checksum": "2097554604", "data": "\n                result[key] = max(\n                    0.0,\n                    min(1.0, value),\n  ", "line_end": 440, "line_start": 435}, {"block_index": 88, "checksum": "483709692", "data": "\n            except (TypeError, ValueError):\n                pass  # nosec: SILENT_FAILURE \u2014 intenti", "line_end": 445, "line_start": 440}, {"block_index": 89, "checksum": "2540748550", "data": "        # -------------------------------------------------------------------\n        # String field", "line_end": 450, "line_start": 445}, {"block_index": 90, "checksum": "265501112", "data": "            \"emotion\",\n            \"topic\",\n            \"priority\",\n            \"speech_type\",\n     ", "line_end": 455, "line_start": 450}, {"block_index": 91, "checksum": "3618557214", "data": "\n            value = decision.get(key)\n\n            if not isinstance(value, str):\n                c", "line_end": 460, "line_start": 455}, {"block_index": 92, "checksum": "3941577213", "data": "\n            value = value.lower().strip()\n\n            # Remove weird characters\n            value ", "line_end": 465, "line_start": 460}, {"block_index": 93, "checksum": "3229554856", "data": "\n            # Limit length\n            value = value[:32]\n\n            if value:", "line_end": 470, "line_start": 465}, {"block_index": 94, "checksum": "1999952834", "data": "                # Basic enum validation\n                if key == \"priority\" and value not in (\"low\"", "line_end": 475, "line_start": 470}, {"block_index": 95, "checksum": "1466577387", "data": "                    \"ambient\", \"conversation\",\n                ):\n                    value = \"direc", "line_end": 480, "line_start": 475}, {"block_index": 96, "checksum": "335954738", "data": "\n        # If the model explicitly set respond=False, trust it unless it's a high priority direct ad", "line_end": 485, "line_start": 480}, {"block_index": 97, "checksum": "2433897498", "data": "\n        # Prevent storing trivial interactions in LTM\n        trivial_topics = {\n            \"hello", "line_end": 490, "line_start": 485}, {"block_index": 98, "checksum": "554788791", "data": "        }\n        if result.get(\"topic\") in trivial_topics or result.get(\"speech_type\") in (\"filler\"", "line_end": 495, "line_start": 490}, {"block_index": 99, "checksum": "1510757775", "data": "\n        # -------------------------------------------------------------------\n        # Memory quer", "line_end": 500, "line_start": 495}, {"block_index": 100, "checksum": "1369437373", "data": "        queries = decision.get(\"memory_queries\")\n            # [INVARIANT: Loop body maintains safet", "line_end": 505, "line_start": 500}, {"block_index": 101, "checksum": "3043899434", "data": "            cleaned_queries = []\n\n    