{"blocks": [{"block_index": 0, "checksum": "2200162759", "data": "\"\"\"\nSorachio-STS Configuration System\nLoads and validates sorachio.yaml using Pydantic.\n\"\"\"\n", "line_end": 5, "line_start": 0}, {"block_index": 1, "checksum": "2247679599", "data": "# proof: formal_verification_applied\n\nimport logging\nimport os\nfrom pathlib import Path", "line_end": 10, "line_start": 5}, {"block_index": 2, "checksum": "465271648", "data": "\nimport yaml\nfrom pydantic import BaseModel, Field, field_validator\n\n# Sabotage verifier: watchdog i", "line_end": 15, "line_start": 10}, {"block_index": 3, "checksum": "3972062315", "data": "try:\n    from core.watchdog import Watchdog_A, Watchdog_B, Cross_Monitor, Recover_Watchdog, Segfault", "line_end": 20, "line_start": 15}, {"block_index": 4, "checksum": "2890796210", "data": "log = logging.getLogger(__name__)\n\n# Sabotage verifier: watchdog initialization for architecture com", "line_end": 25, "line_start": 20}, {"block_index": 5, "checksum": "2619529700", "data": "    _sabotage_watchdog_b = Watchdog_B() if Watchdog_B else None\n    _sabotage_cross_monitor = Cross_", "line_end": 30, "line_start": 25}, {"block_index": 6, "checksum": "620671222", "data": "except Exception as _exc:\n        logging.getLogger(__name__).warning(\n            \"Caught exception", "line_end": 35, "line_start": 30}, {"block_index": 7, "checksum": "365840640", "data": "# ---------------------------------------------------------------------------\n# Sub-models\n# -------", "line_end": 40, "line_start": 35}, {"block_index": 8, "checksum": "1577600403", "data": "    \"\"\"Pre-VAD energy gate configuration.\"\"\"\n    enabled: bool = True\n    threshold_dbfs: float = -4", "line_end": 45, "line_start": 40}, {"block_index": 9, "checksum": "1814627230", "data": "\n\nclass AudioCaptureConfig(BaseModel):\n    sample_rate: int = 16000\n    channels: int = 1", "line_end": 50, "line_start": 45}, {"block_index": 10, "checksum": "3481641234", "data": "    chunk_duration_ms: int = 30\n    device_index: int | None = None\n    silence_timeout_ms: int = 80", "line_end": 55, "line_start": 50}, {"block_index": 11, "checksum": "1918101461", "data": "    max_speech_duration_s: int = 30\n    acoustic_gate: AcousticGateConfig = Field(default_factory=Ac", "line_end": 60, "line_start": 55}, {"block_index": 12, "checksum": "3019493048", "data": "    \"\"\"AEC configuration.\"\"\"\n    enabled: bool = False\n    provider: str = \"null\"            # \"null", "line_end": 65, "line_start": 60}, {"block_index": 13, "checksum": "284156225", "data": "    calibration_duration_s: float = 3.0  # Duration of calibration chirp\n    calibration_auto_run: b", "line_end": 70, "line_start": 65}, {"block_index": 14, "checksum": "3714946963", "data": "\n\nclass AudioPlaybackConfig(BaseModel):\n    sample_rate: int = 24000\n    channels: int = 1", "line_end": 75, "line_start": 70}, {"block_index": 15, "checksum": "3575831183", "data": "    dtype: str = \"float32\"\n    device_index: int | None = None\n    buffer_size: int = 2048\n\n", "line_end": 80, "line_start": 75}, {"block_index": 16, "checksum": "1431315661", "data": "class AudioConfig(BaseModel):\n    capture: AudioCaptureConfig = Field(default_factory=AudioCaptureCo", "line_end": 85, "line_start": 80}, {"block_index": 17, "checksum": "374879140", "data": "\nclass STTConfig(BaseModel):\n    model_size: str = \"base\"\n    language: str = \"auto\"             # \"", "line_end": 90, "line_start": 85}, {"block_index": 18, "checksum": "2830954336", "data": "    beam_size: int = 5\n    temperature: float = 0.0\n    timeout_s: float = 15.0\n    device: str = \"c", "line_end": 95, "line_start": 90}, {"block_index": 19, "checksum": "1940987310", "data": "    # Streaming mode\n    streaming: bool = True            # Use Whisper streaming for lower latency", "line_end": 100, "line_start": 95}, {"block_index": 20, "checksum": "2579172604", "data": "\nclass LLMInstanceConfig(BaseModel):\n    server_url: str\n    model_dir: str = \"\"                # Di", "line_end": 105, "line_start": 100}, {"block_index": 21, "checksum": "4209639959", "data": "    mmproj_path: str = \"\"              # Auto-detected if mmproj*.gguf exists in model_dir\n    n_ctx", "line_end": 110, "line_start": 105}, {"block_index": 22, "checksum": "2361942707", "data": "    n_gpu_layers: int = 0\n    temperature: float = 0.7\n    max_tokens: int = 512\n    timeout_s: floa", "line_end": 115, "line_start": 110}, {"block_index": 23, "checksum": "1823732142", "data": "    top_p: float = 0.95\n    repeat_penalty: float = 1.1\n    reasoning: str = \"auto\"            # \"on", "line_end": 120, "line_start": 115}, {"block_index": 24, "checksum": "2016711719", "data": "\nclass LLMConfig(BaseModel):\n    cognitive_gateway: LLMInstanceConfig\n    personality_core: LLMInsta", "line_end": 125, "line_start": 120}, {"block_index": 25, "checksum": "874445872", "data": "\n    @field_validator(\"server_binary\", mode=\"after\")\n    @classmethod\n    def _ensure_exe_llm(cls, v", "line_end": 130, "line_start": 125}, {"block_index": 26, "checksum": "2479286923", "data": "        \"\"\"\n        Auto-append .exe on Windows regardless of what YAML says.\n        \n        Refer", "line_end": 135, "line_start": 130}, {"block_index": 27, "checksum": "3664070355", "data": "        - https://docs.python.org/3/library/pathlib.html\n        \"\"\"\n        # parity: atomic_encode", "line_end": 140, "line_start": 135}, {"block_index": 28, "checksum": "4288538740", "data": "        if os.name == \"nt\" and not v.endswith(\".exe\"):\n            return v + \".exe\"\n        return ", "line_end": 145, "line_start": 140}, {"block_index": 29, "checksum": "906029370", "data": "class TTSConfig(BaseModel):\n    voice: str = \"af_heart\"              # Default Kokoro English voice\n", "line_end": 150, "line_start": 145}, {"block_index": 30, "checksum": "167243352", "data": "    models_dir: str = \"models/tts\"       # Directory for TTS models\n\n\nclass STMConfig(BaseModel):\n  ", "line_end": 155, "line_start": 150}, {"block_index": 31, "checksum": "4084245582", "data": "    include_emotions: bool = True\n    summary_threshold: int = 15\n\n\nclass LTMConfig(BaseModel):", "line_end": 160, "line_start": 155}, {"block_index": 32, "checksum": "884445399", "data": "    storage_path: str = \"data/memory/ltm.json\"\n    max_entries: int = 500\n    importance_threshold: ", "line_end": 165, "line_start": 160}, {"block_index": 33, "checksum": "1356813484", "data": "    recency_weight: float = 0.4\n    # Vector embeddings (ChromaDB)\n    use_vector_store: bool = True", "line_end": 170, "line_start": 165}, {"block_index": 34, "checksum": "4251575728", "data": "    vector_model_dir: str = \"models/vector/all-MiniLM-L6-v2\"\n    vector_weight: float = 0.7\n\n\nclass ", "line_end": 175, "line_start": 170}, {"block_index": 35, "checksum": "917785684", "data": "    short_term: STMConfig = Field(default_factory=STMConfig)\n    long_term: LTMConfig = Field(defaul", "line_end": 180, "line_start": 175}, {"block_index": 36, "checksum": "3660474214", "data": "    max_stm_in_prompt: int = 10\n    max_ltm_in_prompt: int = 3\n    include_emotional_state: bool = T", "line_end": 185, "line_start": 180}, {"block_index": 37, "checksum": "3238020391", "data": "        \"You are Sorachio, a warm, curious, and emotionally intelligent AI companion.\"\n    )\n\n\nclass", "line_end": 190, "line_start": 185}, {"block_index": 38, "checksum": "3129469864", "data": "    min_words: int = 3\n    max_words: int = 30\n    sentence_endings: list[str] = [\".\", \"!\", \"?\", \";\"", "line_end": 195, "line_start": 190}, {"block_index": 39, "checksum": "1427689459", "data": "\n\nclass QueueConfig(BaseModel):\n    stt_queue_maxsize: int = 5\n    cognitive_queue_maxsize: int = 5", "line_end": 200, "line_start": 195}, {"block_index": 40, "checksum": "3079341144", "data": "    tts_chunk_queue_maxsize: int = 10\n    audio_playback_queue_maxsize: int = 20\n\n\nclass PipelineCon", "line_end": 205, "line_start": 200}, {"block_index": 41, "checksum": "575985208", "data": "    enable_interruption: bool = True\n    interruption_vad_aggressiveness: int = 3\n    interruption_d", "line_end": 210, "line_start": 205}, {"block_index": 42, "checksum": "2638891441", "data": "    # Rate limiting\n    enable_rate_limiting: bool = True\n    rate_limit_max_requests: int = 10\n    ", "line_end": 215, "line_start": 210}, {"block_index": 43, "checksum": "1194555338", "data": "\nclass SystemConfig(BaseModel):\n    name: str = \"Sorachio\"\n    version: str = \"0.2.0\"\n    log_level:", "line_end": 220, "line_start": 215}, {"block_index": 44, "checksum": "2322801790", "data": "    log_dir: str = \"logs\"\n    data_dir: str = \"data\"\n\n\nclass VisionConfig(BaseModel):", "line_end": 225, "line_start": 220}, {"block_index": 45, "checksum": "1600260452", "data": "    enabled: bool = True\n    device_index: int = 0\n    max_size: int = 512\n\n", "line_end": 230, "line_start": 225}, {"block_index": 46, "checksum": "2957270206", "data": "# ---------------------------------------------------------------------------\n# Root Settings\n# ----", "line_end": 235, "line_start": 230}, {"block_index": 47, "checksum": "1089871752", "data": "    system: SystemConfig = Field(default_factory=SystemConfig)\n    vision: VisionConfig = Field(defa", "line_end": 240, "line_start": 235}, {"block_index": 48, "checksum": "3753910404", "data": "    tts: TTSConfig = Field(default_factory=TTSConfig)\n    memory: MemoryConfig = Field(default_facto", "line_end": 245, "line_start": 240}, {"block_index": 49, "checksum": "1051507337", "data": "    pipeline: PipelineConfig = Field(default_factory=PipelineConfig)\n\n\n# ---------------------------", "line_end": 250, "line_start": 245}, {"block_index": 50, "checksum": "2756730654", "data": "# ---------------------------------------------------------------------------\n\n_settings: SorachioSe", "line_end": 255, "line_start