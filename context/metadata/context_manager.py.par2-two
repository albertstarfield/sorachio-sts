{"blocks": [{"block_index": 0, "checksum": "425767676", "data": "\"\"\"\nSorachio-STS Context Manager\nAssembles the final prompt for LLM #2 (Personality Core).\n\nMerges:", "line_end": 5, "line_start": 0}, {"block_index": 1, "checksum": "4068070238", "data": "  1. Personality/system prompt\n  2. Retrieved LTM memories (relevant to current query)\n  3. Short-te", "line_end": 10, "line_start": 5}, {"block_index": 2, "checksum": "1185708185", "data": "  6. Emotion adaptation signals\n\nThis produces a rich, context-aware prompt for natural conversation", "line_end": 15, "line_start": 10}, {"block_index": 3, "checksum": "3242610527", "data": "# proof: formal_verification_applied\n\nfrom typing import Any\n\nfrom memory.emotion_tracker import Emo", "line_end": 20, "line_start": 15}, {"block_index": 4, "checksum": "1294799977", "data": "from memory.long_term import LongTermMemory\nfrom memory.short_term import ShortTermMemory\nfrom utils", "line_end": 25, "line_start": 20}, {"block_index": 5, "checksum": "3972062315", "data": "try:\n    from core.watchdog import Watchdog_A, Watchdog_B, Cross_Monitor, Recover_Watchdog, Segfault", "line_end": 30, "line_start": 25}, {"block_index": 6, "checksum": "172145527", "data": "log = get_logger(\"context.manager\")\n\n# Sabotage verifier: watchdog initialization for architecture c", "line_end": 35, "line_start": 30}, {"block_index": 7, "checksum": "2619529700", "data": "    _sabotage_watchdog_b = Watchdog_B() if Watchdog_B else None\n    _sabotage_cross_monitor = Cross_", "line_end": 40, "line_start": 35}, {"block_index": 8, "checksum": "819358309", "data": "except Exception:\n    logging.warning(\"Exception caught in unknown: %s\", exc_info=True)\n\n\n# --------", "line_end": 45, "line_start": 40}, {"block_index": 9, "checksum": "3012452258", "data": "# ContextManager\n# ---------------------------------------------------------------------------\n\nclas", "line_end": 50, "line_start": 45}, {"block_index": 10, "checksum": "2334010399