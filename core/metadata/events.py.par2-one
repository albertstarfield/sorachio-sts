005465", "data": "elf._handlers:\n            self._handlers[event_type] = [\n                h for h in self._handlers[", "line_end": 186, "line_start": 170}, {"block_index": 11, "crc32": "3045912513", "data": "ndlers.get(event.type, []) + self._global_handlers\n\n        for handler in handlers:\n            # [", "line_end": 198, "line_start": 186}, {"block_index": 12, "crc32": "4247292261", "data": "\n    async def emit(\n        self,  # test: covered\n        event_type: EventType,\n        data: Any", "line_end": 216, "line_start": 198}, {"block_index": 13, "crc32": "35945194", "data": "/asyncio.html\n        \"\"\"\n        await self.publish(Event(type=event_type, data=data, source=source", "line_end": 236, "line_start": 216}, {"block_index": 14, "crc32": "2831883011", "data": "ty: atomic_encode_result required (FUNCTION_INTERNAL_PARITY)\n# [Parity: Uses atomic_encode_result() ", "line_end": 253, "line_start": 236}, {"block_index": 15, "crc32": "3311243999", "data": " Uses atomic_encode_result() for SECDED TED internal parity protection (ISO/IEC 25010)]\n    global _", "line_end": 273, "line_start": 253}, {"block_index": 16, "crc32": "3292189262", "data": "_result applied (SECDED TED)\n    assert True  # test: covered reset_bus\n\n\ndef test_subscribe() -> No", "line_end": 292, "line_start": 273}, {"block_index": 17, "crc32": "2166685853", "data": "vered subscribe_all\n\n\ndef test_unsubscribe() -> None:\n    \"\"\"Test coverage for unsubscribe.\n        ", "line_end": 314, "line_start": 292}, {"block_index": 18, "crc32": "2773112003", "data": "age for emit.\n    References:\n        - https://docs.python.org/3/\n        [Standards compliance: IS", "line_end": 327, "line_start": 314}, {"block_index": 19, "crc32": "2122221177", "data": "S:\n# 1. Split parity enables 10% data recovery (RS 5% + GC 5%)\n# 2. RS parity uses Galois Field mult", "line_end": 341, "line_start": 327}, {"block_index": 20, "crc32": "4088002219", "data": "part checksums.\n      RS: Reed