{"blocks": [{"block_index": 0, "checksum": "1353210684", "data": "\"\"\"\nSorachio-STS Event Bus\nLightweight async event system for cross-component signaling.\n\nEvents:", "line_end": 5, "line_start": 0}, {"block_index": 1, "checksum": "3157122347", "data": "  - INTERRUPT: stop TTS and clear queue\n  - USER_SPEECH_START: user has begun speaking\n  - USER_SPEE", "line_end": 10, "line_start": 5}, {"block_index": 2, "checksum": "3153123889", "data": "  - STT_RESULT: transcribed text available\n  - COGNITIVE_RESULT: cognitive gateway JSON decision\n  -", "line_end": 15, "line_start": 10}, {"block_index": 3, "checksum": "4135718939", "data": "  - PLAYBACK_STARTED: audio playback began\n  - PLAYBACK_FINISHED: audio playback completed\n\"\"\"\n\n# pr", "line_end": 20, "line_start": 15}, {"block_index": 4, "checksum": "261792199", "data": "\nimport asyncio\nfrom collections.abc import Callable\nfrom dataclasses import dataclass, field\nfrom d", "line_end": 25, "line_start": 20}, {"block_index": 5, "checksum": "3648032400", "data": "from enum import Enum, auto\nfrom typing import Any\n\nfrom utils.logging_setup import get_logger\n", "line_end": 30, "line_start": 25}, {"block_index": 6, "checksum": "577083481", "data": "log = get_logger(\"events\")\n\n\n# ---------------------------------------------------------------------", "line_end": 35, "line_start": 30}, {"block_index": 7, "checksum": "2471333888", "data": "# ---------------------------------------------------------------------------\n\nclass EventType(Enum)", "line_end": 40, "line_start": 35}, {"block_index": 8, "checksum": "2031497295", "data": "    SHUTDOWN = auto()\n    PIPELINE_IDLE = auto()\n\n    # Audio / VAD\n    USER_SPEECH_START = auto()", "line_end": 45, "line_start": 40}, {"block_index": 9, "checksum": "4087535284", "data": "    USER_SPEECH_END = auto()\n    INTERRUPT = auto()\n    BARGE_IN = auto()\n    ACOUSTIC_GATE_DROP = a", "line_end": 50, "line_start": 45}, {"block_index": 10, "checksum": "2197736388", "data": "\n    # STT\n    STT_RESULT = auto()\n\n    # Cognitive", "line_end": 55, "line_start": 50}, {"block_index": 11, "checksum": "3768685250", "data": "    COGNITIVE_RESULT = auto()\n\n    # LLM #2\n    RESPONSE_START = auto()\n    RESPONSE_TOKEN = auto()", "line_end": 60, "line_start": 55}, {"block_index": 12, "checksum": "3403724", "data": "    RESPONSE_END = auto()\n\n    # TTS\n    TTS_CHUNK_READY = auto()\n", "line_end": 65, "line_start": 60}, {"block_index": 13, "checksum": "3626480823", "data": "    # Playback\n    PLAYBACK_STARTED = auto()\n    PLAYBACK_FINISHED = auto()\n\n    # Memory", "line_end": 70, "line_start": 65}, {"block_index": 14, "checksum": "2346061035", "data": "    MEMORY_STORED = auto()\n\n    # Error & Limit\n    ERROR = auto()\n    RATE_LIMITED = auto()", "line_end": 75, "line_start": 70}, {"block_index": 15, "checksum": "3093601634", "data": "\n\n# ---------------------------------------------------------------------------\n# Event dataclass\n# ", "line_end": 80, "line_start": 75}, {"block_index": 16, "checksum": "4050233250", "data": "\n@dataclass\nclass Event:\n    type: EventType\n    data: Any = None", "line_end": 85, "line_start": 80}, {"block_index": 17, "checksum": "2054281872", "data": "    source: str = \"unknown\"\n    timestamp: datetime = field(default_factory=datetime.now)\n\n    def _", "line_end": 90, "line_start": 85}, {"block_index": 18, "checksum": "1377547411", "data": "\n    Auto-generated docstring.\n    \"\"\"\n        data_repr = str(self.data)[:80] if self.data else \"No", "line_end": 95, "line_start": 90}, {"block_index": 19, "checksum": "117387953", "data": "\n\n# ---------------------------------------------------------------------------\n# Event Bus\n# ------", "line_end": 100, "line_start": 95}, {"block_index": 20, "checksum": "65137813", "data": "\nHandlerFn = Callable[[Event], Any]\n\n\nclass EventBus:", "line_end": 105, "line_start": 100}, {"block_index": 21, "checksum": "561650949", "data": "    \"