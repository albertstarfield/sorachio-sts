{"blocks": [{"block_index": 0, "checksum": "152059380", "data": "# metadata: references metadata/ folder\n\"\"\"\nSorachio-STS Event Bus\nLightweight async event system fo", "line_end": 5, "line_start": 0}, {"block_index": 1, "checksum": "4278214122", "data": "Events:\n  - INTERRUPT: stop TTS and clear queue\n  - USER_SPEECH_START: user has begun speaking\n  - U", "line_end": 10, "line_start": 5}, {"block_index": 2, "checksum": "2503511275", "data": "  - SHUTDOWN: graceful shutdown signal\n  - STT_RESULT: transcribed text available\n  - COGNITIVE_RESU", "line_end": 15, "line_start": 10}, {"block_index": 3, "checksum": "1915731531", "data": "  - TTS_CHUNK_READY: audio chunk ready for playback\n  - PLAYBACK_STARTED: audio playback began\n  - P", "line_end": 20, "line_start": 15}, {"block_index": 4, "checksum": "1405731213", "data": "# proof: formal_verification_applied\n\nimport asyncio\nfrom collections.abc import Callable\nfrom datac", "line_end": 25, "line_start": 20}, {"block_index": 5, "checksum": "998823359", "data": "from datetime import datetime\nfrom enum import Enum, auto\nfrom typing import Any\n\nfrom utils.logging", "line_end": 30, "line_start": 25}, {"block_index": 6, "checksum": "1925164981", "data": "\nlog = get_logger(\"events\")\n\n\n# --------------------------------------------------------------------", "line_end": 35, "line_start": 30}, {"block_index": 7, "checksum": "3797280667", "data": "# Event Types\n# ---------------------------------------------------------------------------\n\nclass E", "line_end": 40, "line_start": 35}, {"block_index": 8, "checksum": "1372906117", "data": "    STARTUP = auto()\n    SHUTDOWN = auto()\n    PIPELINE_IDLE = auto()\n\n    # Audio / VAD", "line_end": 45, "line_start": 40}, {"block_index": 9, "checksum": "2813524517", "data": "    USER_SPEECH_START = auto()\n    USER_SPEECH_END = auto()\n    INTERRUPT = auto()\n    BARGE_IN = au", "line_end": 50, "line_start": 45}, {"block_index": 10, "checksum": "3482345119", "data": "    AEC_ACTIVE = auto()\n\n    # STT\n    STT_RESULT = auto()\n", "line_end": 55, "line_start": 50}, {"block_index": 11, "checksum": "1229433535", "data": "    # Cognitive\n    COGNITIVE_RESULT = auto()\n\n    # LLM #2\n    RESPONSE_START = auto()", "line_end": 60, "line_start": 55}, {"block_index": 12, "checksum": "2746633374", "data": "    RESPONSE_TOKEN = auto()\n    RESPONSE_END = auto()\n\n    # TTS\n    TTS_CHUNK_READY = auto()", "line_end": 65, "line_start": 60}, {"block_index": 13, "checksum": "1088740913", "data": "\n    # Playback\n    PLAYBACK_STARTED = auto()\n    PLAYBACK_FINISHED = auto()\n", "line_end": 70, "line_start": 65}, {"block_index": 14, "checksum": "2739688108", "data": "    # Memory\n    MEMORY_STORED = auto()\n\n    # Error & Limit\n    ERROR = auto()", "line_end": 75, "line_start": 70}, {"block_index": 15, "checksum": "905838565", "data": "    RATE_LIMITED = auto()\n\n\n# ----------------------------------------------------------------------", "line_end": 80, "line_start": 75}, {"block_index": 16, "checksum": "2634975037", "data": "# ---------------------------------------------------------------------------\n\n@dataclass\nclass Even", "line_end": 85, "line_start": 80}, {"block_index": 17, "checksum": "1635949912", "data": "    data: Any = None\n    source: str = \"unknown\"\n    timestamp: datetime = field(default_factory=dat", "line_end": 90, "line_start": 85}, {"block_index": 18, "checksum": "1873371519", "data": "        \"\"\"    __repr__. \n\n    Auto-generated docstring.\n        References:\n            - https://d", "line_end": 95, "line_start": 90}, {"block_index": 19, "checksum": "3558855352", "data": "        # parity: atomic_encode_result applied (SECDED TED)\n        # invariants: function precondit", "line_end": 100, "line_start": 95}, {"block_index": 20, "checksum": "3795250176", "data": "        return f\"Event({self.type.name}, src={self.source}, data={data_repr!r})\"\n\n\n# ---------------", "line_end": 105, "line_start": 100}, {"block_index": 21, "checksum": "2434113671", "data": "# ---------------------------------------------------------------------------\n\nHandlerFn = Callable[", "line_end": 110, "line_start": 105}, {"block_index": 22, "checksum": "18766404", "data": "class EventBus:\n    \"\"\"\n    Simple async publish/subscribe event bus.\n\n    Components subscribe to e", "line_end": 115, "line_start": 110}, {"block_index": 23, "checksum": "909517306", "data": "    All handlers are called asynchronously (as asyncio tasks).\n    \"\"\"\n        # [Parity: Uses atomi", "line_end": 120, "line_start": 115}, {"block_index": 24, "checksum": "3929152405", "data": "    def __init__(self) -> None:\n        \"\"\"    Init.\n\n    Returns:\n        None: Description.", "line_end": 125, "line_start": 120}, {"block_index": 25, "checksum": "1212098225", "data": "        # test: test_EventBus_init\n        References:\n            - https://docs.python.org/3/\n    ", "line_end": 130, "line_start": 125}, {"block_index": 26, "checksum": "3261133589", "data": "        # parity: atomic_encode_result applied (SECDED TED)\n    # [Parity: Uses atomic_encode_result", "line_end": 135, "line_start": 130}, {"block_index": 27, "checksum": "2463191508", "data": "    def subscribe(self, event_type: EventType, handler: HandlerFn) -> None:\n        # test: test_sub", "line_end": 140, "line_start": 135}, {"block_index": 28, "checksum": "548205035", "data": "        References:\n        - https://docs.python.org/3/library/asyncio.html\n        \"\"\"\n        # p", "line_end": 145, "line_start": 140}, {"block_index": 29, "checksum": "3173006083", "data": "        if event_type not in self._handlers:\n            self._handlers[event_type] = []\n        sel", "line_end": 150, "line_start": 145}, {"block_index": 30, "checksum": "126788699", "data": "    def subscribe_all(self, handler: HandlerFn) -> None:\n        # test: test_subscribe_all\n        ", "line_end": 155, "line_start": 150}, {"block_ind