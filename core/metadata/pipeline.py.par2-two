ine_end": 705, "line_start": 700}, {"block_index": 141, "checksum": "559208263", "data": "                log.info(\"[Cognitive] Decision: NO RESPONSE (not addressed to AI)\")\n                ", "line_end": 710, "line_start": 705}, {"block_index": 142, "checksum": "1534232855", "data": "\n            # \u2500\u2500 Prepare for new turn \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n            # 1. Stop an", "line_end": 715, "line_start": 710}, {"block_index": 143, "checksum": "2230155859", "data": "                self._playback.interrupt()\n\n            # 2. Clear the interrupt flag AFTER stopping", "line_end": 720, "line_start": 715}, {"block_index": 144, "checksum": "2121922779", "data": "            # 3. Drain any stale chunks from previous (interrupted) turn\n            self._flush_que", "line_end": 725, "line_start": 720}, {"block_index": 145, "checksum": "4076593990", "data": "            is_visual_topic = decision.get(\"topic\") == \"visual_analysis\"\n            visual_triggers", "line_end": 730, "line_start": 725}, {"block_index": 146, "checksum": "1666473051", "data": "            has_visual_intent = any(w in transcript.lower() for w in visual_triggers)\n\n            i", "line_end": 735, "line_start": 730}, {"block_index": 147, "checksum": "1360795852", "data": "                image_b64 = capture_frame_base64(\n                    device_index=self.settings.vis", "line_end": 740, "line_start": 735}, {"block_index": 148, "checksum": "2087035555", "data": "                    log.warning(\"[Vision] Failed to capture image, proceeding with text only.\")\n\n   ", "line_end": 745, "line_start": 740}, {"block_index": 149, "checksum": "3665493602", "data": "                cognitive_decision=decision,\n                image_b64=image_b64,\n            )\n\n   ", "line_end": 750, "line_st