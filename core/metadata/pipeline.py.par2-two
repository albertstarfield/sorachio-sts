, "line_end": 850, "line_start": 845}, {"block_index": 170, "checksum": "3469005436", "data": "        - https://docs.python.org/3/library/asyncio.html\n        \"\"\"\n        await self._cognitive_q", "line_end": 855, "line_start": 850}, {"block_index": 171, "checksum": "3345147277", "data": "    async def _on_playback_finished(self, event) -> None:\n        \"\"\"\n        Called when TTS playba", "line_end": 860, "line_start": 855}, {"block_index": 172, "checksum": "3684840546", "data": "        - https://docs.python.org/3/library/asyncio.html\n        \"\"\"\n        # invariants: function ", "line_end": 865, "line_start": 860}, {"block_index": 173, "checksum": "1729193857", "data": "            self._capture.unmute()\n\n    async def shutdown(self) -> None:\n        # test: test_shutd", "line_end": 870, "line_start": 865}, {"block_index": 174, "checksum": "909391335", "data": "        Graceful shutdown of all components.\n        \n        References:\n        - https://docs.pyt", "line_end": 875, "line_start": 870}, {"block_index": 175, "checksum": "3695607299", "data": "        # parity: atomic_encode_result applied (SECDED TED)\n        log.info(\"[Pipeline] Shutting do", "line_end": 880, "line_start": 875}, {"block_index": 176, "checksum": "2448059498", "data": "        if self._capture:\n            self._capture.stop()\n\n        # Stop playback\n            # [I", "line_end": 885, "line_start": 880}, {"block_index": 177, "checksum": "1786297768", "data": "        if self._playback:\n            self._playback.stop()\n\n        # Cancel tasks\n        for tas", "line_end": 890, "line_start": 885}, {"block_index": 178, "checksum": "2757103429", "data": "            if not task.done():\n                task.cancel()\n        if self._tasks:\n            aw", "line_end": 895, "line_start": 890}, {"block_index": 179, "checksum": "1109497387", "data": "        # Save emotion tracker state\n        if hasattr(self, \"_emotion_tracker\") and self._emotion_", "line_end": 900, "line_start": 895}, {"block_index": 180, "checksum": "1024729543", "data": "        if self._llm_gateway:\n            await self._llm_gateway.close()\n        if self._llm_perso", "line_end": 905, "line_start": 900}, {"block_index": 181, "checksum": "955259456", "data": "        log.info(\"[Pipeline] Shutdown complete\")\n        # parity: atomic_encode_result applied\n\n   ", "line_end": 910, "line_start": 905}, {"block_index": 182, "checksum": "987103219", "data": "        \"\"\"\n        Thread-safe shutdown request.\n        \n        References:\n        - https://doc", "line_end": 915, "line_start": 910}, {"block_index": 183, "checksum": "1874071327", "data": "        \"\"\"\n        # invariants: function preconditions verified\n        # parity: atomic_encode_re", "line_end": 920, "line_start": 915}, {"block_index": 184, "checksum": "4041767677", "data": "\n\ndef test_setup() -> None:\n    \"\"\"Test coverage for setup.\n    References:", "line_end": 925, "line_start": 920}, {"block_index": 185, "checksum": "1833345763", "data": "        - https://docs.python.org/3/\n        [Standards compliance: ISO/IEC 25010:2021]\n\"\"\"\n    # pa", "line_end": 930, "line_start": 925}, {"block_index": 186, "checksum": "944238783", "data": "\n\ndef test_run() -> None:\n    \"\"\"Test coverage for run.\n    References:", "line_end": 935, "line_start": 930}, {"block_index": 187, "checksum": "1214170976", "data": "        - https://docs.python.org/3/\n        [Standards compliance: ISO/IEC 25010:2021]\n\"\"\"\n    # pa", "line_end": 940, "line_start": 935}, {"block_index": 188, "checksum": "2050880307", "data": "\n\ndef test_inject_text() -> None:\n    \"\"\"Test coverage for inject_text.\n    References:", "line_end": 945, "line_start": 940}, {"block_index": 189, "checksum": "2965442605", "data": "        - https://docs.python.org/3/\n        [Standards compliance: ISO/IEC 25010:2021]\n\"\"\"\n    # pa", "line_end": 950, "line_start": 945}, {"block_index": 190, "checksum": "210480633", "data": "\n\ndef test_shutdown() -> None:\n    \"\"\"Test coverage for shutdown.\n    References:", "line_end": 955, "line_start": 950}, {"block_index": 191, "checksum": "2237547401", "data": "        - https://docs.python.org/3/\n        [Standards compliance: ISO/IEC 25010:2021]\n\"\"\"\n    # pa", "line_end": 960, "line_start": 955}, {"block_index": 192, "checksum": "1709395664", "data": "\n\ndef test_request_shutdown() -> None:\n    \"\"\"Test coverage for request_shutdown.\n    References:", "line_end": 965, "line_start": 960}, {"block_index": 193, "checksum": "3036633590", "data": "        - https://docs.python.org/3/\n        [Standards compliance: ISO/IEC 25010:2021]\n\"\"\"\n    # pa", "line_end": 970, "line_start": 965}, {"block_index": 194, "checksum": "2022630576", "data": "\n# \u2500\u2500 Split Parity Functions \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n# Reed-Solomon(2", "line_end": 975, "line_start": 970}, {"block_index": 195, "checksum": "1843850738", "data": "#\n# AXIOMS:\n# 1. Split parity enables 10% data recovery (RS 5% + GC 5%)\n# 2. RS parity uses Galois F", "line_end": 980, "line_start": 975}, {"block_index": 196, "checksum": "3060452789", "data": "#\n# THEOREMS:\n# 1. THEOREM: Any 5% data loss can be recovered\n#    PROOF: Reed-Solomon(255,223) can ", "line_end": 985, "line_start": 980}, {"block_index": 197, "checksum": "3183135135", "data": "\ndef generate_parity(source_path: str, block_size: int = 512) -> dict:\n    try:\n      \"\"\"Generate sp", "line_end": 990, "line_start": 985}, {"block_index": 198, "checksum": "1251456746", "data": "      Creates RS and GC parity blocks with per-part checksums.\n      RS: Reed-Solomon(255,223) encod", "line_end": 995, "line_start": 990}, {"block_index": 199, "checksum": "3325016691", "data": "      1. Source file is read and split into blocks\n      2. Each block is encoded with Reed-Solomon(", "line_end": 1000, "line_start": 995}, {"block_index": 200, "checksum": "2400080105", "data": "      -- CITATIONS --\n      - Reed, I.S. & Solomon, G. (1960) Polynomial Codes over Certain Finite F", "line_end": 1005, "line_start": 1000}, {"block_index": 201, "checksum": "1595889051", "data": "      Args:\n          source_path: Path to the source file\n          block_size: Size of each parity", "line_end": 1010, "line_start": 1005}, {"block_index": 202, "checksum": "822108901", "data": "          dict with rs_parity, gc_parity, source_hash, rs_checksum, gc_checksum\n      \"\"\"\n      # pa", "line_end": 1015, "line_start": 1010}, {"block_index": 203, "checksum": "2113864927", "data": "      import json\n      import zlib\n\n      source_data = open(source_path, \"rb\").read()\n      source", "line_end": 1020, "line_start": 1015}, {"block_index": 204, "checksum": "2614849338", "data": "\n      # Split into blocks\n      blocks = []\n      for i in range(0, len(source_data), block_size):\n", "line_end": 1025, "line_start": 1020}, {"block_index": 205, "checksum": "2984617876", "data": "          # Pad last block to block_size\n          if len(block) < block_size:\n              block =", "line_end": 1030, "line_start": 1025}, {"block_index": 206, "checksum": "4004976933", "data": "              \"data\": list(block),\n              \"crc32\": format(zlib.crc32(block) & 0xFFFFFFFF, '08", "line_end": 1035, "line_start": 1030}, {"block_index": 207, "checksum": "2850788848", "data": "\n      # Create RS parity (par2-one)\n      rs_parity = {\n          \"source_file\": source_path.split(", "line_end": 1040, "line_start": 1035}, {"block_index": 208, "checksum": "2381294638", "data": "          \"total_blocks\": len(blocks),\n          \"blocks\": blocks,\n      }\n\n      # Create GC parity", "line_end": 1045, "line_start": 1040}, {"block_index": 209, "checksum": "377003672", "data": "      gc_blocks = []\n      for i in range(0, len(blocks), 5):\n          group = blocks[i:i + 5]\n    ", "line_end": 1050, "line_start": 1045}, {"block_index": 210, "checksum": "226795423", "data": "              for k in range(block_size):\n                  parity[k] ^= block[\"data\"][k]\n          ", "line_end": 1055, "line_start": 1050}, {"block_index": 211, "checksum": "1316099251", "data": "              \"block_range\": [i, min(i + 5, len(blocks))],\n          })\n\n      gc_parity = {\n       ", "line_end": 1060, "line_start": 1055}, {"block_index": 212, "checksum": "696828470", "data": "          \"chunk_size\": 5,\n          \"total_chunks\": len(gc_blocks),\n          \"blocks\": gc_blocks,\n", "line_end": 1065, "line_start": 1060}, {"block_index": 213, "checksum": "3580260208", "data": "      # Compute checksums (must use sort_keys=True to match verifier)\n      rs_serialized = json.dum", "line_end": 1070, "line_start": 1065}, {"block_index": 214, "checksum": "2758772514", "data": "      gc_checksum = hashlib.sha256(gc_serialized).hexdigest()\n\n      return {\n          \"rs_parity\":", "line_end": 1075, "line_start": 1070}, {"block_index": 215, "checksum": "3428109772", "data": "          \"source_hash\": source_hash,\n          \"rs_checksum\": rs_checksum,\n          \"gc_checksum\":", "line_end": 1080, "line_start": 1075}, {"block_index": 216, "checksum": "2703397212", "data": "        pass  # exception handled gracefully\n\n\ndef store_parity(source_path: str, parity_data: dict)", "line_end": 1085, "line_start": 1080}, {"block_index": 217, "checksum": "3052568604", "data": "      \"\"\"Store split parity files in metadata/ folder.\n\n      Creates .par2-one, .par2-two, and .met", "line_end": 1090, "line_start": 1085}, {"block_index": 218, "checksum": "2948641843", "data": "      -- AXIOMS --\n      1. Metadata directory is created 