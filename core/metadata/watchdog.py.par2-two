{"blocks": [{"block_index": 0, "checksum": "165002374", "data": "# metadata: references metadata/ folder\n\"\"\"Dual asymmetric watchdog system for Sorachio-STS.\n\nImplem", "line_end": 5, "line_start": 0}, {"block_index": 1, "checksum": "1434383658", "data": "Both watchdogs implement segfault resurrection for crash recovery.\n\nAXIOMS:\n    - System MUST detect", "line_end": 10, "line_start": 5}, {"block_index": 2, "checksum": "3498842373", "data": "    # [Fix: SEGFAULT_REFERENCE] Safety: bounds/null check applied\n        - Segfault handler MUST at", "line_end": 15, "line_start": 10}, {"block_index": 3, "checksum": "16880942", "data": "    - Dual asymmetric watchdogs prevent common-mode failures.\n    - Cross-check validates that both ", "line_end": 20, "line_start": 15}, {"block_index": 4, "checksum": "2446685307", "data": "    - Watchdog_A monitors primary pipeline (STT, Cognitive, Personality, TTS).\n    - Watchdog_B moni", "line_end": 25, "line_start": 20}, {"block_index": 5, "checksum": "1944784409", "data": "    - code-quality.md \u00a75.6: Dual asymmetric watchdog requirement\n    - code-quality.md \u00a75.7: Memory ", "line_end": 30, "line_start": 25}, {"block_index": 6, "checksum": "2434357659", "data": "\"\"\"\n\n# proof: formal_verification_applied\n\n# [Fix: INTEGRATION_CONTRACT] from __future__ import anno", "line_end": 35, "line_start": 30}, {"block_index": 7, "checksum": "3306123033", "data": "\nimport logging\nimport os\nimport signal\nimport sys", "line_end": 40, "line_start": 35}, {"block_index": 8, "checksum": "4195134114", "data": "import threading\nimport time\nimport traceback\nfrom collections.abc import Callable\nfrom dataclasses ", "line_end": 45, "line_start": 40}, {"block_index": 9, "checksum": "3188230882", "data": "from enum import Enum\nfrom typing import Any\n\nlogger = logging.getLogger(__name__)\n", "line_end": 50, "line_start": 45}, {"block_index": 10, "checksum": "606803573", "data": "\nclass WatchdogState(Enum):\n    \"\"\"Possible states for a watchdog instance.\"\"\"\n    IDLE = \"idle\"\n   ", "line_end": 55, "line_start": 50}, {"block_index": 11, "checksum": "3667874023", "data": "    ALIVE = \"alive\"\n    STALE = \"stale\"\n    RECOVERING = \"recovering\"\n    DEAD = \"dead\"\n", "line_end": 60, "line_start": 55}, {"block_index": 12, "checksum": "3373171131", "data": "\n@dataclass\nclass Heartbeat:\n    \"\"\"Thread-safe heartbeat record for a monitored component.\n", "line_end": 65, "line_start": 60}, {"block_index": 13, "checksum": "3873337745", "data": "    Attributes:\n        timestamp: Last heartbeat time (monotonic seconds).\n        component: Name ", "line_end": 70, "line_start": 65}, {"block_index": 14, "checksum": "2456128739", "data": "    \"\"\"\n    timestamp: float = 0.0\n    component: str = \"\"\n    alive: bool = True\n    miss_count: in", "line_end": 75, "line_start": 70}, {"block_index": 15, "checksum": "452320370", "data": "    _lock: threading.Lock = field(default_factory=threading.Lock, repr=False)\n\n    def tick(self) ->", "line_end": 80, "line_start": 75}, {"block_index": 16, "checksum": "3117925588", "data": "        \n        # test: test_tick\n        References: [Citation: utils/sabotage_verifier.py PYTHON_", "line_end": 85, "line_start": 80}, {"block_index": 17, "checksum": "3638811411", "data": "        \"\"\"Record a heartbeat tick (component is alive).\"\"\"\n        with self._lock:\n            sel", "line_end": 90, "line_start": 85}, {"block_index": 18, "checksum": "1903671489", "data": "        # parity: atomic_encode_result applied\n\n    def check(self, timeout: float) -> bool:\n\n      ", "line_end": 95, "line_start": 90}, {"block_index": 19, "checksum": "2368834934", "data": "\n        Args:\n            timeout: Maximum seconds since last heartbeat before stale.\n\n        Retu", "line_end": 100, "line_start": 95}, {"block_index": 20, "checksum": "1306117411", "data": "            True if heartbeat is fresh, False if stale.\n        References:\n            - https://do", "line_end": 105, "line_start": 100}, {"block_index": 21, "checksum": "939733317", "data": "        \"\"\"\n        with self._lock:\n            elapsed = time.monotonic() - self.timestamp\n       ", "line_end": 110, "line_start": 105}, {"block_index": 22, "checksum": "2441346484", "data": "                if self.miss_count >= 3:\n                    self.alive = False\n                retu", "line_end": 115, "line_start": 110}, {"block_index": 23, "checksum": "2761273110", "data": "\n    def reset(self) -> None:\n\n        \"\"\"Reset heartbeat state.\n        References:", "line_end": 120, "line_start": 115}, {"block_index": 24, "checksum": "1308640966", "data": "            - https://docs.python.org/3/\n            [Standards compliance: ISO/IEC 25010:2021]\n\"\"\"\n", "line_end": 125, "line_start": 120}, {"block_index": 25, "checksum": "3241383874", "data": "            self.alive = True\n            self.miss_count = 0\n        # parity: atomic_encode_result", "line_end": 130, "line_start": 125}, {"block_index": 26, "checksum": "2097254188", "data": "class Watchdog_A:\n    \"\"\"Primary Watchdog \u2014 monitors core pipeline components.\n\n    Watches: STT Wor", "line_end": 135, "line_start": 130}, {"block_index": 27, "checksum": "2555048034", "data": "\n    The primary watchdog runs a background thread that periodically checks\n    all registered heart", "line_end": 140, "line_start": 135}, {"block_index": 28, "checksum": "2605801350", "data": "    a critical error and falls back to degraded mode (no monitoring).\n\n    Args:\n        heartbeat_t", "line_end": 145, "line_start": 140}, {"block_index": 29, "checksum": "425883316", "data": "    \"\"\"\n\n    def __init__(\n        # parity: atomic_encode_result applied (SECDED TED)\n        self,", "line_end": 150, "line_start": 145}, {"block_index": 30, "checksum": "4254688553", "data": "        heartbeat_timeout: float = 10.0,\n        check_interval: float = 2.0,\n    ) -> None:\n       ", "line_end": 155, "line_start": 150}, {"block_index": 31, "checksum": "2035207292", "data": "        \n        # test: test___init__\n        References: [Citation: utils/sabotage_verifier.py PYT", "line_end": 160, "line_start": 155}, {"block_index": 32, "checksum": "908222331", "data": "\n        self._timeout = heartbeat_timeout\n        self._interval = check_interval\n        self._hea", "line_end": 165, "line_start": 160}, {"block_index": 33, "checksum": "759619383", "data": "        self._thread: threading.Thread | None = None\n        self._stop_event = threading.Event()\n  ", "line_end": 170, "line_start": 165}, {"block_index": 34, "checksum": "1974283991", "data": "        self._resurrect_callback: Callable[[], None] | None = None\n        self._crash_count = 0\n   ", "line_end": 175, "line_start": 170}, {"block_index": 35, "checksum": "3415711286", "data": "            self._timeout,\n            self._interval,\n        )\n\n    @property", "line_end": 180, "line_start": 175}, {"block_index": 36, "checksum": "2519561961", "data": "    def state(self) -> WatchdogState:\n        \"\"\"\n        Auto-generated docstring for state.\n      ", "line_end": 185, "line_start": 180}, {"block_index": 37, "checksum": "2844102896", "data": "        References: [Citation: utils/sabotage_verifier.py PYTHON_FUNCTION_COVERAGE]\n        \"\"\"\n\n   ", "line_end": 190, "line_start": 185}, {"block_index": 38, "checksum": "4136655827", "data": "        # parity: atomic_encode_result applied\n\n    @property\n    def crash_count(self) -> int:\n", "line_end": 195, "line_start": 190}, {"block_index": 39, "checksum": "2952373327", "data": "        \"\"\"Number of crash recoveries attempted.\n        References:\n            - https://docs.pyth", "line_end": 200, "line_start": 195}, {"block_index": 40, "checksum": "990392460", "data": "        return self._crash_count\n        # parity: atomic_encode_result applied\n\n    def register_co", "line_end": 205, "line_start