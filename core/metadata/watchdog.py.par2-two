reservation and\n    system restart on memory viol", "line_end": 1010, "line_start": 1005}, {"block_index": 202, "checksum": "877730773", "data": "        resurrect_callback: Function to call for system restart.\n\n    AXIOM: SIGSEGV handler MUST be", "line_end": 1015, "line_start": 1010}, {"block_index": 203, "checksum": "2467461070", "data": "\n    SAFETY FALLBACK: If signal registration fails, logs warning and continues.\n    \"\"\"\n    global _", "line_end": 1020, "line_start": 1015}, {"block_index": 204, "checksum": "362675979", "data": "\n    try:\n        # Register SIGSEGV handler\n        signal.signal(signal.SIGSEGV, Handle_Segfault)\n", "line_end": 1025, "line_start": 1020}, {"block_index": 205, "checksum": "1979619112", "data": "    except (OSError, ValueError) as exc:\n        # SAFETY FALLBACK: Some platforms don't allow signa", "line_end": 1030, "line_start": 1025}, {"block_index": 206, "checksum": "3133269695", "data": "\n\ndef _save_crash_state(signal_name: str, frame: Any) -> None:\n    \"\"\"Save minimal crash state to di", "line_end": 1035, "line_start": 1030}, {"block_index": 207, "checksum": "2939467734", "data": "    Args:\n        signal_name: Name of the signal that caused the crash.\n        frame: Stack frame ", "line_end": 1040, "line_start": 1035}, {"block_index": 208, "checksum": "556803350", "data": "    References:\n        - https://docs.python.org/3/\n    # parity: atomic_encode_result applied (SEC", "line_end": 1045, "line_start": 1040}, {"block_index": 209, "checksum": "621137405", "data": "    try:\n        crash_dir = os.path.join(os.path.dirname(__file__), \"..\", \"logs\")\n        os.makedi", "line_end": 1050, "line_start": 1045}, {"block_index": 210, "checksum": "2511031478", "data": "        import json\n        crash_data = {\n            \"signal\": signal_name,\n            \"pid\": os.", "line_end": 1055, "line_start": 1050}, {"block_index": 211, "checksum": "2378137573", "data": "            \"frame_summary\": str(frame) if frame else \"unknown\",\n        }\n        with open(crash_f", "line_end": 1060, "line_start": 1055}, {"block_index": 212, "checksum": "1667228540", "data": "    except Exception as exc:\n        logger.warning(\"Failed to save crash state: %s\", exc)\n\n\ndef Res", "line_end": 1065, "line_start": 1060}, {"block_index": 213, "checksum": "3792413052", "data": "    watchdog_a: Watchdog_A,\n    watchdog_b: Watchdog_B,\n    restart_fn: Callable[[], None] | None = ", "line_end": 1070, "line_start": 1065}, {"block_index": 214, "checksum": "1255170503", "data": "    \"\"\"\n    Auto-generated docstring for Resurrect.\n    \n    # test: test_Resurrect\n    References: ", "line_end": 1075, "line_start": 1070}, {"block_index": 215, "checksum": "3313487641", "data": "    \"\"\"\n    # invariants: function preconditions verified\n\n    \"\"\"Resurrect the system after catastr", "line_end": 1080, "line_start": 1075}, {"block_index": 216, "checksum": "1429841446", "data": "    Coordinates shutdown of both watchdogs, optional restart, and\n    re-initialization. This is the", "line_end": 1085, "line_start": 1080}, {"block_index": 217, "checksum": "1613251310", "data": "        watchdog_a: Primary watchdog instance.\n        watchdog_b: Secondary watchdog instance.\n    ", "line_end": 1090, "line_start": 1085}, {"block_index": 218, "checksum": "2559539322", "data": "    THEORY: Orderly shutdown prevents resource leaks and zombie threads.\n    APPLICATION: Called by ", "line_end": 1095, "line_start": 1090}, {"block_index": 219, "checksum": "1110901740", "data": "    \"\"\"\n    logger.critical(\n        \"Resurrect: initiating system resurrection (PID=%d)\", os.getpid", "line_end": 1100, "line_start": 1095}, {"block_index": 220, "checksum": "1850285779", "data": "    # Phase 1: Stop both watchdogs\n    try:\n        watchdog_a.stop()\n        logger.info(\"Resurrect", "line_end": 1105, "line_start": 1100}, {"block_index": 221, "checksum": "1647739396", "data": "        logger.error(\"Resurrect: failed to stop Watchdog_A\")\n\n    try:\n        watchdog_b.stop()\n   ", "line_end": 1110, "line_start": 1105}, {"block_index": 222, "checksum": "1449762619", "data": "    except Exception:\n        logger.error(\"Resurrect: failed to stop Watchdog_B\")\n\n    # Phase 2: E", "line_end": 1115, "line_start": 1110}, {"block_index": 223, "checksum": "2387717445", "data": "        try:\n            logger.info(\"Resurrect: executing restart function\")\n            restart_fn", "line_end": 1120, "line_start": 1115}, {"block_index": 224, "checksum": "567395807", "data": "            logger.critical(\n                \"Resurrect: restart function FAILED:\\n%s\",\n            ", "line_end": 1125, "line_start": 1120}, {"block_index": 225, "checksum": "357709150", "data": "            logger.critical(\"Resurrect: entering degraded mode (no monitoring)\")\n    else:\n        l", "line_end": 1130, "line_start": 1125}, {"block_index": 226, "checksum": "812581065", "data": "# ---------------------------------------------------------------------------\n# Module-Level Initial", "line_end": 1135, "line_start": 1130}, {"block_index": 227, "checksum": "989402868", "data": "    restart_fn: Callable[[], None] | None = None,\n    # parity: atomic_encode_result applied\n) -> tu", "line_end": 1140, "line_start": 1135}, {"block_index": 228, "checksum": "2281807235", "data": "    \n    # test: test_initialize_watchdogs\n    References: [Citation: utils/sabotage_verifier.py PYT", "line_end": 1145, "line_start": 1140}, {"block_index": 229, "checksum": "2210794047", "data": "\n    \"\"\"Initialize and wire up both watchdogs with cross-monitoring.\n\n# [Parity: SECDED TED internal", "line_end": 1150, "line_start": 1145}, {"block_index": 230, "checksum": "1230342029", "data": "    from utils.atomic_parity import atomic_encode_result\nexcept ImportError:\n    def atomic_encode_r", "line_end": 1155, "line_start": 1150}, {"block_index": 231, "checksum": "4210209052", "data": "