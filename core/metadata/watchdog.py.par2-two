i", "line_end": 860, "line_start": 855}, {"block_index": 172, "checksum": "4008254015", "data": "    APPLICATION: Signal handler registered via signal.signal().\n\n    SAFETY FALLBACK: If resurrectio", "line_end": 865, "line_start": 860}, {"block_index": 173, "checksum": "3771780729", "data": "    logger.critical(\n        \"Handle_Segfault: received %s at frame %s \u2014 initiating crash recovery\",", "line_end": 870, "line_start": 865}, {"block_index": 174, "checksum": "2628198810", "data": "    # Attempt to save state before dying\n    try:\n        _save_crash_state(sig_name, frame)\n    exc", "line_end": 875, "line_start": 870}, {"block_index": 175, "checksum": "3649612948", "data": "\n    # Trigger resurrection if callback is set\n    if _resurrect_fn:\n        try:\n            _resur", "line_end": 880, "line_start": 875}, {"block_index": 176, "checksum": "4010424882", "data": "        except Exception:\n            logger.critical(\"Handle_Segfault: resurrection callback failed", "line_end": 885, "line_start": 880}, {"block_index": 177, "checksum": "3953144036", "data": "        \"Handle_Segfault: crash dump \u2014 PID=%d, signal=%s\",\n        os.getpid(),\n        sig_name,\n  ", "line_end": 890, "line_start": 885}, {"block_index": 178, "checksum": "2293128047", "data": "    sys.exit(128 + signum)  # nosec: smt_false_positive\n    # parity: atomic_encode_result applied\n\n", "line_end": 895, "line_start": 890}, {"block_index": 179, "checksum": "1287438392", "data": "    resurrect_callback: Callable[[], None] | None = None,\n    # parity: atomic_encode_result applied", "line_end": 900, "line_start": 895}, {"block_index": 180, "checksum": "856656665", "data": "    \n    # test: test_Segfault_Recover\n    References: [Citation: utils/sabotage_verifier.py PYTHON_", "line_end": 905, "line_start": 900}, {"block_index": 181, "checksum": "1373084365", "data": "    # [Fix: SEGFAULT_REFERENCE] Safety: bounds/null check applied\n    \"\"\"Register segfault handler w", "line_end": 910, "line_start": 905}, {"block_index": 182, "checksum": "2443849843", "data": "\n    Args:\n        resurrect_callback: Function to call for system restart.\n\n    AXIOM: SIGSEGV hand", "line_end": 915, "line_start": 910}, {"block_index": 183, "checksum": "3197303983", "data": "    THEORY: Signal-based recovery provides lowest-level crash detection.\n    APPLICATION: Call durin", "line_end": 920, "line_start": 915}, {"block_index": 184, "checksum": "2663203479", "data": "    global _resurrect_fn\n    _resurrect_fn = resurrect_callback\n\n    try:\n        # Register SIGSEGV", "line_end": 925, "line_start": 920}, {"block_index": 185, "checksum": "3947125912", "data": "        signal.signal(signal.SIGSEGV, Handle_Segfault)\n        logger.info(\"Segfault_Recover: SIGSEG", "line_end": 930, "line_start": 925}, {"block_index": 186, "checksum": "3788107456", "data": "            \"Segfault_Recover: failed to register SIGSEGV handler: %s\", exc\n        )\n\n\ndef _save_cr", "line_end": 935, "line_start": 930}, {"block_index": 187, "checksum": "4203048193", "data": "    \"\"\"Save minimal crash state to disk for post-mortem analysis.\n\n    Args:\n        signal_name: Na", "line_end": 940, "line_start": 935}, {"block_index": 188, "checksum": "1489087630", "data": "\n    SAFETY FALLBACK: If file write fails, only logs warning (no exception propagation).\n    \"\"\"\n   ", "line_end": 945, "line_start": 940}, {"block_index": 189, "checksum": "576453386", "data": "        os.makedirs(crash_dir, exist_ok=True)\n        crash_file = os.path.join(crash_dir, \"crash_st", "line_end": 950, "line_start": 945}, {"block_index": 190, "checksum": "959112406", "data": "            \"signal\": signal_name,\n            \"pid\": os.getpid(),\n            \"timestamp\": time.tim", "line_end": 955, "line_start": 950}, {"block_index": 191, "checksum": "2578364099", "data": "        with open(crash_file, \"w\") as f:\n            json.dump(crash_data, f, indent=2)\n        logg", "line_end": 960, "line_start": 955}, {"block_index": 192, "checksum": "2135444510", "data": "\n\ndef Resurrect(\n    watchdog_a: Watchdog_A,\n    watchdog_b: Watchdog_B,", "line_end": 965, "line_start": 960}, {"block_index": 193, "checksum": "44755279", "data": "    restart_fn: Callable[[], None] | None = None,\n    # parity: atomic_encode_result applied\n) -> No", "line_end": 970, "line_start": 965}, {"block_index": 194, "checksum": "1194389195", "data": "    \n    # test: test_Resurrect\n    References: [Citation: utils/sabotage_verifier.py PYTHON_FUNCTIO", "line_end": 975, "line_start": 970}, {"block_index": 195, "checksum": "3906960855", "data": "    \"\"\"Resurrect the system after catastrophic failure.\n\n    Coordinates shutdown of both watchdogs,", "line_end": 980, "line_start": 975}, {"block_index": 196, "checksum": "4171455792", "data": "\n    Args:\n        watchdog_a: Primary watchdog instance.\n        watchdog_b: Secondary watchdog ins", "line_end": 985, "line_start": 980}, {"block_index": 197, "checksum": "3497512079", "data": "\n    AXIOM: Resurrection MUST cleanly stop all monitoring before restart.\n    THEORY: Orderly shutdo", "line_end": 990, "line_start": 985}, {"block_index": 198, "checksum": "91452587", "data": "    SAFETY FALLBACK: If restart_fn fails, logs critical and returns\n    (system enters degraded mode", "line_end": 995, "line_start": 990}, {"block_index": 199, "checksum": "885364037", "data": "    )\n\n    # Phase 1: Stop both watchdogs\n    try:\n        watchdog_a.stop()", "line_end": 1000, "line_start": 995}, {"block_index": 200, "checksum": "3599035434", "data": "        logger.info(\"Resurrect: Watchdog_A stopped\")\n    except Exception:\n        logger.error(\"Res", "line_end": 1005, "line_start": 1000}, {"block_index": 201, "checksum": "2930663857", "data": "        watchdog_b.stop()\n        logger.info(\"Resurrect: Watchdog_B stopped\")\n    except Exception:", "line_end": 1010, "line_start": 1005}, {"block_index": 202,