: "            self._stop_event.wait(self._interval)\n        logger.debug(\"Watchdog_A: monitor loop exi", "line_end": 360, "line_start": 355}, {"block_index": 72, "checksum": "2909180741", "data": "        stale_components: list[str] = []\n        with self._lock:\n            for name, hb in self._", "line_end": 365, "line_start": 360}, {"block_index": 73, "checksum": "310910586", "data": "                    logger.warning(\n                        \"Watchdog_A: component '%s' stale (miss_", "line_end": 370, "line_start": 365}, {"block_index": 74, "checksum": "931248776", "data": "\n        for name in stale_components:\n            self._trigger_recovery(name)\n\n    def _trigger_re", "line_end": 375, "line_start": 370}, {"block_index": 75, "checksum": "2704060464", "data": "        \"\"\"Trigger recovery for a stale component.\n\n        Args:\n            component: Name of the", "line_end": 380, "line_start": 375}, {"block_index": 76, "checksum": "2598478803", "data": "        SAFETY FALLBACK: If recovery callback raises, logs error and continues.\n        \"\"\"\n        ", "line_end": 385, "line_start": 380}, {"block_index": 77, "checksum": "737537742", "data": "            try:\n                self._state = WatchdogState.RECOVERING\n                logger.info(", "line_end": 390, "line_start": 385}, {"block_index": 78, "checksum": "109372576", "data": "                with self._lock:\n                    if component in self._heartbeats:\n             ", "line_end": 395, "line_start": 390}, {"block_index": 79, "checksum": "277026538", "data": "            except Exception:\n                self._crash_count += 1\n                logger.critical", "line_end": 400, "line_start": 395}, {"block_index": 80, "checksum": "3703254603", "data": "                    self._crash_count,\n                    self._max_crashes,\n                    tr", "line_end": 405, "line_start": 400}, {"block_index": 81, "checksum": "255082069", "data": "                    self._trigger_resurrection()\n\n    def _trigger_resurrection(self) -> None:\n     ", "line_end": 410, "line_start": 405}, {"block_index": 82, "checksum": "2768531046", "data": "        SAFETY FALLBACK: If resurrect callback not set, logs critical and exits.\n        \"\"\"\n       ", "line_end": 415, "line_start": 410}, {"block_index": 83, "checksum": "3509731525", "data": "            self._max_crashes,\n        )\n        if self._resurrect_callback:\n            try:\n     ", "line_end": 420, "line_start": 415}, {"block_index": 84, "checksum": "1154256899", "data": "            except Exception:\n                logger.critical(\n                    \"Watchdog_A: resu", "line_end": 425, "line_start": 420}, {"block_index": 85, "checksum": "137587275", "data": "                # Final fallback: log and degrade\n                logger.critical(\"Watchdog_A: enter", "line_end": 430, "line_start": 425}, {"block_index": 86, "checksum": "1574390325", "data": "        if self._cross_check_callback:\n            try:\n                peer_alive = self._cross_che", "line_end": 435, "line_start": 430}, {"block_index": 87, "checksum": "3688365865", "data": "                        \"Watchdog_A: Cross_Check \u2014 peer watchdog appears stale\"\n                    ", "line_end": 440, "line_start": 435}, {"block_index": 88, "checksum": "2845508093", "data": "                    traceback.format_exc(),\n                )\n\n    def Recover_Watchdog(self, compon", "line_end": 445, "line_start": 440}, {"block_index": 89, "checksum": "508675926", "data": "        \"\"\"Manually trigger recovery for a specific component.\n\n        Args:\n            component:", "line_end": 450, "line_start": 445}, {"block_index": 90, "checksum": "3955596539", "data": "        Returns:\n            True if recovery was triggered, False if component not found.\n\n        ", "line_end": 455, "line_start": 450}, {"block_index": 91, "checksum": "2483273632", "data": "        try:\n            with self._