5, "line_start": 1550}, {"block_index": 311, "checksum": "1760822601", "data": "# 3. GC parity uses weighted XOR for chunk-level protection\n#\n# THEOREMS:\n# 1. THEOREM: Any 5% data ", "line_end": 1560, "line_start": 1555}, {"block_index": 312, "checksum": "1163964776", "data": "\n\ndef generate_parity(source_path: str, block_size: int = 512) -> dict:\n    try:\n      \"\"\"Generate s", "line_end": 1565, "line_start": 1560}, {"block_index": 313, "checksum": "4034179106", "data": "\n      Creates RS and GC parity blocks with per-part checksums.\n      RS: Reed-Solomon(255,223) enco", "line_end": 1570, "line_start": 1565}, {"block_index": 314, "checksum": "117089957", "data": "      -- AXIOMS --\n      1. Source file is read and split into blocks\n      2. Each block is encoded", "line_end": 1575, "line_start": 1570}, {"block_index": 315, "checksum": "1686257783", "data": "\n      -- CITATIONS --\n      - Reed, I.S. & Solomon, G. (1960) Polynomial Codes over Certain Finite ", "line_end": 1580, "line_start": 1575}, {"block_index": 316, "checksum": "545633936", "data": "\n      Args:\n          source_path: Path to the source file\n          block_size: Size of each parit", "line_end": 1585, "line_start": 1580}, {"block_index": 317, "checksum": "1377373103", "data": "      Returns:\n          dict with rs_parity, gc_parity, source_hash, rs_checksum, gc_checksum\n     ", "line_end": 1590, "line_start": 1585}, {"block_index": 318, "checksum": "287032876", "data": "      import hashlib\n      import json\n      import zlib\n\n      source_data = open(source_path, \"rb\"", "line_end": 1595, "line_start": 1590}, {"block_index": 319, "checksum": "2234511367", "data": "      source_hash = hashlib.sha256(source_data).hexdigest()\n\n      # Split into blocks\n      blocks ", "line_end": 1600, "line_start": 1595}, {"block_index": 320, "checksum": "2882916087", "data": "          block = source_data[i:i + block_size]\n          # Pad last block to block_size\n          i", "line_