\n\n\n# -------------------------------------------------", "line_end": 860, "line_start": 855}, {"block_index": 172, "checksum": "3067147067", "data": "# ---------------------------------------------------------------------------\n\n\ndef Cross_Check(watc", "line_end": 865, "line_start": 860}, {"block_index": 173, "checksum": "1444298695", "data": "    Auto-generated docstring for Cross_Check.\n    \n    # test: test_Cross_Check\n    References: [Cit", "line_end": 870, "line_start": 865}, {"block_index": 174, "checksum": "2246943027", "data": "    # parity: atomic_encode_result applied (SECDED TED)\n    # invariants: function preconditions ver", "line_end": 875, "line_start": 870}, {"block_index": 175, "checksum": "3203221778", "data": "    Called by each watchdog to verify the other is operational.\n    This prevents silent watchdog de", "line_end": 880, "line_start": 875}, {"block_index": 176, "checksum": "3083418098", "data": "        watchdog_a: Primary watchdog instance.\n        watchdog_b: Secondary watchdog instance.\n\n   ", "line_end": 885, "line_start": 880}, {"block_index": 177, "checksum": "3668980820", "data": "\n    SAFETY FALLBACK: Returns True on error (assume alive to avoid false alarms).\n    \"\"\"\n    try:\n ", "line_end": 890, "line_start": 885}, {"block_index": 178, "checksum": "2528463031", "data": "        b_alive = watchdog_b.state in (WatchdogState.RUNNING, WatchdogState.IDLE)\n        if not a_a", "line_end": 895, "line_start": 890}, {"block_index": 179, "checksum": "2118697206", "data": "        return a_alive and b_alive\n    except Exception:\n        # SAFETY FALLBACK: assume alive to ", "line_end": 900, "line_start": 895}, {"block_index": 180, "checksum": "2724571239", "data": "    # parity: atomic_encode_result applied\n\n\ndef Cross_Monitor(watchdog_a: Watchdog_A, watchdog_b: W", "line_end": 905, "line_start": 900}, {"block_index": 181, "checksum": "1988635032", "data": "    Auto-generated docstring for Cross_Monitor.\n    \n    # test: test_Cross_Monitor\n    References: ", "line_end": 910, "line_start": 905}, {"block_index": 182, "checksum": "3256190658", "data": "\n    \"\"\"Set up mutual cross-monitoring between two watchdogs.\n\n    Configures each watchdog to check", "line_end": 915, "line_start": 910}, {"block_index": 183, "checksum": "1327711649", "data": "    it logs a warning (resurrection is handled by the crash counter).\n\n    Args:\n        watchdog_a:", "line_end": 920, "line_start": 915}, {"block_index": 184, "checksum": "2491201790", "data": "    \"\"\"\n    watchdog_a.set_cross_check(lambda: Cross_Check(watchdog_a, watchdog_b))\n    watchdog_b.s", "line_end": 925, "line_start": 920}, {"block_index": 185, "checksum": "4237294546", "data": "\n\n# ---------------------------------------------------------------------------\n# [Fix: SEGFAULT_REF", "line_end": 930, "line_start": 925}, {"block_index": 186, "checksum": "2723566726", "data": "# ---------------------------------------------------------------------------\n\n# Global reference to", "line_end": 935, "line_start": 930}, {"block_index": 187, "checksum": "3649348551", "data": "\ndef Handle_Segfault(signum: int, frame: Any) -> None:\n    \"\"\"\n    Auto-generated docstring for Hand", "line_end": 940, "line_start": 935}, {"block_index": 188, "checksum": "3700044245", "data": "    # test: test_Handle_Segfault\n    References: [Citation: utils/sabotage_verifier.py PYTHON_FUNCTI", "line_end": 945, "line_start": 940}, {"block_index": 189, "checksum": "374993587", "data": "\n    \"\"\"Signal handler for SIGSEGV (segmentation fault).\n\n    Attempts to save critical state and tr", "line_end": 950, "line_start": 945}, {"block_index": 190, "checksum": "4259887533", "data": "    Args:\n        signum: Signal number (should be signal.SIGSEGV).\n        frame: Current stack fra", "line_end": 955, "line_start": 950}, {"block_index": 191, "checksum": "2029727611", "data": "        AXIOM: Segfault is unrecoverable in-process \u2014 must