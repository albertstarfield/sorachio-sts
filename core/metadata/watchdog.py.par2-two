{"blocks": [{"block_index": 0, "checksum": "3105511833", "data": "\"\"\"Dual asymmetric watchdog system for Sorachio-STS.\n\nImplements Watchdog_A (Primary) and Watchdog_B", "line_end": 5, "line_start": 0}, {"block_index": 1, "checksum": "2558936831", "data": "\nAXIOMS:\n    - System MUST detect unresponsive components within configurable timeout.\n    - Cross-m", "line_end": 10, "line_start": 5}, {"block_index": 2, "checksum": "2036035424", "data": "        - Segfault handler MUST attempt graceful recovery before force-restart.\n    - Heartbeat tick", "line_end": 15, "line_start": 10}, {"block_index": 3, "checksum": "2623327712", "data": "    - Cross-check validates that both watchdogs are alive, preventing silent failure.\n    - Resurrec", "line_end": 20, "line_start": 15}, {"block_index": 4, "checksum": "4135341341", "data": "    - Watchdog_B monitors auxiliary services (servers, memory, audio playback).\n    - Cross-check ru", "line_end": 25, "line_start": 20}, {"block_index": 5, "checksum": "2237194968", "data": "    - code-quality.md \u00a75.7: Memory violation resurrection\n    - code-quality.md \u00a75.8: Cross-monitori", "line_end": 30, "line_start": 25}, {"block_index": 6, "checksum": "2801130732", "data": "\n# proof: formal_verification_applied\n\n# [Fix: INTEGRATION_CONTRACT] from __future__ import annotati", "line_end": 35, "line_start": 30}, {"block_index": 7, "checksum": "4088396273", "data": "import logging\nimport os\nimport signal\nimport sys\nimport threading", "line_end": 40, "line_start": 35}, {"block_index": 8, "checksum": "2569585737", "data": "import time\nimport traceback\nfrom collections.abc import Callable\nfrom dataclasses import dataclass,", "line_end": 45, "line_start": 40}, {"block_index": 9, "checksum": "388882268", "data": "from typing import Any\n\nlogger = logging.getLogger(__name__)\n\n", "line_end": 50, "line_start": 45}, {"block_index": 10, "checksum": "4121386067", "data": "class WatchdogState(Enum):\n    \"\"\"Possible states for a watchdog instance.\"\"\"\n    IDLE = \"idle\"\n    ", "line_end": 55, "line_start": 50}, {"block_index": 11, "checksum": "1253262668", "data": "    STALE = \"stale\"\n    RECOVERING = \"recovering\"\n    DEAD = \"dead\"\n\n", "line_end": 60, "line_start": 55}, {"block_index": 12, "checksum": "3986345442", "data": "@dataclass\nclass Heartbeat:\n    \"\"\"Thread-safe heartbeat record for a monitored component.\n\n    Attr", "line_end": 65, "line_start": 60}, {"block_index": 13, "checksum": "2634112484", "data": "        timestamp: Last heartbeat time (monotonic seconds).\n        component: Name of the component", "line_end": 70, "line_start": 65}, {"block_index": 14, "checksum": "156211212", "data": "    timestamp: float = 0.0\n    component: str = \"\"\n    alive: bool = True\n    miss_count: int = 0\n  ", "line_end": 75, "line_start": 70}, {"block_index": 15, "checksum": "3096966267", "data": "\n    def tick(self) -> None:\n        \"\"\"\n        Auto-generated docstring for tick.\n        ", "line_end": 80, "line_start": 75}, {"block_index": 16, "checksum": "260308338", "data": "        # test: test_tick\n        References: [Citation: utils/sabotage_verifier.py PYTHON_FUNCTION_", "line_end": 85, "line_start": 80}, {"block_index": 17, "checksum": "2224556580", "data": "        with self._lock:\n            self.timestamp = time.monotonic()\n            self.alive = True", "line_end": 90, "line_start": 85}, {"block_index": 18, "checksum": "1375526857", "data": "\n    def check(self, timeout: float) -> bool:\n\n        \"\"\"Check if heartbeat is within timeout windo", "line_end": 95, "line_start": 90}, {"block_index": 19, "checksum": "1947860431", "data": "        Args:\n            timeout: Maximum seconds since last heartbeat before stale.\n\n        Retur", "line_end": 100, "line_start": 95}, {"block_index": 20, "checksum": "2790852573", "data": "        \"\"\"\n        with self._lock:\n            elapsed = time.monotonic() - self.timestamp\n       ", "line_end": 105, "line_start": 100}, {"block_index": 21, "checksum": "2628756364", "data": "                if self.miss_count >= 3:\n                    self.alive = False\n                retu", "line_end": 110, "line_start": 105}, {"block_index": 22, "checksum": "1671422862", "data": "\n    def reset(self) -> None:\n\n        \"\"\"Reset heartbeat state.\"\"\"\n        with self._lock:", "line_end": 115, "line_start": 110}, {"block_index": 23, "checksum": "53659061", "data": "            self.timestamp = 0.0\n            self.alive = True\n            self.miss_count = 0\n     ", "line_end": 120, "line_start": 115}, {"block_index": 24, "checksum": "1538136839", "data": "\nclass Watchdog_A:\n    \"\"\"Primary Watchdog \u2014 monitors core pipeline components.\n\n    Watches: STT Wo", "line_end": 125, "line_start": 120}, {"block_index": 25, "checksum": "4035268783", "data": "    If any component misses heartbeats beyond threshold, triggers recovery.\n\n    The primary watchdo", "line_end": 130, "line_start": 125}, {"block_index": 26, "checksum": "3289366297", "data": "    SAFETY FALLBACK: If the watchdog thread itself dies, the system logs\n    a critical error and fa", "line_end": 135, "line_start": 130}, {"block_index": 27, "checksum": "861980873", "data": "        check_interval: Seconds between heartbeat checks.\n    \"\"\"\n\n    def __init__(\n        # parit", "line_end": 140, "line_start": 135}, {"block_index": 28, "checksum": "362141943", "data": "        self,\n        heartbeat_timeout: float = 10.0,\n        check_interval: float = 2.0,\n    ) ->", "line_end": 145, "line_start": 140}, {"block_index": 29, "checksum": "82978853", "data": "        Auto-generated docstring for __init__.\n        \n        # test: test___init__\n        Refere", "line_end": 150, "line_start": 145}, {"block_index": 30, "checksum": "4126131239", "data": "\n        self._timeout = heartbeat_timeout\n        self._interval = check_interval\n        self._hea", "line_end": 155, "line_start": 150}, {"block_index": 31, "checksum": "3336714661", "data": "        self._thread: threading.Thread | None = None\n        self._stop_event = threading.Event()\n  ", "line_end": 160, "line_start": 155}, {"block_index": 32, "checksum": "2240492337", "data": "        self._resurrect_callback: Callable[[], None] | None = None\n        self._crash_count = 0\n   ", "line_end": 165, "line_start": 160}, {"block_index": 33, "checksum": "4022873190", "data": "            self._timeout,\n            self._interval,\n        )\n\n    @property", "line_end": 170, "line_start": 165}, {"block_index": 34, "checksum": "3133519467", "data": "    def state(self) -> WatchdogState:\n        \"\"\"\n        Auto-generated docstring for state.\n      ", "line_end": 175, "line_start": 170}, {"block_index": 35, "checksum": "2324373026", "data": "        References: [Citation: utils/sabotage_verifier.py PYTHON_FUNCTION_COVERAGE]\n        \"\"\"\n\n   ", "line_end": 180, "line_start": 175}, {"block_index": 36, "checksum": "3125447229", "data": "        # parity: atomic_encode_result applied\n\n    @property\n    def crash_count(self) -> int:\n", "line_end": 185, "line_start": 180}, {"block_index": 37, "checksum": "2742721435", "data": "        \"\"\"Number of crash recoveries attempted.\"\"\"\n        return self._crash_count\n        # parit", "line_end": 190, "line_start": 185}, {"block_index": 38, "checksum": "4053096520", "data": "        self,\n        name: str,\n        recovery_callback: Callable[[], None] | None = None,\n      ", "line_end": 195, "line_start": 190}, {"block_index": 39, "checksum": "1541265174", "data": "        \"\"\"\n        Auto-generated docstring for register_component.\n        \n        # test: test_r", "line_end": 200, "line_start": 195}, {"block_index": 40, "checksum": "3463089620", "data": "        \"\"\"\n\n        \"\"\"Register a component to be monitored.\n\n        Args:", "line_end": 205, "line_start": 200}, {"block_index": 41, "checksum