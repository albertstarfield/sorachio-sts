ck_index": 51, "checksum": "2241693118", "data": "        \n        # test: test_tick\n        References: [Citation: utils/sabotage_verifier.py PYTHON_", "line_end": 260, "line_start": 255}, {"block_index": 52, "checksum": "3244178664", "data": "\n        \"\"\"Send a heartbeat from a monitored component.\n\n        Args:\n            component: Name ", "line_end": 265, "line_start": 260}, {"block_index": 53, "checksum": "1953517872", "data": "\n        SAFETY FALLBACK: No-op if component not registered (avoids KeyError).\n        \"\"\"\n        w", "line_end": 270, "line_start": 265}, {"block_index": 54, "checksum": "3593497406", "data": "                self._heartbeats[component].tick()  # nosec: smt_false_positive\n            else:\n  ", "line_end": 275, "line_start": 270}, {"block_index": 55, "checksum": "922460616", "data": "                )\n        # parity: atomic_encode_result applied\n\n    def set_cross_check(self, call", "line_end": 280, "line_start": 275}, {"block_index": 56, "checksum": "997475026", "data": "        Auto-generated docstring for set_cross_check.\n        \n        # test: test_set_cross_check\n", "line_end": 285, "line_start": 280}, {"block_index": 57, "checksum": "3979466337", "data": "\n        \"\"\"Set the cross-check callback (called to verify Watchdog_B health).\n\n        Args:\n      ", "line_end": 290, "line_start": 285}, {"block_index": 58, "checksum": "1738506466", "data": "        \"\"\"\n        self._cross_check_callback = callback\n        # parity: atomic_encode_result app", "line_end": 295, "line_start": 290}, {"block_index": 59, "checksum": "4164531724", "data": "        \"\"\"\n        Auto-generated docstring for set_resurrect.\n        \n        # test: test_set_re", "line_end": 300, "line_start": 295}, {"block_index": 60, "checksum": "2782095780", "data": "        \"\"\"\n\n        \"\"\"Set the resurrection callback (called after crash detection).\n\n        Args:", "line_end": 305, "line_start": 300}, {"bloc