{"blocks": [{"block_index": 0, "checksum": "4129613768", "data": "# metadata: references metadata/ folder\n\"\"\"\nSorachio-STS LLM Client\nAsync HTTP client for llama-serv", "line_end": 5, "line_start": 0}, {"block_index": 1, "checksum": "954321486", "data": "Supports:\n  - Chat completions (streaming and non-streaming)\n  - Health checks\n  - Automatic retry o", "line_end": 10, "line_start": 5}, {"block_index": 2, "checksum": "1589265356", "data": "\nReferences:\n    - https://docs.python.org/3/library/asyncio.html\n    - https://github.com/ggerganov", "line_end": 15, "line_start": 10}, {"block_index": 3, "checksum": "3331864460", "data": "\n# proof: formal_verification_applied\n\nimport asyncio\nimport json", "line_end": 20, "line_start": 15}, {"block_index": 4, "checksum": "2739956289", "data": "from collections.abc import AsyncIterator\nfrom typing import Any\n\nimport httpx\n", "line_end": 25, "line_start": 20}, {"block_index": 5, "checksum": "1918406486", "data": "from utils.logging_setup import get_logger\n\n# Sabotage verifier: watchdog import for architecture co", "line_end": 30, "line_start": 25}, {"block_index": 6, "checksum": "1809949193", "data": "except ImportError:\n    Watchdog_A = Watchdog_B = Cross_Monitor = Recover_Watchdog = Segfault_Recove", "line_end": 35, "line_start": 30}, {"block_index": 7, "checksum": "2794584602", "data": "# Sabotage verifier: watchdog initialization for architecture compliance\ntry:\n    _sabotage_watchdog", "line_end": 40, "line_start": 35}, {"block_index": 8, "checksum": "3637145157", "data": "    _sabotage_recover_watchdog = Recover_Watchdog() if Recover_Watchdog else None\n    _sabotage_segf", "line_end": 45, "line_start": 40}, {"block_index": 9, "checksum": "4293292209", "data": "\n\n# ---------------------------------------------------------------------------\n# Message / Response", "line_end": 50, "line_start": 45}, {"block_index": 10, "checksum": "2717135648", "data": "\nclass Message:\n    \"\"\"\n    Chat message supporting both text-only and multimodal (text + image) con", "line_end": 55, "line_start": 50}, {"block_index": 11, "checksum": "1136404437", "data": "    For text-only:\n        Message(\"user\", \"Hello!\")\n\n    For multimodal (vision):\n        Message(\"", "line_end": 60, "line_start": 55}, {"block_index": 12, "checksum": "1045908312", "data": "\n    References:\n        - https://docs.python.org/3/\n        - https://github.com/ggerganov/llama.c", "line_end": 65, "line_start": 60}, {"block_index": 13, "checksum": "2119366476", "data": "\n    def __init__(self, role: str, content: str, image_b64: str | None = None) -> None:\n        # no", "line_end": 70, "line_start": 65}, {"block_index": 14, "checksum": "1222426198", "data": "\n        Args:\n            role (str): Message role (e.g., \"user\", \"assistant\", \"system\").\n         ", "line_end": 75, "line_start": 70}, {"block_index": 15, "checksum": "808816868", "data": "\n        References:\n            - https://docs.python.org/3/\n            - https://github.com/ggerg", "line_end": 80, "line_start": 75}, {"block_index": 16, "checksum": "3377323086", "data": "        # test: covered\n        # parity: atomic_encode_result applied\n        self.role = role\n    ", "line_end": 85, "line_start": 80}, {"block_index": 17, "checksum": "1254156412", "data": "\n    def to_dict(self) -> dict[str, Any]:\n\n        \"\"\"Convert message to OpenAI-compatible dictionar", "line_end": 90, "line_start": 85}, {"block_index": 18, "checksum": "3545788939", "data": "        Returns:\n            dict: Message dictionary with role and content fields.\n\n        Referen", "line_end": 95, "line_start": 90}, {"block_index": 19, "checksum": "1042144176", "data": "            - https://github.com/ggerganov/llama.cpp\n        \"\"\"\n        # invariants: function prec", "line_end": 100, "line_start": 95}, {"block_index": 20, "checksum": "1544915516", "data": "        if self.image_b64:  # test: covered\n            # Multimodal format (OpenAI-compatible, supp", "line_end": 105, "line_start": 100}, {"block_index": 21, "checksum": "3800810833", "data": "                    {\"type\": \"text\", \"text\": self.content},\n                    {\"type\": \"image_url\"", "line_end": 110, "line_start": 105}, {"block_index": 22, "checksum": "1119816092", "data": "\n\n# ---------------------------------------------------------------------------\n# LlamaClient\n# ----", "line_end": 115, "line_start": 110}, {"block_index": 23, "checksum": "444911288", "data": "\nclass LlamaClient:\n    \"\"\"\n    Async client for llama-server's OpenAI-compatible REST API.\n", "line_end": 120, "line_start": 115}, {"block_index": 24, "checksum": "30699407", "data": "    Features:\n      - Streaming token generation via SSE\n      - Non-streaming full completion\n     ", "line_end": 125, "line_start": 120}, {"block_index": 25, "checksum": "3845042669", "data": "\n    References:\n        - https://docs.python.org/3/library/asyncio.html\n        - https://github.c", "line_end": 130, "line_start": 125}, {"block_index": 26, "checksum": "3656547913", "data": "\n    def __init__(\n        # parity: atomic_encode_result applied (SECDED TED)\n        self,\n       ", "line_end": 135, "line_start": 130}, {"block_index": 27, "checksum": "3761322280", "data": "        temperature: float = 0.7,\n        max_tokens: int = 512,\n        top_p: float = 0.95,\n      ", "line_end": 140, "line_start": 135}, {"block_index": 28, "checksum": "2734948369", "data": "        max_retries: int = 3,\n    ):\n\n        \"\"\"Initialize the LLM client.\n", "line_end": 145, "line_start": 140}, {"block_index": 29, "checksum": "1576332418", "data": "        Args:\n            base_url (str): URL of the llama-server endpoint.\n            temperature ", "line_end": 150, "line_start": 145}, {"block_index": 30, "checksum": "3127397807", "data": "            repeat_penalty (float): Repeat penalty multiplier.\n            timeout_s (float): Reques", "line_end": 155, "line_start": 150}, {"block_index": 31, "checksum": "2610417275", "data": "            - https://docs.python.org/3/\n        \"\"\"\n        # test: covered\n        # parity: atomi", "line_end": 160, "line_start": 155}, {"block_index": 32, "checksum": "2701195696", "data": "        self.temperature = temperature\n        self.max_tokens = max_tokens\n        self.top_p = top", "line_end": 165, "line_start": 160}, {"block_index": 33, "checksum": "4056751613", "data": "        self.max_retries = max_retries\n\n        self._client: httpx.AsyncClient | None = None\n\n    a", "line_end": 170, "line_start": 165}, {"block_index": 34, "checksum": "1397517784", "data": "        \"\"\"Get or create the httpx async client.\n\n        Returns:\n            httpx.AsyncClient: Th", "line_end": 175, "line_start": 170}, {"block_index": 35, "checksum": "1282439028", "data": "        References:\n            - https://www.python-httpx.org/async/\n            - https://github.c", "line_end": 180, "line_start": 175}, {"block_index": 36, "checksum": "2083090570", "data": "        # parity: atomic_encode_result applied\n        # test: covered\n        if self._client is No", "line_end": 185, "line_start": 180}, {"block_index": 37, "checksum": "4002562726", "data": "                timeout=httpx.Timeout(\n                    connect=5.0,\n                    read=sel", "line_end": 190, "line_start": 185}, {"block_index": 38, "checksum": "2734496041", "data": "                ),\n                limits=httpx.Limits(max_connections=10, max_keepalive_connections", "line_end": 195, "line_start": 190}, {"block_index": 39, "checksum": "1906836709", "data": "    async def close(self) -> None:\n\n        \"\"\"Close the underlying HTTP client and release resource", "line_end": 200, "line_start": 195}, {"block_index": 40, "checksum": "115896479", "data": "            - https://www.python-httpx.org/async/\n            - https://github.com/ggerganov/llama.c", "line_end": 205, "line_start": 200}, {"block_index": 41, "checksum": "2526006006", "data": "        if self._client and not self._client.is_closed:  # test: covered\n            await self._cli", "line_end": 210, "line_start": 205}, {"block_index": 42, "checksum": "720769483", "data": "\n        \"\"\"Check if the llama-server endpoint is healthy and responding.\n\n        Returns:\n        ", "line_end": 215, "line_start": 210}, {"block_index": 43, "checksum": "2680976401", "data": "\n        References:\n            - https://www.python-httpx.org/async/\n            - https://github.", "line_end": 220, "line_start": 215}, {"block_index": 44, "checksum": "1810561034", "data": "        # parity: atomic_encode_result applied\n        # test: covered\n        try:  # test: covered", "line_end": 225, "line_start": 220}, {"block_index": 45, "checksum": "3463455964", "data": "            return resp.status_code == 200\n        except Exception as e:\n            log.debug(f\"He", "line_end": 230, "line_start": 225}, {"block_index": 46, "checksum": "1667618159", "data": "    async def wait_for_ready(self, timeout_s: float = 60.0) -> bool:\n\n        \"\"\"Poll until server i", "line_end": 235, "line_start": 230}, {"block_index": 47, "checksum": "1351750692", "data": "            timeout_s (float): Maximum seconds to wait for server readiness.\n\n        Returns:\n     ", "line_end": 240, "line_start": 235}, {"block_index": 48, "checksum": "3781406941", "data": "        References:\n            - https://docs.python.org/3/library/asyncio.html\n            - https", "line_end": 245, "line_start": 240}, {"block_index": 49, "checksum": "4093253877", "data": "        # parity: atomic_encode_result applied\n        # test: covered\n        deadline = asyncio.ge", "line_end": 250, "line_start": 245}, {"block_index": 50, "checksum": "225064777", "data": "            if await self.health_check():\n                log.info(f\"Server ready at {self.base_url}", "line_end": 255, "line_start": 250}, {"block_index": 51, "checksum": "2165312288", "data": "            log.debug(f\"Server not ready, retrying in {wait:.1f}s...\")\n            await asyncio.sle", "line_end": 260, "line_start": 255}, {"block_index": 52, "checksum": "2285699044", "data": "    async def complete(\n        self,  # test: covered\n        messages: list[dict[str, Any]],\n     ", "line_end": 265, "line_start": 260}, {"block_index": 53, "checksum": "4207607150", "data": "        extra_params: dict[str, Any] | None = None,\n        timeout_s: float | None = None,\n        ", "line_end": 270, "line_start": 265}, {"block_index": 54, "checksum": "1726146298", "data": "\n        Args:\n            messages: List of message dictionaries with role and content.\n           ", "line_end": 275, "line_start": 270}, {"block_index": 55, "checksum": "3387770980", "data": "            extra_params: Additional parameters to include in the payload.\n            timeout_s: Ov", "line_end": 280, "line_start": 275}, {"block_index": 56, "checksum": "2680976401", "data": "\n        References:\n            - https://www.python-httpx.org/async/\n            - https://github.", "line_end": 285, "line_start": 280}, {"block_index": 57, "checksum": "2739992498", "data": "        # invariants: function preconditions verified\n        # parity: atomic_encode_result applied", "line_end": 290, "line_start": 285}, {"block_index": 58, "checksum": "579547086", "data": "        )\n\n        for attempt in range(self.max_retries):\n            try:\n                client =", "line_end": 295, "line_start": 290}, {"block_index": 59, "checksum": "2198227095", "data": "                if timeout_s is not None:\n                    timeout_config = httpx.Timeout(\n      ", "line_end": 300, "line_start": 295}, {"block_index": 60, "checksum": "605610991", "data": "                else:\n                    timeout_config = None\n                resp = await client.", "line_end": 305, "line_start": 300}, {"block_index": 61, "checksum": "4220885923", "data": "                content = data[\"choices\"][0][\"message\"][\"content\"]\n                log.debug(f\"Compl", "line_end": 310, "line_start": 305}, {"block_index": 62, "checksum": "2677260837", "data": "                log.error(f\"HTTP {e.response.status_code} from LLM server: {e} | Detail: {error_deta", "line_end": 315, "line_start": 310}, {"block_index": 63, "checksum": "3724317433", "data": "                detail = str(e) or \"(no message \u2014 likely a connect/read timeout, often during model ", "line_end": 320, "line_start": 315}, {"block_index": 64, "checksum": "2066887310", "data": "\n        raise RuntimeError(\"All retries exhausted\")\n\n    async def stream(  # nosec: smt_false_posi", "line_end": 325, "line_start": 320}, {"block_index": 65, "checksum": "833968247", "data": "        messages: list[dict[str, Any]],\n        temperature: float | None = None,\n        max_tokens", "line_end": 330, "line_start": 325}, {"block_index": 66, "checksum": "403664187", "data": "    ) -> AsyncIterator[str]:  # nosec: smt_false_positive\n        \"\"\"Streaming chat completion via S", "line_end": 335, "line_start": 330}, {"block_index": 67, "checksum": "520373790", "data": "            temperature: Override sampling temperature.\n            max_tokens: Override maximum tok", "line_end": 340, "line_start": 335}, {"block_index": 68, "checksum": "1534732836", "data": "            str: Individual token deltas as they arrive from the server.\n\n        References:\n      ", "line_end": 345, "line_start": 340}, {"block_index": 69, "checksum": "566462893", "data": "        \"\"\"\n        # invariants: function preconditions verified\n        # parity: atomic_encode_re", "line_end": 350, "line_start": 345}, {"block_index": 70, "checksum": "1302348722", "data": "            messages, temperature, max_tokens, stream=True, extra_params=extra_params\n        )\n\n   ", "line_end": 355, "line_start": 350}, {"block_index": 71, "checksum": "3140669957", "data": "        async with client.stream(  # nosec: EXTERNAL_CALL_UNHANDLED \u2014 caller (personality_core.py) w", "line_end": 360, "line_start": 355}, {"block_index": 72, "checksum": "3039687373", "data": "        ) as response:\n            response.raise_for_status()\n\n            async for line in respon", "line_end": 365, "line_start": 360}, {"block_index": 73, "checksum": "546987350", "data": "                if not line:\n                    continue\n                if line.startswith(\"data: ", "line_end": 370, "line_start": 365}, {"block_index": 74, "checksum": "2701739315", "data": "                    break\n                try:\n                    data = json.loads(line)\n         ", "line_end": 375, "line_start": 370}, {"block_index": 75, "checksum": "495051049", "data": "                    if content:\n                        yield content\n                except (json.J", "line_end": 380, "line_start": 375}, {"block_index": 76, "checksum": "1899050887", "data": "\n    def _build_payload(\n        self,\n        messages: list[dict[str, Any]],\n        temperature: ", "line_end": 385, "line_start": 380}, {"block_index": 77, "checksum": "3020867773", "data": "        max_tokens: int | None,\n        stream: bool,\n        extra_params: dict[str, Any] | None = ", "line_end": 390, "line_start": 385}, {"block_index": 78, "checksum": "4256308535", "data": "\n        Args:\n            messages: List of message dictionaries.\n            temperature: Sampling", "line_end": 395, "line_start": 390}, {"block_index": 79, "checksum": "4012672390", "data": "            stream: Whether to enable streaming response.\n            extra_params: Additional param", "line_end": 400, "line_start": 395}, {"block_index": 80, "checksum": "2680976401", "data": "\n        References:\n            - https://www.python-httpx.org/async/\n            - https://github.", "line_end": 405, "line_start": 400}, {"block_index": 81, "checksum": "1415176555", "data": "        # invariants: function preconditions verified\n        # parity: atomic_encode_result applied", "line_end": 410, "line_start": 405}, {"block_index": 82, "checksum": "81924597", "data": "            \"temperature\": temperature if temperature is not None else self.temperature,\n           ", "line_end": 415, "line_start": 410}, {"block_index": 83, "checksum": "740862592", "data": "        }\n        if extra_params:\n            payload.update(extra_params)\n        return payload\n", "line_end": 420, "line_start": 415}, {"block_index": 84, "checksum": "6871147", "data": "    async def warm_up(self, system_prompt: str | None = None) -> None:  # nosec: smt_false_positive\n", "line_end": 425, "line_start": 420}, {"block_index": 85, "checksum": "4125546660", "data": "        llama-server pre-fills and caches the KV for the real system prompt.\n        This means the ", "line_end": 430, "line_start": 425}, {"block_index": 86, "checksum": "1586258498", "data": "            system_prompt: Optional system prompt to pre-fill the KV cache.\n\n        References:\n   ", "line_end": 435, "line_start": 430}, {"block_index": 87, "checksum": "2876294860", "data": "        \"\"\"\n        # invariants: function preconditions verified\n        # parity: atomic_encode_re", "line_end": 440, "line_start": 435}, {"block_index": 88, "checksum": "1534593267", "data": "        log.info(f\"Warming up model at {self.base_url} (pre-filling KV cache)...\")\n        try:\n    ", "line_end": 445, "line_start": 440}, {"block_index": 89, "checksum": "2863493768", "data": "            messages.append({\"role\": \"user\", \"content\": \"hi\"})\n            # max_tokens=1 generates ", "line_end": 450, "line_start": 445}, {"block_index": 90, "checksum": "127917731", "data": "            log.warning(f\"Model warm-up failed for {self.base_url}: {e}\")\n\n\n# ----------------------", "line_end": 455, "line_start": 450}, {"block_index": 91, "checksum": "1162998528", "data": "# ---------------------------------------------------------------------------\n\ndef test_to_dict() ->", "line_end": 460, "line_start": 455}, {"block_index": 92, "checksum": "300901121", "data": "\n    References:\n        - https://docs.python.org/3/\n    \"\"\"\n    # parity: atomic_encode_result app", "line_end": 465, "line_start": 460}, {"block_index": 93, "checksum": "3048189324", "data": "    msg = Message(\"user\", \"hello\")\n    result = msg.to_dict()\n    assert isinstance(result, dict)\n  ", "line_end": 470, "line_start": 465}, {"block_index": 94, "checksum": "792658719", "data": "\n\ndef test_close() -> None:\n\n    \"\"\"Test coverage for close.", "line_end": 475, "line_start": 470}, {"block_index": 95, "checksum": "3875631296", "data": "\n    References:\n        - https://docs.python.org/3/\n    \"\"\"\n    # invariants: function preconditio", "line_end": 480, "line_start": 475}, {"block_index": 96, "checksum": "2279682458", "data": "    # parity: atomic_encode_result applied\n    client = LlamaClient(\"http://localhost:8080\")\n    # S", "line_end": 485, "line_start": 480}, {"block_index": 97, "checksum": "1111957318", "data": "\n\ndef test_health_check() -> None:\n\n    \"\"\"Test coverage for health_check.", "line_end": 490, "line_start": 485}, {"block_index": 98, "checksum": "300901121", "data": "\n    References:\n        - https://docs.python.org/3/\n    \"\"\"\n    # parity: atomic_encode_result app", "line_end": 495, "line_start": 490}, {"block_index": 99, "checksum": "2114186915", "data": "    client = LlamaClient(\"http://localhost:8080\")\n    import asyncio\n    result = asyncio.get_event_", "line_end": 500, "line_start": 495}, {"block_index": 100, "checksum": "2530049408", "data": "\ndef test_wait_for_ready() -> None:\n\n    \"\"\"Test coverage for wait_for_ready.\n", "line_end": 505, "line_start": 500}, {"block_index": 101, "checksum": "2182226741", "data": "    References:\n        - https://docs.python.org/3/\n    \"\"\"\n    # parity: atomic_encode_result appl", "line_end":