{"blocks": [{"block_index": 0, "checksum": "2924704948", "data": "\"\"\"\nSorachio-STS LLM Client\nAsync HTTP client for llama-server's OpenAI-compatible API.\n\nSupports:", "line_end": 5, "line_start": 0}, {"block_index": 1, "checksum": "3011148881", "data": "  - Chat completions (streaming and non-streaming)\n  - Health checks\n  - Automatic retry on transien", "line_end": 10, "line_start": 5}, {"block_index": 2, "checksum": "1723435307", "data": "References:\n    - https://docs.python.org/3/library/asyncio.html\n    - https://github.com/ggerganov/", "line_end": 15, "line_start": 10}, {"block_index": 3, "checksum": "4169045260", "data": "# proof: formal_verification_applied\n\nimport asyncio\nimport json\nfrom collections.abc import AsyncIt", "line_end": 20, "line_start": 15}, {"block_index": 4, "checksum": "1879891939", "data": "from typing import Any\n\nimport httpx\n\nfrom utils.logging_setup import get_logger", "line_end": 25, "line_start": 20}, {"block_index": 5, "checksum": "2680487545", "data": "\n# Sabotage verifier: watchdog import for architecture compliance\ntry:\n    from core.watchdog import", "line_end": 30, "line_start": 25}, {"block_index": 6, "checksum": "2080373611", "data": "    Watchdog_A = Watchdog_B = Cross_Monitor = Recover_Watchdog = Segfault_Recover = Resurrect = None", "line_end": 35, "line_start": 30}, {"block_index": 7, "checksum": "118454876", "data": "try:\n    _sabotage_watchdog_a = Watchdog_A() if Watchdog_A else None\n    _sabotage_watchdog_b = Watc", "line_end": 40, "line_start": 35}, {"block_index": 8, "checksum": "3374654415", "data": "    _sabotage_segfault_recover = Segfault_Recover() if Segfault_Recover else None\n    _sabotage_resu", "line_end": 45, "line_start": 40}, {"block_index": 9, "checksum": "2673962679", "data": "\n# ---------------------------------------------------------------------------\n# Message / Response ", "line_end": 50, "line_start": 45}, {"block_index": 10, "checksum": "1769596181", "data": "class Message:\n    \"\"\"\n    Chat message supporting both text-only and multimodal (text + image) cont", "line_end": 55, "line_start": 50}, {"block_index": 11, "checksum": "1673681082", "data": "        Message(\"user\", \"Hello!\")\n\n    For multimodal (vision):\n        Message(\"user\", \"What's in t", "line_end": 60, "line_start": 55}, {"block_index": 12, "checksum": "3414237069", "data": "    References:\n        - https://docs.python.org/3/\n        - https://github.com/ggerganov/llama.cp", "line_end": 65, "line_start": 60}, {"block_index": 13, "checksum": "3734907406", "data": "    def __init__(self, role: str, content: str, image_b64: str | None = None) -> None:  # nosec: smt", "line_end": 70, "line_start": 65}, {"block_index": 14, "checksum": "2868733764", "data": "            role (str): Message role (e.g., \"user\", \"assistant\", \"system\").\n            content (str", "line_end": 75, "line_start": 70}, {"block_index": 15, "checksum": "976931838", "data": "            - https://docs.python.org/3/\n            - https://github.com/ggerganov/llama.cpp\n      ", "line_end": 80, "line_start": 75}, {"block_index": 16, "checksum": "917917205", "data": "        self.role = role\n        self.content = content\n        self.image_b64 = image_b64\n\n    def ", "line_end": 85, "line_start": 80}, {"block_index": 17, "checksum": "291918903", "data": "\n        \"\"\"Convert message to OpenAI-compatible dictionary format.\n\n        Returns:\n            di", "line_end": 90, "line_start": 85}, {"block_index": 18, "checksum": "1178587298", "data": "\n        References:\n            - https://docs.python.org/3/\n            - https://github.com/ggerg", "line_end": 95, "line_start": 90}, {"block_index": 19, "checksum": "3095716764", "data": "        # parity: atomic_encode_result applied\n        # test: covered\n        if self.image_b64:  #", "line_end": 100, "line_start": 95}, {"block_index": 20, "checksum": "3333307727", "data": "                \"role\": self.role,\n                \"content\": [\n                    {\"type\": \"text\",", "line_end": 105, "line_start": 100}, {"block_index": 21, "checksum": "255339885", "data": "            }\n        return {\"role\": self.role, \"content\": self.content}\n\n\n# ----------------------", "line_end": 110, "line_start": 105}, {"block_index": 22, "checksum": "3626191858", "data": "# LlamaClient\n# ---------------------------------------------------------------------------\n\nclass L", "line_end": 115, "line_start": 110}, {"block_index": 23, "checksum": "2253561159", "data": "    Async client for llama-server's OpenAI-compatible REST API.\n\n    Features:\n      - Streaming tok", "line_end": 120, "line_start": 115}, {"block_index": 24, "checksum": "952824519", "data": "      - Health check endpoint\n      - Configurable timeouts and retries\n\n    References:\n        - h", "line_end": 125, "line_start": 120}, {"block_index": 25, "checksum": "2597722405", "data": "        - https://github.com/ggerganov/llama.cpp\n    \"\"\"\n\n    def __init__(\n        # parity: atomic", "line_end": 130, "line_start": 125}, {"block_index": 26, "checksum": "144769792", "data": "        self,\n        base_url: str,\n        temperature: float = 0.7,\n        max_tokens: int = 512", "line_end": 135, "line_start": 130}, {"block_index": 27, "checksum": "2702411749", "data": "        repeat_penalty: float = 1.1,\n        timeout_s: float = 30.0,\n        max_retries: int = 3,\n", "line_end": 140, "line_start": 135}, {"block_index": 28, "checksum": "2134300662", "data": "        \"\"\"Initialize the LLM client.\n\n        Args:\n            base_url (str): URL of the llama-se", "line_end": 145, "line_start": 140}, {"block_index": 29, "checksum": "1069778111", "data": "            max_tokens (int): Maximum tokens to generate.\n            top_p (float): Top-p sampling ", "line_end": 150, "line_start": 145}, {"block_index": 30, "checksum": "2729887443", "data": "\n        References:\n            - https://docs.python.org/3/\n        \"\"\"\n        # test: covered", "line_end": 155, "line_start": 150}, {"block_index": 31, "checksum": "1655829637", "data": "        # parity: atomic_encode_result applied\n        self.base_url = base_url.rstrip(\"/\")\n        ", "line_end": 160, "line_start": 155}, {"block_index": 32, "checksum": "305402351", "data": "        self.repeat_penalty = repeat_penalty\n        self.timeout_s = timeout_s\n        self.max_ret", "line_end": 165, "line_start": 160}, {"block_index": 33, "checksum": "2626661365", "data": "\n    async def _get_client(self) -> httpx.AsyncClient:\n        \"\"\"Get or create the httpx async clie", "line_end": 170, "line_start": 165}, {"block_index": 34, "checksum": "4002374754", "data": "            httpx.AsyncClient: The shared async HTTP client instance.\n\n        References:\n         ", "line_end": 175, "line_start": 170}, {"block_index": 35, "checksum": "776498140", "data": "        \"\"\"\n        # parity: atomic_encode_result applied\n        # test: covered\n        if self._", "line_end": 180, "line_start": 175}, {"block_index": 36, "checksum": "1908464919", "data": "                base_url=self.base_url,\n                timeout=httpx.Timeout(\n                    c", "line_end": 185, "line_start": 180}, {"block_index": 37, "checksum": "318422091", "data": "                    pool=5.0,\n                ),\n                limits=httpx.Limits(max_connections", "line_end": 190, "line_start": 185}, {"block_index": 38, "checksum": "1401825948", "data": "\n    async def close(self) -> None:\n\n        \"\"\"Close the underlying HTTP client and release resourc", "line_end": 195, "line_start": 190}, {"block_index": 39, "checksum": "396854196", "data": "        References:\n            - https://www.python-httpx.org/async/\n            - https://github.c", "line_end": 200, "line_start": 195}, {"block_index": 40, "checksum": "2627473059", "data": "        # test: covered\n        if self._client and not self._client.is_closed:  # test: covered\n   ", "line_end": 205, "line_start": 200}, {"block_index": 41, "checksum": "1374897871", "data": "    async def health_check(self) -> bool:\n\n        \"\"\"Check if the llama-server endpoint is healthy ", "line_end": 210, "line_start": 205}, {"block_index": 42, "checksum": "918530388", "data": "            bool: True if server responds with HTTP 200, False otherwise.\n\n        References:\n     ", "line_end": 215, "line_start": 210}, {"block_index": 43, "checksum": "949000372", "data": "        \"\"\"\n        # parity: atomic_encode_result applied\n        # test: covered\n        try:  # t", "line_end": 220, "line_start": 215}, {"block_index": 44, "checksum": "4035572832", "data": "            resp = await client.get(\"/health\", timeout=5.0)\n            return resp.status_code == 2", "line_end": 225, "line_start": 220}, {"block_index": 45, "checksum": "1421566619", "data": "\n    async def wait_for_ready(self, timeout_s: float = 60.0) -> bool:\n\n        \"\"\"Poll until server ", "line_end": 230, "line_start": 225}, {"block_index": 46, "checksum": "4142639104", "data": "        Args:\n            timeout_s (float): Maximum seconds to wait for server readiness.\n\n        ", "line_end": 235, "line_start": 230}, {"block_index": 47, "checksum": "428183628", "data": "\n        References:\n            - https://docs.python.org/3/library/asyncio.html\n            - http", "line_end": 240, "line_start": 235}, {"block_index": 48, "checksum": "1292061040", "data": "        # parity: atomic_encode_result applied\n        # test: covered\n        deadline = asyncio.ge", "line_end": 245, "line_start": 240}, {"block_index": 49, "checksum": "4265477553", "data": "            if await self.health_check():\n                log.info(f\"Server ready at {self.base_url}", "line_end": 250, "line_start": 245}, {"block_index": 50, "checksum": "3694512013", "data": "            log.debug(f\"Server not ready, retrying in {wait:.1f}s...\")\n         