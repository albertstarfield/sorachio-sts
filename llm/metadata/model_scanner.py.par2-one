{"block_size": 512, "blocks": [{"block_index": 0, "crc32": "4012022878", "data": "\"\"\"\nSorachio-STS Model Scanner\nAuto-detects GGUF model files and multimodal projectors in model dire", "line_end": 17, "line_start": 0}, {"block_index": 1, "crc32": "2963454832", "data": "logger\n\nlog = get_logger(\"llm.model_scanner\")\n\n\n# --------------------------------------------------", "line_end": 35, "line_start": 17}, {"block_index": 2, "crc32": "544902794", "data": "ult_factory=list)\n\n\n# ---------------------------------------------------------------------------\n# ", "line_end": 56, "line_start": 35}, {"block_index": 3, "crc32": "4335128", "data": "      1. List all *.gguf files in the directory\n      2. Files containing 'mmproj' in the name \u2192 vis", "line_end": 70, "line_start": 56}, {"block_index": 4, "crc32": "3293557", "data": " protection (ISO/IEC 25010)]\n    model_dir = Path(model_dir)\n    info = ModelInfo()\n\n    if not mode", "line_end": 87, "line_start": 70}, {"block_index": 5, "crc32": "1719660275", "data": "ning(f\"[Scanner] No .gguf files found in {model_dir}\")\n        return info\n\n    log.debug(f\"[Scanner", "line_end": 103, "line_start": 87}, {"block_index": 6, "crc32": "2503345462", "data": "t vision projector (pick largest mmproj if multiple)\n    if mmproj_files:\n        info.mmproj_path =", "line_end": 115, "line_start": 103}, {"block_index": 7, "crc32": "3477686632", "data": "      info.file_size_mb = info.model_path.stat().st_size / 1024 / 1024\n        info.model_name = _ex", "line_end": 131, "line_start": 115}, {"block_index": 8, "crc32": "2281181278", "data": "extract_model_name(filename: str) -> str:\n    \"\"\"\n    Extract a human-readable model name from the G", "line_end": 146, "line_start": 131}, {"block_index": 9, "crc32": "747426468", "data": "  # Common quantization suffixes to strip\n    quant_patterns = [\n        \"-Q8_0\", \"-Q6_K\", \"-Q5_K_M\"", "line_end": 160, "line_start": 146}, {"block_index": 10, "crc32": "3