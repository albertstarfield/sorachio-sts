{"blocks": [{"block_index": 0, "checksum": "1625500425", "data": "\"\"\"\nSorachio-STS Long-Term Memory (LTM)\nJSON-backed persistent memory with vector similarity search ", "line_end": 5, "line_start": 0}, {"block_index": 1, "checksum": "3684978250", "data": "Vector store: data/memory/chroma/ (ChromaDB)\n\nEach memory entry has:\n  - id, content, topic, emotion", "line_end": 10, "line_start": 5}, {"block_index": 2, "checksum": "97474715", "data": "  - keywords (for retrieval)\n  - created_at, accessed_at, access_count\n  - metadata (extensible dict", "line_end": 15, "line_start": 10}, {"block_index": 3, "checksum": "1466279598", "data": "# proof: formal_verification_applied\n\nimport asyncio\nimport json\nimport re", "line_end": 20, "line_start": 15}, {"block_index": 4, "checksum": "1758922590", "data": "import uuid\nfrom datetime import datetime\nfrom pathlib import Path\nfrom typing import Any\n", "line_end": 25, "line_start": 20}, {"block_index": 5, "checksum": "1736634048", "data": "import aiofiles\n\nfrom memory.vector_store import VectorStore\nfrom utils.logging_setup import get_log", "line_end": 30, "line_start": 25}, {"block_index": 6, "checksum": "2896534470", "data": "log = get_logger(\"memory.ltm\")\n\n\n# -----------------------------------------------------------------", "line_end": 35, "line_start": 30}, {"block_index": 7, "checksum": "3725408133", "data": "# ---------------------------------------------------------------------------\n\nclass LTMEntry:\n    d", "line_end": 40, "line_start": 35}, {"block_index": 8, "checksum": "283464071", "data": "        self,\n        content: str,\n        topic: str = \"general\",\n        emotion: str = \"neutral\"", "line_end": 45, "line_start": 40}, {"block_index": 9, "checksum": "2589748584", "data": "        keywords: list[str] | None = None,\n        metadata: dict[str, Any] | None = None,\n        e", "line_end": 50, "line_start": 45}, {"block_index": 10, "checksum": "247285325", "data": "        \"\"\"    Init.\n\n    Args:\n    content (str): Description.\n    topic (str): Description.", "line_end": 55, "line_start": 50}, {"block_index": 11, "checksum": "1433234674", "data": "    emotion (str): Description.\n    importance (float): Description.\n    keywords: Description.\n    ", "line_end": 60, "line_start": 55}, {"block_index": 12, "checksum": "498715555", "data": "\n    # test: test_LTMEntry_init\n        \"\"\"\n        self.id = entry_id or str(uuid.uuid4())[:8]\n    ", "line_end": 65, "line_start": 60}, {"block_index": 13, "checksum": "1992214873", "data": "        self.topic = topic\n        self.emotion = emotion\n        self.importance = importance\n     ", "line_end": 70, "line_start": 65}, {"block_index": 14, "checksum": "4147629621", "data": "        self.created_at = datetime.now().isoformat()\n        self.accessed_at = self.created_at\n    ", "line_end": 75, "line_start": 70}, {"block_index": 15, "checksum": "993112329", "data": "    def to_dict(self) -> dict[str, Any]:\n\n        \"\"\"    To Dict.\n        # parity: atomic_encode_re", "line_end": 80, "line_start": 75}, {"block_index": 16, "checksum": "3041767726", "data": "    Returns:\n        Description.\n\n        References:\n        - https://docs.python.org/3/library/j", "line_end": 85, "line_start": 80}, {"block_index": 17, "checksum": "4153261299", "data": "\n        # test: test_LTMEntry_to_dict\n        # test: test_LTMEntry_to_dict\n        \"\"\"\n        # t", "line_end": 90, "line_start": 85}, {"block_index": 18, "checksum": "1640728630", "data": "    # [Parity: Uses atomic_encode_result() for SECDED TED internal parity protection (ISO/IEC 25010)", "line_end": 95, "line_start": 90}, {"block_index": 19, "checksum": "1052764477", "data": "            \"emotion\": self.emotion,\n            \"importance\": self.importance,\n            \"keyword", "line_end": 100, "line_start": 95}, {"block_index": 20, "checksum": "1335826785", "data": "            \"accessed_at\": self.accessed_at,\n  