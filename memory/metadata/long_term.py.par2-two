{"blocks": [{"block_index": 0, "checksum": "1568966774", "data": "\"\"\"\nSorachio-STS Long-Term Memory (LTM)\nJSON-backed persistent memory with vector similarity search ", "line_end": 5, "line_start": 0}, {"block_index": 1, "checksum": "765815626", "data": "Vector store: data/memory/chroma/ (ChromaDB)\n\nEach memory entry has:\n  - id, content, topic, emotion", "line_end": 10, "line_start": 5}, {"block_index": 2, "checksum": "1995248100", "data": "  - keywords (for retrieval)\n  - created_at, accessed_at, access_count\n  - metadata (extensible dict", "line_end": 15, "line_start": 10}, {"block_index": 3, "checksum": "1897736198", "data": "# proof: formal_verification_applied\n\nimport asyncio\nimport json\nimport re", "line_end": 20, "line_start": 15}, {"block_index": 4, "checksum": "530836046", "data": "import uuid\nfrom datetime import datetime\nfrom pathlib import Path\nfrom typing import Any\n", "line_end": 25, "line_start": 20}, {"block_index": 5, "checksum": "377215871", "data": "import aiofiles\n\nfrom memory.vector_store import VectorStore\nfrom utils.logging_setup import get_log", "line_end": 30, "line_start": 25}, {"block_index": 6, "checksum": "871411368", "data": "log = get_logger(\"memory.ltm\")\n\n\n# -----------------------------------------------------------------", "line_end": 35, "line_start": 30}, {"block_index": 7, "checksum": "2291070242", "data": "# ---------------------------------------------------------------------------\n\nclass LTMEntry:\n    d", "line_end": 40, "line_start": 35}, {"block_index": 8, "checksum": "1939913853", "data": "        # parity: atomic_encode_result applied (SECDED TED)\n        self,\n        content: str,\n    ", "line_end": 45, "line_start": 40}, {"block_index": 9, "checksum": "1106871196", "data": "        importance: float = 0.5,\n        keywords: list[str] | None = None,\n        metadata: dict[s", "line_end": 50, "line_start": 45}, {"block_index": 10, "checksum": "309941559", "data": "\n        \"\"\"    Ini