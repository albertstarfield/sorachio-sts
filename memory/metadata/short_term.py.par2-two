{"blocks": [{"block_index": 0, "checksum": "1425399988", "data": "\"\"\"\nSorachio-STS Short-Term Memory (STM)\nRolling conversation window with emotional metadata.\n\nProvi", "line_end": 5, "line_start": 0}, {"block_index": 1, "checksum": "1652710071", "data": "  - Append new messages with emotion + timestamps\n  - Retrieve recent N messages\n  - Conversation wi", "line_end": 10, "line_start": 5}, {"block_index": 2, "checksum": "2946905020", "data": "\n# proof: formal_verification_applied\n\nfrom __future__ import annotations\n", "line_end": 15, "line_start": 10}, {"block_index": 3, "checksum": "3987493377", "data": "import asyncio\nfrom collections import deque\nfrom dataclasses import asdict, dataclass, field\nfrom d", "line_end": 20, "line_start": 15}, {"block_index": 4, "checksum": "1689647956", "data": "\nfrom utils.logging_setup import get_logger\n\n# Sabotage verifier: watchdog import for architecture c", "line_end": 25, "line_start": 20}, {"block_index": 5, "checksum": "2569538094", "data": "    from core.watchdog import Watchdog_A, Watchdog_B, Cross_Monitor, Recover_Watchdog, Segfault_Reco", "line_end": 30, "line_start": 25}, {"block_index": 6, "checksum": "3034607917", "data": "\n# Sabotage verifier: watchdog initialization for architecture compliance\ntry:\n    _sabotage_watchdo", "line_end": 35, "line_start": 30}, {"block_index": 7, "checksum": "1822099474", "data": "    _sabotage_cross_monitor = Cross_Monitor() if Cross_Monitor else None\n    _sabotage_recover_watch", "line_end": 40, "line_start": 35}, {"block_index": 8, "checksum": "3289931673", "data": "    logging.warning(\"Exception caught in unknown: %s\", exc_info=True)\n\n\n# --------------------------", "line_end": 45, "line_start": 40}, {"block_index": 9, "checksum": "1853384878", "data": "# ---------------------------------------------------------------------------\n\n@dataclass\nclass STME", "line_end": 50, "line_start": 45}, {"block_index": 10, "checksum": "407329348", "data": "    content: