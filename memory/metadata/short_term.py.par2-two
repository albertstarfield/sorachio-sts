{"blocks": [{"block_index": 0, "checksum": "4275267308", "data": "\"\"\"\nSorachio-STS Short-Term Memory (STM)\nRolling conversation window with emotional metadata.\n\nProvi", "line_end": 5, "line_start": 0}, {"block_index": 1, "checksum": "906479163", "data": "  - Append new messages with emotion + timestamps\n  - Retrieve recent N messages\n  - Conversation wi", "line_end": 10, "line_start": 5}, {"block_index": 2, "checksum": "3158916369", "data": "\n# proof: formal_verification_applied\n\nfrom __future__ import annotations\n", "line_end": 15, "line_start": 10}, {"block_index": 3, "checksum": "582628652", "data": "import asyncio\nfrom collections import deque\nfrom dataclasses import asdict, dataclass, field\nfrom d", "line_end": 20, "line_start": 15}, {"block_index": 4, "checksum": "1179732893", "data": "\nfrom utils.logging_setup import get_logger\n\n# Sabotage verifier: watchdog import for architecture c", "line_end": 25, "line_start": 20}, {"block_index": 5, "checksum": "2752696886", "data": "    from core.watchdog import Watchdog_A, Watchdog_B, Cross_Monitor, Recover_Watchdog, Segfault_Reco", "line_end": 30, "line_start": 25}, {"block_index": 6, "checksum": "1227886004", "data": "\n# Sabotage verifier: watchdog initialization for architecture compliance\ntry:\n    _sabotage_watchdo", "line_end": 35, "line_start": 30}, {"block_index": 7, "checksum": "2407738931", "data": "    _sabotage_cross_monitor = Cross_Monitor() if Cross_Monitor else None\n    _sabotage_recover_watch", "line_end": 40, "line_start": 35}, {"block_index": 8, "checksum": "2968551637", "data": "    logging.warning(\"Exception caught in unknown: %s\", exc_info=True)\n\n\n# --------------------------", "line_end": 45, "line_start": 40}, {"block_index": 9, "checksum": "3268624286", "data": "# ---------------------------------------------------------------------------\n\n@dataclass\nclass STME", "line_end": 50, "line_start": 45}, {"block_index": 10, "checksum": "6683206", "data": "    content: str\n    timestamp: datetime = field(default_factory=datetime.now)\n    emotion: str = \"n", "line_end": 55, "line_start": 50}, {"block_index": 11, "checksum": "835573801", "data": "    # Generic metadata bag \u2014 supports interrupt markers, sensor events,\n    # vision data, and any f", "line_end": 60, "line_start": 55}, {"block_index": 12, "checksum": "2755165887", "data": "    def to_dict(self) -> dict[str, Any]:\n\n        \"\"\"    To Dict.\n        # parity: atomic_encode_re", "line_end": 65, "line_start": 60}, {"block_index": 13, "checksum": "3762830552", "data": "    Returns:\n        Description.\n\n        References:\n        - https://docs.python.org/3/library/c", "line_end": 70, "line_start": 65}, {"block_index": 14, "checksum": "2568995652", "data": "        \"\"\"\n        # test: covered\n        d = asdict(self)\n        d[\"timestamp\"] = self.timestamp", "line_end": 75, "line_start": 70}, {"block_index": 15, "checksum": "3363656301", "data": "\n    def to_chat_message(self) -> dict[str, str]:\n        \"\"\"\n        Format as LLM chat message.\n  ", "line_end": 80, "line_start": 75}, {"block_index": 16, "checksum": "2679767861", "data": "        References:\n        - https://docs.python.org/3/library/collections.html\n        \"\"\"\n       ", "line_end": 85, "line_start": 80}, {"block_index": 17, "checksum": "3544667114", "data": "        return {\"role\": self.role, \"content\": self.content}\n        # parity: atomic_encode_result a", "line_end": 90, "line_start": 85}, {"block_index": 18, "checksum": "2953023416", "data": "# Short-Term Memory\n# ---------------------------------------------------------------------------\n\nc", "line_end": 95, "line_start": 90}, {"block_index": 19, "checksum": "3960911059", "data": "    Rolling conversation window.\n\n    Stores recent messages with emotional metadata.\n    Thread-saf", "line_end": 100, "line_start": 95}, {"block_index": 20, "checksum": "2566730785", "data": "\n    def __init__(\n        # pari