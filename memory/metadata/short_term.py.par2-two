n                role=role,\n            ", "line_end": 155, "line_start": 150}, {"block_index": 31, "checksum": "3207485412", "data": "                topic=topic,\n                importance=importance,\n                metadata=metadat", "line_end": 160, "line_start": 155}, {"block_index": 32, "checksum": "1492383816", "data": "            if role == \"user\":\n                self._turn_count += 1\n            log.debug(f\"[STM] A", "line_end": 165, "line_start": 160}, {"block_index": 33, "checksum": "3048558860", "data": "        \"\"\"\n        Get the N most recent entries (or all if n=None).\n        \n        References:\n ", "line_end": 170, "line_start": 165}, {"block_index": 34, "checksum": "1561379685", "data": "        \"\"\"\n        # test: covered\n        async with self._lock:\n            entries = list(self._", "line_end": 175, "line_start": 170}, {"block_index": 35, "checksum": "937172565", "data": "                entries = entries[-n:]\n            return entries\n        # parity: atomic_encode_re", "line_end": 180, "line_start": 175}, {"block_index": 36, "checksum": "3634195561", "data": "        \"\"\"\n        Get compact context string of the last N turns for cognitive decision making.\n  ", "line_end": 185, "line_start": 180}, {"block_index": 37, "checksum": "929066904", "data": "        \"\"\"\n        # test: covered\n        async with self._lock:\n            recent = list(self._w", "line_end": 190, "line_start": 185}, {"block_index": 38, "checksum": "894727400", "data": "                return \"\"\n            formatted = []\n            for entry in recent:\n              ", "line_end": 195, "line_start": 190}, {"block_index": 39, "checksum": "2075890129", "data": "            return \" | \".join(formatted)\n        # parity: atomic_encode_result applied\n\n    async d", "line_end": 200, "line_start": 195}, {"block_index": 40, "checksum": "3861658062", "data": "        Summarize oldest n_to_summarize messages using LLM and replace them with a system summary.\n\n", "line_end": 205, "line_start": 200}, {"block_index": 41, "checksum": "1575130739", "data": "        # parity: atomic_encode_result applied (SECDED TED)\n        # invariants: function precondit", "line_end": 210, "line_start": 205}, {"block_index": 42, "checksum": "2484173781", "data": "                return None\n            to_summarize = [self._window.popleft() for _ in range(n_to_s", "line_end": 215, "line_start": 210}, {"block_index": 43, "checksum": "477330448", "data": "            {\n                \"role\": \"system\",\n                \"content\": (\n                    \"Yo", "line_end": 220, "line_start": 215}, {"block_index": 44, "checksum": "2941112935", "data": "                ),\n            },\n            {\n                \"role\": \"user\",\n                \"con", "line_end": 225, "line_start": 220}, {"block_index": 45, "checksum": "2095148102", "data": "            },\n        ]\n\n        try:\n            summary_text = await llm_client.complete(messages", "line_end": 230, "line_start": 225}, {"block_index": 46, "checksum": "1527867294", "data": "            summary_text = summary_text.strip()\n        except Exception as e:\n            log.error", "line_end": 235, "line_start": 230}, {"block_index": 47, "checksum": "1660447575", "data": "                    self._window.appendleft(entry)\n            return None\n\n        if summary_text:", "line_end": 240, "line_start": 235}, {"block_index": 48, "checksum": "2969279664", "data": "                role=\"system\",\n                content=f\"[Conversation Summary]: {summary_text}\",\n  ", "line_end": 245, "line_start": 240}, {"block_index": 49, "checksum": "2055474383", "data": "            async with self._lock:\n                self._window.appendleft(summary_entry)\n          ", "line_end": 250, "line_start": 245}, {"block_index": 50, "checksum": "2575689289", "data": "        # parity: atomic_encode_result applied\n\n    async def auto_summarize_i