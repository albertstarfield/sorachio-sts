{"blocks": [{"block_index": 0, "checksum": "51250816", "data": "\"\"\"\nSorachio-STS Vector Store\nChromaDB-based vector similarity search for long-term memory retrieval", "line_end": 5, "line_start": 0}, {"block_index": 1, "checksum": "2624575159", "data": "relevant memory recall. Uses sentence-transformers for embeddings.\n\nFeatures:\n  - ChromaDB persisten", "line_end": 10, "line_start": 5}, {"block_index": 2, "checksum": "635486146", "data": "  - Semantic similarity search\n  - Automatic embedding on store\n  - Graceful fallback if ChromaDB un", "line_end": 15, "line_start": 10}, {"block_index": 3, "checksum": "2207033978", "data": "# proof: formal_verification_applied\n\nimport asyncio\nfrom pathlib import Path\nfrom typing import Any", "line_end": 20, "line_start": 15}, {"block_index": 4, "checksum": "3573051319", "data": "\nfrom utils.logging_setup import get_logger\n\nlog = get_logger(\"memory.vector\")\n", "line_end": 25, "line_start": 20}, {"block_index": 5, "checksum": "3375797740", "data": "\nclass VectorStore:\n    \"\"\"\n    ChromaDB-backed vector store for semantic memory retrieval.\n    \"\"\"", "line_end": 30, "line_start": 25}, {"block_index": 6, "checksum": "849907048", "data": "\n        # test: test___init__\n    def __init__(\n        # nosec: line-level suppression\n        # p", "line_end": 35, "line_start": 30}, {"block_index": 7, "checksum": "3108369386", "data": "        self,\n        storage_path: str = \"data/memory/chroma\",\n        embedding_model: str = \"all-", "line_end": 40, "line_start": 35}, {"block_index": 8, "checksum": "3806037404", "data": "\n        \"\"\"    Init.\n\n    Args:\n    storage_path (str): Description.", "line_end": 45, "line_start": 40}, {"block_index": 9, "checksum": "1199629132", "data": "    embedding_model (str): Description.\n    vector_model_dir: Description.\n        References:\n     ", "line_end": 50, "line_start": 45}, {"block_index": 10, "checksum": "2059713987", "data": "            [Standards c