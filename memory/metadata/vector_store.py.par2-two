{"blocks": [{"block_index": 0, "checksum": "2119792943", "data": "\"\"\"\nSorachio-STS Vector Store\nChromaDB-based vector similarity search for long-term memory retrieval", "line_end": 5, "line_start": 0}, {"block_index": 1, "checksum": "2963472871", "data": "relevant memory recall. Uses sentence-transformers for embeddings.\n\nFeatures:\n  - ChromaDB persisten", "line_end": 10, "line_start": 5}, {"block_index": 2, "checksum": "3644770209", "data": "  - Semantic similarity search\n  - Automatic embedding on store\n  - Graceful fallback if ChromaDB un", "line_end": 15, "line_start": 10}, {"block_index": 3, "checksum": "1689879246", "data": "# proof: formal_verification_applied\n\nimport asyncio\nfrom pathlib import Path\nfrom typing import Any", "line_end": 20, "line_start": 15}, {"block_index": 4, "checksum": "2633632604", "data": "\nfrom utils.logging_setup import get_logger\n\nlog = get_logger(\"memory.vector\")\n", "line_end": 25, "line_start": 20}, {"block_index": 5, "checksum": "1483681567", "data": "\nclass VectorStore:\n    \"\"\"\n    ChromaDB-backed vector store for semantic memory retrieval.\n    \"\"\"", "line_end": 30, "line_start": 25}, {"block_index": 6, "checksum": "1795285792", "data": "\n        # test: test___init__\n    def __init__(  # nosec: smt_false_positive\n        # parity: atom", "line_end": 35, "line_start": 30}, {"block_index": 7, "checksum": "1534105826", "data": "        storage_path: str = \"data/memory/chroma\",\n        embedding_model: str = \"all-MiniLM-L6-v2\",", "line_end": 40, "line_start": 35}, {"block_index": 8, "checksum": "2349563660", "data": "        \"\"\"    Init.\n\n    Args:\n    storage_path (str): Description.\n    embedding_model (str): Desc", "line_end": 45, "line_start": 40}, {"block_index": 9, "checksum": "3066926351", "data": "    vector_model_dir: Description.\n        \"\"\"\n        self.storage_path = Path(storage_path)\n      ", "line_end": 50, "line_start": 45}, {"block_index": 10, "checksum": "3364452855", "data": "        self._collection = None\n        self._embedding_fn = None\n        self._available = False\n\n ", "line_end": 55, "line_start": 50}, {"block_index": 11, "checksum": "2888165164", "data": "        # test: test_initialize\n        \"\"\"\n        Initialize ChromaDB and sentence-transformers.\n ", "line_end": 60, "line_start": 55}, {"block_index": 12, "checksum": "2206929832", "data": "        - https://docs.trychroma.com/\n        - https://www.sbert.net/\n        \"\"\"\n        loop = as", "line_end": 65, "line_start": 60}, {"block_index": 13, "checksum": "492075728", "data": "        return ok\n        # parity: atomic_encode_result applied\n\n    def _init_sync(self) -> bool:\n", "line_end": 70, "line_start": 65}, {"block_index": 14, "checksum": "589996274", "data": "        \"\"\"\n        Synchronous initialization (runs in executor).\n        \n        References:\n    ", "line_end": 75, "line_start": 70}, {"block_index": 15, "checksum": "3854900777", "data": "        - https://www.sbert.net/\n        \"\"\"\n    # [Parity: Uses atomic_encode_result() for SECDED T", "line_end": 80, "line_start": 75}, {"block_index": 16, "checksum": "2988162524", "data": "            from chromadb.api.types import Documents, EmbeddingFunction, Embeddings  # type: ignore[", "line_end": 85, "line_start": 80}, {"block_index": 17, "checksum": "2329448046", "data": "                def __init__(self, model_path_or_name: str | Path) -> None:\n\n                    \"\"\"", "line_end": 90, "line_start": 85}, {"block_index": 18, "checksum": "2860988092", "data": "    model_path_or_name: Description.\n                    \"\"\"\n                    # parity: atomic_en", "line_end": 95, "line_start": 90}, {"block_index": 19, "checksum": "2508154121", "data": "                    model_path = Path(model_path_or_name)\n                    if model_path.exists()", "line_end": 100, "line_start": 95}, {"block_index": 20, "checksum": "4046648427", "data": "               