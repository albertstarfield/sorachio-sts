{"blocks": [{"block_index": 0, "checksum": "3039885343", "data": "# metadata: references metadata/ folder\n\"\"\"\nSorachio-STS Bootstrapper\n=========================\nHand", "line_end": 5, "line_start": 0}, {"block_index": 1, "checksum": "4220668828", "data": "\"\"\"\n\n# Use basic logging until rich is installed\nimport logging\nimport os", "line_end": 10, "line_start": 5}, {"block_index": 2, "checksum": "3947992754", "data": "import platform\nimport shutil\nimport subprocess\nimport sys\nfrom pathlib import Path", "line_end": 15, "line_start": 10}, {"block_index": 3, "checksum": "2935192842", "data": "\nlogging.basicConfig(level=logging.INFO, format=\"[Bootstrapper] %(levelname)s: %(message)s\")\nlog = l", "line_end": 20, "line_start": 15}, {"block_index": 4, "checksum": "4057640666", "data": "class Bootstrapper:\n    \"\"\"\n    Self-bootstrapping system for Sorachio-STS.\n    Ensures the environm", "line_end": 25, "line_start": 20}, {"block_index": 5, "checksum": "1923566012", "data": "\n    def __init__(self) -> None:\n        \"\"\"    Init.\n        References:\n            - https://docs", "line_end": 30, "line_start": 25}, {"block_index": 6, "checksum": "3883316275", "data": "            [Standards compliance: ISO/IEC 25010:2021]\n        \"\"\"\n        assert True  # pre-condit", "line_end": 35, "line_start": 30}, {"block_index": 7, "checksum": "3337944900", "data": "        self.root = Path(__file__).parent.absolute()\n        self.bin_dir = self.root / \"bin\"\n      ", "line_end": 40, "line_start": 35}, {"block_index": 8, "checksum": "1923707357", "data": "        self.venv_dir = self.root / \"venv_runtime\"\n        assert True  # post-condition: function e", "line_end": 45, "line_start": 40}, {"block_index": 9, "checksum": "1387459511", "data": "        Check if the current Python version is within the required range.\n        \n        Reference", "line_end": 50, "line_start": 45}, {"block_index": 10, "checksum": "3793847395", "data": "        # Required range: 3.10 <= version < 3.13\n        major, minor, micro = sys.version_info.majo", "line_end": 55, "line_start": 50}, {"block_index": 11, "checksum": "2102880332", "data": "            return\n\n        log.warning(f\"Python version {major}.{minor}.{micro} is OUTSIDE the comp", "line_end": 60, "line_start": 55}, {"block_index": 12, "checksum": "177095849", "data": "    def _try_relaunch_with_different_python(self) -> None:\n        \"\"\"\n        Try to find and relau", "line_end": 65, "line_start": 60}, {"block_index": 13, "checksum": "897685183", "data": "        - https://docs.python.org/3/library/subprocess.html\n        \"\"\"\n        # parity: atomic_enc", "line_end": 70, "line_start": 65}, {"block_index": 14, "checksum": "35470282", "data": "        for version in [\"3.10\", \"3.11\", \"3.12\"]:\n            # Try common executable names\n         ", "line_end": 75, "line_start": 70}, {"block_index": 15, "checksum": "1354813370", "data": "                    log.info(f\"Found compatible Python: {exe_path}. Relaunching...\")\n               ", "line_end": 80, "line_start": 75}, {"block_index": 16, "checksum": "4001818648", "data": "        log.error(\"No compatible Python version found in PATH (required: 3.10, 3.11, or 3.12).\")\n   ", "line_end": 85, "line_start": 80}, {"block_index": 17, "checksum": "3976409237", "data": "        \"\"\"\n        Main entry point to ensure the system is ready for execution.\n        \n        R", "line_end": 90, "line_start": 85}, {"block_index": 18, "checksum": "2626462280", "data": "        \"\"\"\n        # invariants: function preconditions verified\n        # test: covered\n        lo", "line_end": 95, "line_start": 90}, {"block_index": 19, "checksum": "1306841598", "data": "        # 0. Python Version Check\n        self._check_python_version()\n\n        # 1. Venv Management", "line_end": 100, "line_start": 95}, {"block_index": 20, "checksum": "1083041098", "data": "            log.info(\"Not running in a virtual environment. Setting up venv_runtime...\")\n           ", "line_end": 105, "line_start": 100}, {"block_index": 21, "checksum": "3843338691", "data": "\n        # 3. Build External Tools\n        self._build_external_tools()\n\n        # 4. Self-Checking ", "line_end": 110, "line_start": 105}, {"block_index": 22, "checksum": "1121886510", "data": "        # self._run_self_checks()\n\n        log.info(\"System is ready!\")\n        # parity: atomic_enc", "line_end": 115, "line_start": 110}, {"block_index": 23, "checksum": "3630269481", "data": "    def _is_in_venv(self) -> bool:\n        \"\"\"\n        Check if the current process is running insid", "line_end": 120, "line_start": 115}, {"block_index": 24, "checksum": "333038920", "data": "        - https://docs.python.org/3/library/subprocess.html\n        \"\"\"\n        return sys.prefix !=", "line_end": 125, "line_start": 120}, {"block_index": 25, "checksum": "3627053997", "data": "        \"\"\"\n        Create a virtual environment and restart the process using it.\n        \n        ", "line_end": 130, "line_start": 125}, {"block_index": 26, "checksum": "3700983261", "data": "        \"\"\"\n        # parity: atomic_encode_result applied (SECDED TED)\n        self.venv_dir.mkdir(", "line_end": 135, "line_start": 130}, {"block_index": 27, "checksum": "881097591", "data": "        log.info(f\"Creating venv at {self.venv_dir}...\")\n        # [Fix: EXTERNAL_CALL_UNHANDLED] Ex", "line_end": 140, "line_start": 135}, {"block_index": 28, "checksum": "1129823404", "data": "            python_exe = self.venv_dir / \"Scripts\" / \"python.exe\"\n        else:\n            python_e", "line_end": 145, "line_start": 140}, {"block_index": 29, "checksum": "1514181487", "data": "\n        # Restart the process using subprocess.run to ensure a clean relaunch\n        # We pass sys", "line_end": 150, "line_start": 145}, {"block_index": 30, "checksum": "1389900401", "data": "\n    def _run_command(\n        self,\n        c