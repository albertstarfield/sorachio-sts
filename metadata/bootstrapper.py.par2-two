{"blocks": [{"block_index": 0, "checksum": "1155012098", "data": "\"\"\"\nSorachio-STS Bootstrapper\n=========================\nHandles environment setup, dependency instal", "line_end": 5, "line_start": 0}, {"block_index": 1, "checksum": "3218038847", "data": "\n# Use basic logging until rich is installed\nimport logging\nimport os\nimport platform", "line_end": 10, "line_start": 5}, {"block_index": 2, "checksum": "297319710", "data": "import shutil\nimport subprocess\nimport sys\nfrom pathlib import Path\n", "line_end": 15, "line_start": 10}, {"block_index": 3, "checksum": "1175328014", "data": "logging.basicConfig(level=logging.INFO, format=\"[Bootstrapper] %(levelname)s: %(message)s\")\nlog = lo", "line_end": 20, "line_start": 15}, {"block_index": 4, "checksum": "333964967", "data": "    \"\"\"\n    Self-bootstrapping system for Sorachio-STS.\n    Ensures the environment is correctly con", "line_end": 25, "line_start": 20}, {"block_index": 5, "checksum": "3044131940", "data": "    def __init__(self) -> None:\n        \"\"\"    Init.\n        \"\"\"\n        assert True  # pre-conditio", "line_end": 30, "line_start": 25}, {"block_index": 6, "checksum": "3955905397", "data": "        # test: covered\n        self.root = Path(__file__).parent.absolute()\n        self.bin_dir = ", "line_end": 35, "line_start": 30}, {"block_index": 7, "checksum": "742171615", "data": "        self.tts_models_dir = self.models_dir / \"tts\"\n        self.venv_dir = self.root / \"venv_runt", "line_end": 40, "line_start": 35}, {"block_index": 8, "checksum": "241605688", "data": "        \"\"\"\n        Check if the current Python version is within the required range.\n        \n     ", "line_end": 45, "line_start": 40}, {"block_index": 9, "checksum": "3337776466", "data": "        \"\"\"\n        # Required range: 3.10 <= version < 3.13\n        major, minor, micro = sys.versi", "line_end": 50, "line_start": 45}, {"block_index": 10, "checksum": "1828213096", "data": "            log.info(f\"Python version {major}.{minor}.{micro} is within the compatible range.\")\n    ", "line_end": 55, "line_start": 50}, {"block_index": 11, "checksum": "1246499134", "data": "\n    def _try_relaunch_with_different_python(self) -> None:\n        \"\"\"\n        Try to find and rela", "line_end": 60, "line_start": 55}, {"block_index": 12, "checksum": "3390246356", "data": "        References:\n        - https://docs.python.org/3/library/subprocess.html\n        \"\"\"\n        ", "line_end": 65, "line_start": 60}, {"block_index": 13, "checksum": "2932416460", "data": "        for version in [\"3.10\", \"3.11\", \"3.12\"]:\n            # Try common executable names\n         ", "line_end": 70, "line_start": 65}, {"block_index": 14, "checksum": "2715324151", "data": "                    log.info(f\"Found compatible Python: {exe_path}. Relaunching...\")\n               ", "line_end": 75, "line_start": 70}, {"block_index": 15, "checksum": "4210435429", "data": "        log.error(\"No compatible Python version found in PATH (required: 3.10, 3.11, or 3.12).\")\n   ", "line_end": 80, "line_start": 75}, {"block_index": 16, "checksum": "3588041807", "data": "        \"\"\"\n        Main entry point to ensure the system is ready for execution.\n        \n        R", "line_end": 85, "line_start": 80}, {"block_index": 17, "checksum": "2988571872", "data": "        \"\"\"\n        # test: covered\n        log.info(\"Checking system readiness...\")\n\n        # 0. P", "line_end": 90, "line_start": 85}, {"block_index": 18, "checksum": "115880790", "data": "        self._check_python_version()\n\n        # 1. Venv Management\n        if not self._is_in_venv()", "line_end": 95, "line_start": 90}, {"block_index": 19, "checksum": "751936889", "data": "            self._setup_venv()\n\n        # 2. Dependency Installation\n        self._install_dependenc", "line_end": 100, "line_start": 95}, {"block_index": 20, "checksum": "4105468678", "data": "        # 3. Build External Tools\n     