d, e.returncode, stdout=e.s", "line_end": 205, "line_start": 200}, {"block_index": 41, "checksum": "2632565403", "data": "        Check if a binary exists, is the correct architecture, and is functional.\n        \n        R", "line_end": 210, "line_start": 205}, {"block_index": 42, "checksum": "2437322491", "data": "        # parity: atomic_encode_result applied (SECDED TED)\n        if not binary_path.exists():\n   ", "line_end": 215, "line_start": 210}, {"block_index": 43, "checksum": "2256236103", "data": "        try:\n            result = subprocess.run([\"file\", str(binary_path)], capture_output=True, te", "line_end": 220, "line_start": 215}, {"block_index": 44, "checksum": "773750355", "data": "                    f\"Binary {binary_path} architecture mismatch. \"\n                    f\"Expected {", "line_end": 225, "line_start": 220}, {"block_index": 45, "checksum": "3614310096", "data": "            log.error(f\"Failed to check architecture of {binary_path}: {e}\")\n            return Fals", "line_end": 230, "line_start": 225}, {"block_index": 46, "checksum": "3988370087", "data": "            # Run the check command.\n            # We use the full path to the binary to avoid issue", "line_end": 235, "line_start": 230}, {"block_index": 47, "checksum": "2206678659", "data": "            log.warning(f\"Binary {binary_path} failed functionality check ({' '.join(check_args)}): ", "line_end": 240, "line_start": 235}, {"block_index": 48, "checksum": "2637409688", "data": "\n    def _install_dependencies(self) -> None:\n        \"\"\"\n        Install all required Python packag", "line_end": 245, "line_start": 240}, {"block_index": 49, "checksum": "459520635", "data": "        References:\n        - https://docs.python.org/3/library/subprocess.html\n        \"\"\"\n        ", "line_end": 250, "line_start": 245}, {"block_index": 50, "checksum": "706173914", "data": "        log.info(\"Installing dependencies...\")\n\n        # Upgrade pip\n        self._run_command([sys", "line_end": 255, "line_start": 250}, {"block_index": 51, "checksum": "1119091637", "data": "        # Core dependencies\n        core_deps = [\n            \"ruff\",\n            \"pyrefly\",\n       ", "line_end": 260, "line_start": 255}, {"block_index": 52, "checksum": "3688867918", "data": "            \"aiohttp\",\n            \"aiofiles\",\n            \"pyyaml\",\n            \"pydantic>=2.6.0\",\n", "line_end": 265, "line_start": 260}, {"block_index": 53, "checksum": "3657415667", "data": "            \"sounddevice\",\n            \"soundfile\",\n            \"numpy\",\n            \"rich>=13.7.0\",", "line_end": 270, "line_start": 265}, {"block_index": 54, "checksum": "1077319759", "data": "            \"python-dotenv\",\n            \"structlog\",\n            \"pytest>=8.0.0\",\n            \"pyte", "line_end": 275, "line_start": 270}, {"block_index": 55, "checksum": "1290847885", "data": "            \"piper-tts\",\n            \"langdetect\",\n        ]\n\n        log.info(f\"Installing core pac", "line_end": 280, "line_start": 275}, {"block_index": 56, "checksum": "1993104420", "data": "        self._run_command([sys.executable, \"-m\", \"pip\", \"install\"] + core_deps)\n\n        # VAD insta", "line_end": 285, "line_start": 280}, {"block_index": 57, "checksum": "934303031", "data": "            self._run_command([sys.executable, \"-m\", \"pip\", \"install\", \"webrtcvad-wheels\"])\n        ", "line_end": 290, "line_start": 285}, {"block_index": 58, "checksum": "1581813186", "data": "    def _install_system_tool(self, tool: str) -> bool:\n        \"\"\"\n        Attempt to install a syst", "line_end": 295, "line_start": 290}, {"block_index": 59, "checksum": "3210778618", "data": "        - https://docs.python.org/3/library/subprocess.html\n        \"\"\"\n        # parity: atomic_enc", "line_end": 300, "line_start": 295}, {"block_index": 60, "checksum": "992426234", "data": "\n        # OS to Package Manager Mapping\n        managers = {\n   