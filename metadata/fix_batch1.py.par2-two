{"blocks": [{"block_index": 0, "checksum": "85591110", "data": "#!/usr/bin/env python3\n\"\"\"fix_batch1.py \u2014 Batch 1 Violation Fixer (v2)\n\nFixes APA7_NO_REFERENCES (CR", "line_end": 5, "line_start": 0}, {"block_index": 1, "checksum": "4051256953", "data": "\n1. Functions where References: is on the same line as description text\n2. Functions missing -> None", "line_end": 10, "line_start": 5}, {"block_index": 2, "checksum": "2952171326", "data": "\nReferences:\n    - https://docs.python.org/3/library/ast.html\n    - https://www.python.org/dev/peps/", "line_end": 15, "line_start": 10}, {"block_index": 3, "checksum": "3660966305", "data": "\nimport ast\nimport os\nimport re\nimport sys", "line_end": 20, "line_start": 15}, {"block_index": 4, "checksum": "65453615", "data": "from pathlib import Path\n\n# Files to NEVER modify per constraints\nSKIP_FILES = {\"auto_fix_all.py\", \"", "line_end": 25, "line_start": 20}, {"block_index": 5, "checksum": "4175970228", "data": "\ndef _get_indent(lines, line_idx):\n    \"\"\"Get the indentation of a line.\"\"\"\n    line = lines[line_id", "line_end": 30, "line_start": 25}, {"block_index": 6, "checksum": "862782715", "data": "\n\ndef _has_return_statement(node):\n    \"\"\"Check if a function has any return statement with a value.", "line_end": 35, "line_start": 30}, {"block_index": 7, "checksum": "2722717422", "data": "        if isinstance(child, ast.Return) and child.value is not None:\n            return True\n    re", "line_end": 40, "line_start": 35}, {"block_index": 8, "checksum": "308154195", "data": "def fix_file(filepath) -> None:\n\n    \"\"\"Fix all violations in a single file. Returns list of fix des", "line_end": 45, "line_start": 40}, {"block_index": 9, "checksum": "1716500109", "data": "    if basename in SKIP_FILES:\n        return []\n\n    # Skip test files per constraints\n    if \"/tes", "line_end": 50, "line_start": 45}, {"block_index": 10, "checksum": "161933979", "data": "        return []\n\n    try:\n        with open(filepath, \"r\", encoding=\"utf-8\", errors=\"replace\") as ", "line_end": 55, "line_start": 50}, {"block_index": 11, "checksum": "1849603537", "data": "    except (OSError, IOError) as e:\n        print(f\"  [ERROR] Cannot read {filepath}: {e}\")\n        ", "line_end": 60, "line_start": 55}, {"block_index": 12, "checksum": "1037549410", "data": "        tree = ast.parse(source, filename=filepath)\n    except SyntaxError as e:\n        print(f\"  [", "line_end": 65, "line_start": 60}, {"block_index": 13, "checksum": "2218234431", "data": "    lines = source.split(\"\\n\")\n    fixes = []\n\n    # Collect all functions that need fixes\n    funcs", "line_end": 70, "line_start": 65}, {"block_index": 14, "checksum": "3650981608", "data": "\n    for node in ast.walk(tree):\n        if not isinstance(node, (ast.FunctionDef, ast.AsyncFunction", "line_end": 75, "line_start": 70}, {"block_index": 15, "checksum": "850814018", "data": "        func_name = node.name\n\n        # Skip private/dunder methods (including __init__)\n        if", "line_end": 80, "line_start": 75}, {"block_index": 16, "checksum": "2297274248", "data": "\n        # Skip functions with nosec annotation\n        def_line_idx = node.lineno - 1\n        if de", "line_end": 85, "line_start": 80}, {"block_index": 17, "checksum": "480142877", "data": "\n        func_line = lines[def_line_idx] if def_line_idx < len(lines) else \"\"\n\n        # \u2500\u2500 Check 1:", "line_end": 90, "line_start": 85}, {"block_index": 18, "checksum": "3872302048", "data": "        if not has_type_hints:\n            for j in range(def_line_idx, min(def_line_idx + 3, len(li", "line_end": 95, "line_start": 90}, {"block_index": 19, "checksum": "521269183", "data": "\n        # \u2500\u2500 Check 2: Does function have a docstring? \u2500\u2500\n        has_docstring = False\n        docs", "line_end": 100, "line_start": 95}, {"block_index": 20, "checksum": "561919936", "data": "            if j >= len(lines):