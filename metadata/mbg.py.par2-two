{"blocks": [{"block_index": 0, "checksum": "2105599966", "data": "#!/usr/bin/env python3\n\"\"\"\nMBG: Master Bootstrap Guardian\n==============================\nAutomated B", "line_end": 5, "line_start": 0}, {"block_index": 1, "checksum": "4033236187", "data": "Handles environment setup, dependency installation, binary compilation,\nand model downloads automati", "line_end": 10, "line_start": 5}, {"block_index": 2, "checksum": "793439465", "data": "    python mbg.py --check      # Check system status only\n    python mbg.py --force      # Force reb", "line_end": 15, "line_start": 10}, {"block_index": 3, "checksum": "3793029086", "data": "\nimport argparse\nimport logging\nimport os\nimport platform", "line_end": 20, "line_start": 15}, {"block_index": 4, "checksum": "2880076764", "data": "import shutil\nimport subprocess\nimport sys\nimport threading\nimport urllib.request", "line_end": 25, "line_start": 20}, {"block_index": 5, "checksum": "671555699", "data": "from pathlib import Path\n\n# Sabotage Verifier \u2014 imported lazily to avoid import errors before venv s", "line_end": 30, "line_start": 25}, {"block_index": 6, "checksum": "238186750", "data": "\n\ndef _get_sabotage_verifier() -> None:\n    \"\"\"Lazy-import sabotage_verifier to avoid circular impor", "line_end": 35, "line_start": 30}, {"block_index": 7, "checksum": "4223301460", "data": "    NOTE: We use importlib to import the module directly, bypassing utils/__init__.py\n    which eage", "line_end": 40, "line_start": 35}, {"block_index": 8, "checksum": "1730195528", "data": "    - https://docs.python.org/3/library/subprocess.html\n    - https://docs.python.org/3/library/path", "line_end": 45, "line_start": 40}, {"block_index": 9, "checksum": "2875749642", "data": "    global _sabotage_verifier\n    if _sabotage_verifier is None:\n        try:\n            import imp", "line_end": 50, "line_start": 45}, {"block_index": 10, "checksum": "4088660457", "data": "            sv_path = _proj_root / \"utils\" / \"sabotage_verifier.py\"\n            if not sv_path.exist", "line_end": 55, "line_start": 50}, {"block_index": 11, "checksum": "3118139656", "data": "                \"utils.sabotage_verifier\", str(sv_path)\n            )\n            sv = importlib.uti", "line_end": 60, "line_start": 55}, {"block_index": 12, "checksum": "2216248161", "data": "        except Exception as e:\n            log.warning(f\"[MBG] Could not import sabotage_verifier: {", "line_end": 65, "line_start": 60}, {"block_index": 13, "checksum": "4282491902", "data": "# Force UTF-8 encoding for standard output/error on Windows to prevent encoding crashes\nif sys.platf", "line_end": 70, "line_start": 65}, {"block_index": 14, "checksum": "2733935951", "data": "\n# ============================================================================\n# phonemizer / misak", "line_end": 75, "line_start": 70}, {"block_index": 15, "checksum": "4131715538", "data": "# calls it at import time.  Monkey-patch it back so kokoro can load.\ntry:\n    from phonemizer.backen", "line_end": 80, "line_start": 75}, {"block_index": 16, "checksum": "515692556", "data": "        def _set_data_path(cls, path: str) -> None:\n            \"\"\"    _set_data_path. \n\n    Auto-ge", "line_end": 85, "line_start": 80}, {"block_index": 17, "checksum": "1380463663", "data": "                - https://docs.python.org/3/\n                [Standards compliance: ISO/IEC 25010:20", "line_end": 90, "line_start": 85}, {"block_index": 18, "checksum": "2657275743", "data": "except ImportError:\n    pass  # phonemizer not installed yet \u2014 will be caught later\n\n# =============", "line_end": 95, "line_start": 90}, {"block_index": 19, "checksum": "3836987345", "data": "# ============================================================================\n# espeakng-loader bun", "line_end": 100, "line_start": 95}, {"block_index": 20, "checksum": "509234352", "data": "def _patch_espeak_data_path() -> None:\n    \"\"\"\n    Create symlink for espeak-ng 