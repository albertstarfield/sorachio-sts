500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n# Reed-Solomon(2", "line_end": 1945, "line_start": 1940}, {"block_index": 389, "checksum": "1843850738", "data": "#\n# AXIOMS:\n# 1. Split parity enables 10% data recovery (RS 5% + GC 5%)\n# 2. RS parity uses Galois F", "line_end": 1950, "line_start": 1945}, {"block_index": 390, "checksum": "3060452789", "data": "#\n# THEOREMS:\n# 1. THEOREM: Any 5% data loss can be recovered\n#    PROOF: Reed-Solomon(255,223) can ", "line_end": 1955, "line_start": 1950}, {"block_index": 391, "checksum": "3183135135", "data": "\ndef generate_parity(source_path: str, block_size: int = 512) -> dict:\n    try:\n      \"\"\"Generate sp", "line_end": 1960, "line_start": 1955}, {"block_index": 392, "checksum": "1251456746", "data": "      Creates RS and GC parity blocks with per-part checksums.\n      RS: Reed-Solomon(255,223) encod", "line_end": 1965, "line_start": 1960}, {"block_index": 393, "checksum": "3325016691", "data": "      1. Source file is read and split into blocks\n      2. Each block is encoded with Reed-Solomon(", "line_end": 1970, "line_start": 1965}, {"block_index": 394, "checksum": "2400080105", "data": "      -- CITATIONS --\n      - Reed, I.S. & Solomon, G. (1960) Polynomial Codes over Certain Finite F", "line_end": 1975, "line_start": 1970}, {"block_index": 395, "checksum": "1595889051", "data": "      Args:\n          source_path: Path to the source file\n          block_size: Size of each parity", "line_end": 1980, "line_start": 1975}, {"block_index": 396, "checksum": "822108901", "data": "          dict with rs_parity, gc_parity, source_hash, rs_checksum, gc_checksum\n      \"\"\"\n      # pa", "line_end": 1985, "line_start": 1980}, {"block_index"