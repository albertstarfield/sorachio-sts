{"blocks": [{"block_index": 0, "checksum": "3609253764", "data": "#!/usr/bin/env python3\n\"\"\"\nMBG: Master Bootstrap Guardian\n==============================\nAutomated B", "line_end": 5, "line_start": 0}, {"block_index": 1, "checksum": "1080537426", "data": "Handles environment setup, dependency installation, binary compilation,\nand model downloads automati", "line_end": 10, "line_start": 5}, {"block_index": 2, "checksum": "2996387410", "data": "    python mbg.py --check      # Check system status only\n    python mbg.py --force      # Force reb", "line_end": 15, "line_start": 10}, {"block_index": 3, "checksum": "480623672", "data": "\nimport argparse\nimport logging\nimport os\nimport platform", "line_end": 20, "line_start": 15}, {"block_index": 4, "checksum": "2296404614", "data": "import shutil\nimport subprocess\nimport sys\nimport threading\nimport urllib.request", "line_end": 25, "line_start": 20}, {"block_index": 5, "checksum": "1925579856", "data": "from pathlib import Path\n\n# Sabotage Verifier \u2014 imported lazily to avoid import errors before venv s", "line_end": 30, "line_start": 25}, {"block_index": 6, "checksum": "6292396", "data": "\n\ndef _get_sabotage_verifier() -> None:\n    \"\"\"Lazy-import sabotage_verifier to avoid circular impor", "line_end": 35, "line_start": 30}, {"block_index": 7, "checksum": "788850868", "data": "    NOTE: We use importlib to import the module directly, bypassing utils/__init__.py\n    which eage", "line_end": 40, "line_start": 35}, {"block_index": 8, "checksum": "4066381500", "data": "    - https://docs.python.org/3/library/subprocess.html\n    - https://docs.python.org/3/library/path", "line_end": 45, "line_start": 40}, {"block_index": 9, "checksum": "1857326697", "data": "        try:\n            import importlib.util\n            _proj_root = Path(__file__).parent.absolu", "line_end": 50, "line_start": 45}, {"block_index": 10, "checksum": "3002536847", "data": "                log.warning(f\"[MBG] sabotage_verifier.py not found at {sv_path}\")\n                re", "line_end": 55, "line_start": 50}, {"block_index": 11, "checksum": "883671602", "data": "            sv = importlib.util.module_from_spec(spec)\n            spec.loader.exec_module(sv)\n     ", "line_end": 60, "line_start": 55}, {"block_index": 12, "checksum": "3971084849", "data": "    return _sabotage_verifier\n\n\n# Force UTF-8 encoding for standard output/error on Windows to preve", "line_end": 65, "line_start": 60}, {"block_index": 13, "checksum": "3290733889", "data": "    import io\n    sys.stdout = io.TextIOWrapper(sys.stdout.buffer, encoding=\"utf-8\", errors=\"replace", "line_end": 70, "line_start": 65}, {"block_index": 14, "checksum": "2036528810", "data": "# phonemizer / misaki compatibility patch\n# ========================================================", "line_end": 75, "line_start": 70}, {"block_index": 15, "checksum": "432016170", "data": "    from phonemizer.backend.espeak.wrapper import EspeakWrapper as _EspeakWrapper\n    if not hasattr", "line_end": 80, "line_start": 75}, {"block_index": 16, "checksum": "845083261", "data": "\n    Auto-generated docstring.\n    \"\"\"\n            cls.data_path = path\n        _EspeakWrapper.set_d", "line_end": 85, "line_start": 80}, {"block_index": 17, "checksum": "4207054513", "data": "except ImportError:\n    pass  # phonemizer not installed yet \u2014 will be caught later\n\n# =============", "line_end": 90, "line_start": 85}, {"block_index": 18, "checksum": "3206844462", "data": "# ============================================================================\n# espeakng-loader bun", "line_end": 95, "line_start": 90}, {"block_index": 19, "checksum": "1551783572", "data": "def _patch_espeak_data_path() -> None:\n    \"\"\"\n    Create symlink for espeak-ng data if the hardcode", "line_end": 100, "line_start": 95}, {"block_index": 20, "checksum": "4267693433", "data": "        - https://docs.python.org/3/library/subprocess.html\n        - https://docs.python.org/3/libr", "line_end": 105, "line_start": 100}, {"block_index": 21, "checksum": "967196674", "data": "        data_path = Path(_espeak_loader.get_data_path())\n        # The hardcoded path from espeakng-", "line_end": 110, "line_start": 105}, {"block_index": 22, "checksum": "1311683866", "data": "            subprocess.run(\n                [\"sudo\", \"mkdir\", \"-p\", str(hardcoded.parent)],\n        ", "line_end": 115, "line_start": 110}, {"block_index": 23, "checksum": "2390919691", "data": "                [\"sudo\", \"ln\", \"-s\", str(data_path), str(hardcoded)],\n                capture_output", "line_end": 120, "line_start": 115}, {"block_index": 24, "checksum": "880041341", "data": "\n_patch_espeak_data_path()\n\n# ======================================================================", "line_end": 125, "line_start": 120}, {"block_index": 25, "checksum": "1378833315", "data": "# ============================================================================\n\nMBG_VERSION = \"1.0.0", "line_end": 130, "line_start": 125}, {"block_index": 26, "checksum": "3922762344", "data": "\n# Supported Python versions\n# [Fix: widening PYTHON_MAX to support system Python 3.14]\nPYTHON_MIN =", "line_end": 135, "line_start": 130}, {"block_index": 27, "checksum": "3035977996", "data": "\n# Project structure\nPROJECT_ROOT = Path(__file__).parent.absolute()\nBIN_DIR = PROJECT_ROOT / \"bin\"\n", "line_end": 140, "line_start": 135}, {"block_index": 28, "checksum": "1980540490", "data": "MODELS_DIR = PROJECT_ROOT / \"models\"\nVENV_DIR = PROJECT_ROOT / \"venv_runtime\"\n\n# Force HF_HOME to po", "line_end": 145, "line_start": 140}, {"block_index": 29, "checksum": "2569302236", "data": "    os.environ[\"HF_HOME\"] = str(MODELS_DIR / \"tts\" / \"kokoro\")\n\n# Model configurations (only STT is ", "line_end": 150, "line_start": 145}, {"block_index": 30, "checksum": "1700972690", "data": "# LLM model directories (auto-detected, user-managed)\nLLM_MODEL_DIRS = {\n    \"llm1\": {\n        \"dir\"", "line_end": 155, "line_start": 150}, {"block_index": 31, "checksum": "1375301137", "data": "    },\n    \"llm2\": {\n        \"dir\": MODELS_DIR / \"llm2\",\n        \"label\": \"Personality Core\",\n    },", "line_end": 160, "line_start": 155}, {"block_index": 32, "checksum": "2214202513", "data": "}\n\n# Binary configurations\nBINARIES = {\n    \"llama-server\": {", "line_end": 165, "line_start": 160}, {"block_index": 33, "checksum": "2416335425", "data": "        \"repo\": \"llama.cpp\",\n        \"url\": \"https://github.com/ggerganov/llama.cpp\",\n        \"build", "line_end": 170, "line_start": 165}, {"block_index": 34, "checksum": "507083295", "data": "        \"check_args\": [\"--version\"],\n    },\n}\n\n# ===================================================", "line_end": 175, "line_start": 170}, {"block_index": 35, "checksum": "1936752526", "data": "# Logging Setup\n# ============================================================================\n\nlogg", "line_end": 180, "line_start": 175}, {"block_index": 36, "checksum": "878570815", "data": "    format=\"[MBG] %(levelname)s: %(message)s\"\n)\nlog = logging.getLogger(\"mbg\")\n\n", "line_end": 185, "line_start": 180}, {"block_index": 37, "checksum": "4127678019", "data": "# ============================================================================\n# MBG Core Class\n# ==", "line_end": 190, "line_start": 185}, {"block_index": 38, "checksum": "8025772", "data": "    \"\"\"\n    Master Bootstrap Guardian - Automated Build & Compatibility System.\n\n    Handles:\n    - ", "line_end": 195, "line_start": 190}, {"block_index": 39, "checksum": "3832785514", "data": "    - Virtual environment creation\n    - Dependency installation\n    - Binary compilation (llama.cpp", "line_end": 200, "line_start": 195}, {"block_index": 40, "checksum": "2388130243", "data": "    \"\"\"\n\n    def __init__(self, force: bool = False, check_only: bool = False) -> None:\n        \"\"\"\n", "line_end": 205, "line_s