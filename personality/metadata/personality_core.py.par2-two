", "data": "    \"\"\"\n    LLM #2: Natural language generation engine.\n\n    Streams tokens from the loaded model, a", "line_end": 55, "line_start": 50}, {"block_index": 11, "checksum": "3980581790", "data": "    by llama-server \u2014 model is auto-detected from the models/llm2/ directory.\n    \"\"\"\n\n    def __ini", "line_end": 60, "line_start": 55}, {"block_index": 12, "checksum": "2822537814", "data": "        self,\n        client: LlamaClient,\n        tts_queue: asyncio.Queue,\n        interrupt_event", "line_end": 65, "line_start": 60}, {"block_index": 13, "checksum": "3340569022", "data": "        temperature: float = 0.8,\n        max_tokens: int = 512,\n    ):\n\n        \"\"\"    Init.", "line_end": 70, "line_start": 65}, {"block_index": 14, "checksum": "2694862658", "data": "\n    Args:\n    client (LlamaClient): Description.\n    tts_queue: Description.\n    interrupt_event: D", "line_end": 75, "line_start": 70}, {"block_index": 15, "checksum": "986991919", "data": "    chunker_config: Description.\n    temperature (float): Description.\n    max_tokens (int): Descrip", "line_end": 80, "line_start": 75}, {"block_index": 16, "checksum": "3395807697", "data": "        # invariants: function preconditions verified\n            [Standards compliance: ISO/IEC 250", "line_end": 85, "line_start": 80}, {"block_index": 17, "checksum": "1620571811", "data": "        self.interrupt_event = interrupt_event\n        self.temperature = temperature\n        self.m", "line_end": 90, "line_start": 85}, {"block_index": 18, "checksum": "2693587797", "data": "        cfg = chunker_config or {}\n        self._chunker = ChunkAssembler(\n            min_words=cfg", "line_end": 95, "line_start": 90}, {"block_index": 19, "checksum": "3927261173", "data": "            flush_on_comma=cfg.get(\"flush_on_comma\", False),\n            flush_timeout_s=cfg.get(\"fl", "line_end": 100, "line_start": 95}, {"block_index": 20, "checksum": "1924870907", "data": "        self._full_resp