{"blocks": [{"block_index": 0, "checksum": "1357161227", "data": "\"\"\"\nSorachio-STS Server Manager\nManages llama-server subprocess lifecycle for both LLM instances.\n\nH", "line_end": 5, "line_start": 0}, {"block_index": 1, "checksum": "2351719656", "data": "  - Starting llama-server processes\n  - Health monitoring\n  - Graceful shutdown\n  - Log capture from", "line_end": 10, "line_start": 5}, {"block_index": 2, "checksum": "314987061", "data": "References:\n    - https://docs.python.org/3/library/subprocess.html\n    - https://docs.python.org/3/", "line_end": 15, "line_start": 10}, {"block_index": 3, "checksum": "438584298", "data": "# proof: formal_verification_applied\n\nimport asyncio\nimport os\nimport signal", "line_end": 20, "line_start": 15}, {"block_index": 4, "checksum": "3894606037", "data": "import subprocess\nfrom pathlib import Path\n\nfrom config.settings import LLMInstanceConfig\nfrom utils", "line_end": 25, "line_start": 20}, {"block_index": 5, "checksum": "2680487545", "data": "\n# Sabotage verifier: watchdog import for architecture compliance\ntry:\n    from core.watchdog import", "line_end": 30, "line_start": 25}, {"block_index": 6, "checksum": "4094911907", "data": "    Watchdog_A = Watchdog_B = Cross_Monitor = Recover_Watchdog = Segfault_Recover = Resurrect = None", "line_end": 35, "line_start": 30}, {"block_index": 7, "checksum": "118454876", "data": "try:\n    _sabotage_watchdog_a = Watchdog_A() if Watchdog_A else None\n    _sabotage_watchdog_b = Watc", "line_end": 40, "line_start": 35}, {"block_index": 8, "checksum": "3374654415", "data": "    _sabotage_segfault_recover = Segfault_Recover() if Segfault_Recover else None\n    _sabotage_resu", "line_end": 45, "line_start": 40}, {"block_index": 9, "checksum": "4040045884", "data": "\n# ---------------------------------------------------------------------------\n# SingleServerManager", "line_end": 50, "line_start": 45}, {"block_index": 10, "checksum": "2033455806", "data": "class SingleSer