ock))\n          blocks.append({\n        ", "line_end": 765, "line_start": 760}, {"block_index": 153, "checksum": "2948858864", "data": "              \"line_start\": i // block_size * 20,\n              \"line_end\": (i + block_size) // bloc", "line_end": 770, "line_start": 765}, {"block_index": 154, "checksum": "188201574", "data": "      rs_parity = {\n          \"source_file\": source_path.split(\"/\")[-1],\n          \"block_size\": blo", "line_end": 775, "line_start": 770}, {"block_index": 155, "checksum": "616402231", "data": "      }\n\n      # Create GC parity (par2-two) - weighted XOR\n      gc_blocks = []\n      for i in rang", "line_end": 780, "line_start": 775}, {"block_index": 156, "checksum": "3881980711", "data": "          group = blocks[i:i + 5]\n          parity = [0] * block_size\n          for j, block in enum", "line_end": 785, "line_start": 780}, {"block_index": 157, "checksum": "2430664468", "data": "          gc_blocks.append({\n              \"chunk_index\": len(gc_blocks),\n              \"parity\": pa", "line_end": 790, "line_start": 785}, {"block_index": 158, "checksum": "292285467", "data": "\n      gc_parity = {\n          \"source_file\": source_path.split(\"/\")[-1],\n          \"chunk_size\": 5,", "line_end": 795, "line_start": 790}, {"block_index": 159, "checksum": "246261469", "data": "          \"blocks\": gc_blocks,\n      }\n\n      # Compute checksums (must use sort_keys=True to match ", "line_end": 800, "line_start": 795}, {"block_index": 160, "checksum": "1566661004", "data": "      rs_checksum = hashlib.sha256(rs_serialized).hexdigest()\n\n      gc_serialized = json.dumps(gc_p", "line_end": 805, "line_start": 800}, {"block_index": 161, "checksum": "151757404", "data": "      return {\n          \"rs_parity\": rs_parity,\n          \"gc_parity\": gc_parity,\n          \"source", "line_end": 810, "line_start": 805}, {"block_index": 162, "checksum": "2701790970", "data": "          \"gc_checksum\": gc_checksum,\n      }\n    