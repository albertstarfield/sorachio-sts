ine arguments for subprocess.Popen.\n\n        Referenc", "line_end": 105, "line_start": 100}, {"block_index": 21, "checksum": "144912631", "data": "            - https://docs.python.org/3/library/subprocess.html\n        \"\"\"\n        # invariants: fu", "line_end": 110, "line_start": 105}, {"block_index": 22, "checksum": "1058976666", "data": "        cmd = [\n            str(self.binary_path),\n            \"--model\", str(self.model_path),\n    ", "line_end": 115, "line_start": 110}, {"block_index": 23, "checksum": "3208536105", "data": "            \"--n-gpu-layers\", str(self.config.n_gpu_layers),\n            \"--host\", \"127.0.0.1\",\n    ", "line_end": 120, "line_start": 115}, {"block_index": 24, "checksum": "3704380342", "data": "\n        # Add threads-batch parameter if set\n        if hasattr(self.config, 'n_threads_batch') and", "line_end": 125, "line_start": 120}, {"block_index": 25, "checksum": "2519518846", "data": "        # Context size: 0 = auto from model metadata (llama-server default)\n        if self.config.n", "line_end": 130, "line_start": 125}, {"block_index": 26, "checksum": "3225420660", "data": "        if hasattr(self.config, 'n_batch') and self.config.n_batch > 0:\n            cmd.extend([\"--b", "line_end": 135, "line_start": 130}, {"block_index": 27, "checksum": "3614232408", "data": "            cmd.extend([\"--reasoning\", self.config.reasoning])\n            if self.config.reasoning ", "line_end": 140, "line_start": 135}, {"block_index": 28, "checksum": "2266141887", "data": "        if self.mmproj_path and self.mmproj_path.exists():\n            cmd.extend([\"--mmproj\", str(s", "line_end": 145, "line_start": 140}, {"block_index": 29, "checksum": "2944939847", "data": "\n    async def start(self) -> bool:\n\n        \"\"\"Start the server subprocess and verify it launches s", "line_end": 150, "line_start": 145}, {"block_index": 30, "checksum": "2705697232", "data": "        Returns:\n            bool: True if started successfu