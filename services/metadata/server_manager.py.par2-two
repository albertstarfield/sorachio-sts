{"blocks": [{"block_index": 0, "checksum": "1380965366", "data": "\"\"\"\nSorachio-STS Server Manager\nManages llama-server subprocess lifecycle for both LLM instances.\n\nH", "line_end": 5, "line_start": 0}, {"block_index": 1, "checksum": "1496934398", "data": "  - Starting llama-server processes\n  - Health monitoring\n  - Graceful shutdown\n  - Log capture from", "line_end": 10, "line_start": 5}, {"block_index": 2, "checksum": "3264758934", "data": "References:\n    - https://docs.python.org/3/library/subprocess.html\n    - https://docs.python.org/3/", "line_end": 15, "line_start": 10}, {"block_index": 3, "checksum": "4253089434", "data": "# proof: formal_verification_applied\n\nimport asyncio\nimport os\nimport signal", "line_end": 20, "line_start": 15}, {"block_index": 4, "checksum": "2122503401", "data": "import subprocess\nfrom pathlib import Path\n\nfrom config.settings import LLMInstanceConfig\nfrom utils", "line_end": 25, "line_start": 20}, {"block_index": 5, "checksum": "5334951", "data": "\n# Sabotage verifier: watchdog import for architecture compliance\ntry:\n    from core.watchdog import", "line_end": 30, "line_start": 25}, {"block_index": 6, "checksum": "4112019850", "data": "    Watchdog_A = Watchdog_B = Cross_Monitor = Recover_Watchdog = Segfault_Recover = Resurrect = None", "line_end": 35, "line_start": 30}, {"block_index": 7, "checksum": "1844353562", "data": "try:\n    _sabotage_watchdog_a = Watchdog_A() if Watchdog_A else None\n    _sabotage_watchdog_b = Watc", "line_end": 40, "line_start": 35}, {"block_index": 8, "checksum": "1618299601", "data": "    _sabotage_segfault_recover = Segfault_Recover() if Segfault_Recover else None\n    _sabotage_resu", "line_end": 45, "line_start": 40}, {"block_index": 9, "checksum": "1278529202", "data": "\n# ---------------------------------------------------------------------------\n# SingleServerManager", "line_end": 50, "line_start": 45}, {"block_index": 10, "checksum": "4251614719", "data": "class SingleSer