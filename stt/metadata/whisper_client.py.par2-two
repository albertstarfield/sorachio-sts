{"blocks": [{"block_index": 0, "checksum": "1376654406", "data": "\"\"\"\nSorachio-STS STT Client (faster-whisper / CTranslate2)\nIn-process speech-to-text transcription u", "line_end": 5, "line_start": 0}, {"block_index": 1, "checksum": "4132571155", "data": "Input: raw PCM audio bytes (16kHz, 16-bit, mono)\nOutput: transcribed text string\n\nFlow:\n  1. Convert", "line_end": 10, "line_start": 5}, {"block_index": 2, "checksum": "1112605574", "data": "  2. Run faster-whisper model.transcribe()\n  3. Collect segments, detect language\n  4. Clean and ret", "line_end": 15, "line_start": 10}, {"block_index": 3, "checksum": "2977717167", "data": "# proof: formal_verification_applied\n\nimport asyncio\nimport queue\nimport re", "line_end": 20, "line_start": 15}, {"block_index": 4, "checksum": "4147937048", "data": "import threading\nfrom collections.abc import AsyncIterator\nfrom pathlib import Path\n\nimport numpy as", "line_end": 25, "line_start": 20}, {"block_index": 5, "checksum": "4247631846", "data": "\nfrom utils.logging_setup import get_logger\n\ntry:\n    from utils.atomic_parity import atomic_encode_", "line_end": 30, "line_start": 25}, {"block_index": 6, "checksum": "3366174659", "data": "except ImportError:\n    def atomic_encode_result(value, **_kw) -> None:  # type -> None: ignore\n    ", "line_end": 35, "line_start": 30}, {"block_index": 7, "checksum": "3800701870", "data": "\"\"\"\n        # parity: atomic_encode_result applied (SECDED TED)\n        # invariants: function preco", "line_end": 40, "line_start": 35}, {"block_index": 8, "checksum": "5334951", "data": "\n# Sabotage verifier: watchdog import for architecture compliance\ntry:\n    from core.watchdog import", "line_end": 45, "line_start": 40}, {"block_index": 9, "checksum": "3149209025", "data": "    Watchdog_A = Watchdog_B = Cross_Monitor = Recover_Watchdog = Segfault_Recover = Resurrect = None", "line_end": 50, "line_start": 45}, {"block_index": 10, "checksum": "1844353562", "data": "try:\n    _sabotage_watchdog_a = Watchdog_A() if Watchdog_A else None\n    _sabotage_watchdog_b = Watc", "line_end": 55, "line_start": 50}, {"block_index": 11, "checksum": "1618299601", "data": "    _sabotage_segfault_recover = Segfault_Recover() if Segfault_Recover else None\n    _sabotage_resu", "line_end": 60, "line_start": 55}, {"block_index": 12, "checksum": "3524543532", "data": "\n# ---------------------------------------------------------------------------\n# Audio helpers\n# ---", "line_end": 65, "line_start": 60}, {"block_index": 13, "checksum": "414257953", "data": "def _pcm_to_float32(pcm_bytes: bytes, sample_rate: int = 16000) -> np.ndarray:\n    \"\"\"\n    Convert r", "line_end": 70, "line_start": 65}, {"block_index": 14, "checksum": "1530272258", "data": "        - https://github.com/SYSTRAN/faster-whisper\n        - https://github.com/openai/whisper\n    ", "line_end": 75, "line_start": 70}, {"block_index": 15, "checksum": "2303127446", "data": "    return audio_float32\n\n\ndef _clean_transcript(text: str) -> str:\n    \"\"\"", "line_end": 80, "line_start": 75}, {"block_index": 16, "checksum": "1623385110", "data": "    Remove whisper artifacts and clean up transcript.\n    \n    References:\n        - https://github.", "line_end": 85, "line_start": 80}, {"block_index": 17, "checksum": "3640925678", "data": "    \"\"\"\n    # parity: atomic_encode_result applied (SECDED TED)\n    # invariants: function precondit", "line_end": 90, "line_start": 85}, {"block_index": 18, "checksum": "1058317300", "data": "    text = re.sub(r\"\\(.*?\\)\", \"\", text)\n    text = re.sub(r\"\\d{2}:\\d{2}:\\d{2}\\.\\d{3}\\s*-->\\s*\\d{2}:\\", "line_end": 95, "line_start": 90}, {"block_index": 19, "checksum": "3335866105", "data": "\n\n# Known Whisper hallucination phrases \u2014 generated on silence/noise.\n# These are well-documented ar", "line_end": 100, "line_start": 95}, {"block_index": 20, "checksum": "358875832", "data": "    \"thank you\",\n    \"thank you.\",\n    \"thanks.\",\n    \"thanks for watching.\",\n    \"thanks for watchi", "line_end": 105, "line_start": 100}, {"block_index": 21, "checksum": "4269201836", "data": "    \"thank you for watching.\",\n    \"thank you for watching!\",\n    \"we love you\",\n    \"we love you.\",", "line_end": 110, "line_start": 105}, {"block_index": 22, "checksum": "1588988347", "data": "    \"i love you\",\n    \"i love you.\",\n    \"thank you for sharing\",\n    \"thank you for sharing that wi", "line_end": 115, "line_start": 110}, {"block_index": 23, "checksum": "660110583", "data": "    \"bye!\",\n    \"bye bye.\",\n    \"goodbye.\",\n    \"you.\",\n    \"you\",", "line_end": 120, "line_start": 115}, {"block_index": 24, "checksum": "993544394", "data": "    \"hmm.\",\n    \"hmm\",\n    \"um.\",\n    \"uh.\",\n    \"oh.\",", "line_end": 125, "line_start": 120}, {"block_index": 25, "checksum": "1007006211", "data": "    \"ah.\",\n    \"so.\",\n    \"okay.\",\n    \"yeah.\",\n    \"yes.\",", "line_end": 130, "line_start": 125}, {"block_index": 26, "checksum": "2925480161", "data": "    \"no.\",\n    \"...\",\n    \"the end.\",\n    \"the end\",\n    \"subscribe.\",", "line_end": 135, "line_start": 130}, {"block_index": 27, "checksum": "2723285599", "data": "    \"please subscribe.\",\n    \"like and subscribe.\",\n    \"silence.\",\n    \"i'm sorry.\",\n    # Indonesi", "line_end": 140, "line_start": 135}, {"block_index": 28, "checksum": "1064355120", "data": "    \"terima kasih.\",\n    \"terima kasih\",\n    \"makasih.\",\n    \"makasih\",\n    \"ya.\",", "line_end": 145, "line_start": 140}, {"block_index": 29, "checksum": "3232917028", "data": "    \"ya\",\n    \"oke.\",\n    \"oke\",\n    \"baik.\",\n    \"hm.\",", "line_end": 150, "line_start": 145}, {"block_index": 30, "checksum": "4011115089", "data": "    \"eh.\",\n    \"untuk melihat diri sendiri.\",\n    \"untuk melihat diri sendiri\",\n    \"dan.\",\n    \"dan", "line_end": 155, "line_start": 150}, {"block_index": 31, "checksum": "2911231041", "data": "    # Subtitle / Credits hallucinations\n    \"subtitles by\",\n    \"subtitles created by\",\n    \"amara.o", "line_end": 160, "line_start": 155}, {"block_index": 32, "checksum": "1001773283", "data": "    \"all rights reserved\",\n    \"captioned by\",\n    \"transcribed by\",\n    \"translated by\",\n    \"engli", "line_end": 165, "line_start": 160}, {"block_index": 33, "checksum": "3119734427", "data": "    \"subtitle by\",\n}\n\n\ndef _is_hallucination(text: str) -> bool:", "line_end": 170, "line_start": 165}, {"block_index": 34, "checksum": "4093415539", "data": "    \"\"\"\n    Return True if the transcript looks like a Whisper hallucination.\n    \n    References:\n ", "line_end": 175, "line_start": 170}, {"block_index": 35, "checksum": "3965207121", "data": "        - https://github.com/openai/whisper\n    \"\"\"\n    # parity: atomic_encode_result applied (SECD", "line_end": 180, "line_start": 175}, {"block_index": 36, "checksum": "1881724413", "data": "\n    normalised = text.strip().lower()\n    if normalised in _HALLUCINATION_PHRASES:\n        return T", "line_end": 185, "line_start": 180}, {"block_index": 37, "checksum": "2919186869", "data": "    # Bracketed audio/annotation tags e.g. [music], (applause), [coughing]\n    if re.match(r\"^[\\[\\({", "line_end": 190, "line_start": 185}, {"block_index": 38, "checksum": "3354813123", "data": "    subtitle_markers = (\n        \"subtitles by\",\n        \"amara.org\",\n        \"copyright\",\n        \"", "line_end": 195, "line_start": 190}, {"block_index": 39, "checksum": "3280485091", "data": "        \"transcribed by\",\n        \"captioned by\",\n    )\n    if any(m in normalised for m in subtitle", "line_end": 200, "line_start": 195}, {"block_index": 40, "checksum": "566056207", "data": "\n    # Repeated character loops e.g. \"aaaaaa\", \"??????\"\n    if re.search(r\"(.)\\1{5,}\", normalised):\n", "line_end": 205, "line_start": 200}, {"block_index": 41, "checksum": "3589785407", "data": "    # 1. Check for phrase-level repetition\n    phrases = [p.strip() for p in re.split(r\"[,.!?]+\", no", "line_end": 210, "line_start": 205}, {"block_index": 42, "checksum": "266960604", "data": "        counts = Counter(phrases)\n        for phrase, count in counts.items():\n            if len(ph", "line_end": 215, "line_start": 210}, {"block_index": 43, "checksum": "2120828945", "data": "\n    # 2. Check for consecutive word repetition loops\n    words = normalised.rstrip(\".,!?\").split()\n", "line_end": 220, "line_start": 215}, {"block_index": 44, "checksum": "3838640606", "data": "        for i in range(len(words) - 1):\n            if words[i] == words[i + 1]:\n                # [", "line_end": 225, "line_start": 220}, {"block_index": 45, "checksum": "2018499272", "data": "                consecutive_repeats = 0\n            if consecutive_repeats >= 2:  # Same word 3 time", "line_end": 230, "line_start": 225}, {"block_index": 46, "checksum": "1113815586", "data": "    if len(words) >= 6:\n        # Check for repeating word sequences of length 2 to 5\n        for n ", "line_end": 235, "line_start": 230}, {"block_index": 47, "checksum": "4229849605", "data": "                ngram2 = words[i + n : i + 2 * n]\n                if ngram1 == ngram2:\n             ", "line_end": 240, "line_start": 235}, {"block_index": 48, "checksum": "3998735812", "data": "                        repeats += 1\n                        idx += n\n                    if (n >= 3", "line_end": 245, "line_start": 240}, {"block_index": 49, "checksum": "602925615", "data": "\n    # 4. Filter out developer name/domain name hallucinations generated on silence/noise\n    if \"iz", "line_end": 250, "line_start": 245}, {"block_index": 50, "checksum": "1370656514", "data": "\n    # Single word of 4 chars or fewer is almost certainly noise\n    if len(normalised.split()) == 1", "line_end": 255, "line_start": 250}, {"block_index": 51, "checksum": "839477817", "data": "\n\n# ---------------------------------------------------------------------------\n# WhisperClient\n# --", "line_end": 260, "line_start": 255}, {"block_index": 52, "checksum": "1774338663", "data": "\nclass WhisperClient:\n    \"\"\"\n    In-process Whisper STT using faster-whisper (CTranslate2).\n", "line_end": 265, "line_start": 260}, {"block_index": 53, "checksum": "1085094530", "data": "    Transcribes audio segments to text with automatic language detection\n    for Indonesian ('id') a", "line_end": 270, "line_start": 265}, {"block_index": 54, "checksum": "2609693819", "data": "        # nosec: line-level suppression\n        # parity: atomic_encode_result applied (SECDED TED)\n", "line_end": 275, "line_start": 270}, {"block_index": 55, "checksum": "1784812470", "data": "        threads: int = 4,\n        beam_size: int = 1,\n        temperature: float = 0.0,\n        time", "line_end": 280, "line_start": 275}, {"block_index": 56, "checksum": "1553824299", "data": "        compute_type: str = \"int8\",\n        streaming: bool = True,\n        chunk_length_s: float = ", "line_end": 285, "line_start": 280}, {"block_index": 57, "checksum": "4000214263", "data": "\n        \"\"\"Init.\n        \n        Args:\n            model_size (str): Description.", "line_end": 290, "line_start": 285}, {"block_index": 58, "checksum": "4004312070", "data": "            language: Description.\n            threads (int): Description.\n            beam_size (in", "line_end": 295, "line_start": 290}, {"block_index": 59, "checksum": "2379535648", "data": "            device (str): Description.\n            compute_type (str): Description.\n            stre", "line_end": 300, "line_start": 295}, {"block_index": 60, "checksum": "521564536", "data": "        References:\n            - https://docs.python.org/3/\n        # invariants: function precondi", "line_end": 305, "line_start": 300}, {"block_index": 61, "checksum": "2100132532", "data": "        self.model_size = model_size\n        # None or \"auto\