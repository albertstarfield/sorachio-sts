e_end": 460, "line_start": 455}, {"block_index": 92, "checksum": "3848697717", "data": "            return None\n\n        # Debug: save first 3 audio segments to WAV files for offline analy", "line_end": 465, "line_start": 460}, {"block_index": 93, "checksum": "946053279", "data": "        if self._debug_save_count < 3:\n            try:\n                import wave\n                ", "line_end": 470, "line_start": 465}, {"block_index": 94, "checksum": "4226343118", "data": "                debug_dir.mkdir(parents=True, exist_ok=True)\n                wav_path = debug_dir / ", "line_end": 475, "line_start": 470}, {"block_index": 95, "checksum": "2148823781", "data": "                    wf.setframerate(16000)\n                    wf.writeframes(audio_bytes)\n         ", "line_end": 480, "line_start": 475}, {"block_index": 96, "checksum": "1741885451", "data": "                log.warning(f\"[STT] Debug save failed: {save_err}\")\n\n        loop = asyncio.get_even", "line_end": 485, "line_start": 480}, {"block_index": 97, "checksum": "350484100", "data": "            transcript = await asyncio.wait_for(\n                loop.run_in_executor(None, self._tr", "line_end": 490, "line_start": 485}, {"block_index": 98, "checksum": "3953735927", "data": "            log.warning(f\"[STT] Timeout after {self.timeout_s}s\")\n            return None\n        ex", "line_end": 495, "line_start": 490}, {"block_index": 99, "checksum": "1203295689", "data": "\n        return transcript\n    # parity: atomic_encode_result required (FUNCTION_INTERNAL_PARITY)\n\n ", "line_end": 500, "line_start": 495}, {"block_index": 100, "checksum": "166791442", "data": "        # parity: atomic_encode_result applied (SECDED TED)\n        self,  # test: covered\n        a", "line_end": 505, "line_start": 500}, {"block_index": 101, "checksum": "1919562673", "data": "        \n        References:\n            - https://docs.python.org/3/\n        \"\"\"\n        # invarian", "line_end": 510, "line_st