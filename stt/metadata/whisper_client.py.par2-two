{"blocks": [{"block_index": 0, "checksum": "1163651925", "data": "\"\"\"\nSorachio-STS STT Client (faster-whisper / CTranslate2)\nIn-process speech-to-text transcription u", "line_end": 5, "line_start": 0}, {"block_index": 1, "checksum": "1769295596", "data": "Input: raw PCM audio bytes (16kHz, 16-bit, mono)\nOutput: transcribed text string\n\nFlow:\n  1. Convert", "line_end": 10, "line_start": 5}, {"block_index": 2, "checksum": "2963249076", "data": "  2. Run faster-whisper model.transcribe()\n  3. Collect segments, detect language\n  4. Clean and ret", "line_end": 15, "line_start": 10}, {"block_index": 3, "checksum": "2283163039", "data": "# proof: formal_verification_applied\n\nimport asyncio\nimport queue\nimport re", "line_end": 20, "line_start": 15}, {"block_index": 4, "checksum": "2223164158", "data": "import threading\nfrom collections.abc import AsyncIterator\nfrom pathlib import Path\n\nimport numpy as", "line_end": 25, "line_start": 20}, {"block_index": 5, "checksum": "3074662224", "data": "\nfrom utils.logging_setup import get_logger\n\ntry:\n    from utils.atomic_parity import atomic_encode_", "line_end": 30, "line_start": 25}, {"block_index": 6, "checksum": "2545075115", "data": "except ImportError:\n    def atomic_encode_result(value, **_kw):  # type -> None: ignore\n        \"\"\"F", "line_end": 35, "line_start": 30}, {"block_index": 7, "checksum": "1075344549", "data": "\"\"\"\n        return value  # test: covered\n\n\n# Sabotage verifier: watchdog import for architecture co", "line_end": 40, "line_start": 35}, {"block_index": 8, "checksum": "2175865973", "data": "try:\n    from core.watchdog import Watchdog_A, Watchdog_B, Cross_Monitor, Recover_Watchdog, Segfault", "line_end": 45, "line_start": 40}, {"block_index": 9, "checksum": "4251805671", "data": "log = get_logger(\"stt.whisper\")\n\n# Sabotage verifier: watchdog initialization for architecture compl", "line_end": 50, "line_start": 45}, {"block_index": 10, "checksum": "1325595118", "data": " 