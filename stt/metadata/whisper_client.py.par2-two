s for watching!\",\n    \"thank you for watching.\",\n    \"thank you for watching!\",\n    \"we lo", "line_end": 105, "line_start": 100}, {"block_index": 21, "checksum": "4266142563", "data": "    \"we love you too\",\n    \"i love you\",\n    \"i love you.\",\n    \"thank you for sharing\",\n    \"thank ", "line_end": 110, "line_start": 105}, {"block_index": 22, "checksum": "4220932911", "data": "    \"bye.\",\n    \"bye!\",\n    \"bye bye.\",\n    \"goodbye.\",\n    \"you.\",", "line_end": 115, "line_start": 110}, {"block_index": 23, "checksum": "2466096637", "data": "    \"you\",\n    \"hmm.\",\n    \"hmm\",\n    \"um.\",\n    \"uh.\",", "line_end": 120, "line_start": 115}, {"block_index": 24, "checksum": "990426662", "data": "    \"oh.\",\n    \"ah.\",\n    \"so.\",\n    \"okay.\",\n    \"yeah.\",", "line_end": 125, "line_start": 120}, {"block_index": 25, "checksum": "2614897198", "data": "    \"yes.\",\n    \"no.\",\n    \"...\",\n    \"the end.\",\n    \"the end\",", "line_end": 130, "line_start": 125}, {"block_index": 26, "checksum": "1156996165", "data": "    \"subscribe.\",\n    \"please subscribe.\",\n    \"like and subscribe.\",\n    \"silence.\",\n    \"i'm sorry", "line_end": 135, "line_start": 130}, {"block_index": 27, "checksum": "3111113477", "data": "    # Indonesian hallucinations\n    \"terima kasih.\",\n    \"terima kasih\",\n    \"makasih.\",\n    \"makasi", "line_end": 140, "line_start": 135}, {"block_index": 28, "checksum": "919051998", "data": "    \"ya.\",\n    \"ya\",\n    \"oke.\",\n    \"oke\",\n    \"baik.\",", "line_end": 145, "line_start": 140}, {"block_index": 29, "checksum": "911048485", "data": "    \"hm.\",\n    \"eh.\",\n    \"untuk melihat diri sendiri.\",\n    \"untuk melihat diri sendiri\",\n    \"dan.", "line_end": 150, "line_start": 145}, {"block_index": 30, "checksum": "699362633", "data": "    \"dan\",\n    # Subtitle / Credits hallucinations\n    \"subtitles by\",\n    \"subtitles created by\",\n ", "line_end": 155, "line_start": 150}, {"block_index": 31, "checksum": "3805201931", "data": "    \"copyright\",\n    \"all rights reserved\",\n    \"captioned by\",\n    \"transcribed by\",\n    \"translate", "line_end": 160, "line_start": 155}, {"block_index": 32, "checksum": "1925227649", "data": "    \"english subtitles\",\n    \"subtitle by\",\n}\n\n", "line_end": 165, "line_start": 160}, {"block_index": 33, "checksum": "125575466", "data": "def _is_hallucination(text: str) -> bool:\n    \"\"\"\n    Return True if the transcript looks like a Whi", "line_end": 170, "line_start": 165}, {"block_index": 34, "checksum": "2616308407", "data": "        - https://github.com/SYSTRAN/faster-whisper\n        - https://github.com/openai/whisper\n    ", "line_end": 175, "line_start": 170}, {"block_index": 35, "checksum": "2089316790", "data": "    normalised = text.strip().lower()\n    if normalised in _HALLUCINATION_PHRASES:\n        return Tr", "line_end": 180, "line_start": 175}, {"block_index": 36, "checksum": "1504879532", "data": "    if re.match(r\"^[\\[\\({].*?[\\]\\)}]$\", normalised):\n        return True\n\n    # Subtitle / Credits m", "line_end": 185, "line_start": 180}, {"block_index": 37, "checksum": "2184038458", "data": "        \"subtitles by\",\n        \"amara.org\",\n        \"copyright\",\n        \"all rights reserved\",\n   ", "line_end": 190, "line_start": 185}, {"block_index": 38, "checksum": "2737746010", "data": "        \"captioned by\",\n    )\n    if any(m in normalised for m in subtitle_markers):\n        return ", "line_end": 195, "line_start": 190}, {"block_index": 39, "checksum": "4273392211", "data": "    # Repeated character loops e.g. \"aaaaaa\", \"??????\"\n    if re.search(r\"(.)\\1{5,}\", normalised):\n ", "line_end": 200, "line_start": 195}, {"block_index": 40, "checksum": "3795838845", "data": "    phrases = [p.strip() for p in re.split(r\"[,.!?]+\", normalised) if p.strip()]\n    if len(phrases)", "line_end": 205, "line_start": 200}, {"block_index": 41, "