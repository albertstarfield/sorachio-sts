", "data": "      blocks = []\n      for i in range(0, len(source_data), block_size):\n          block = source_da", "line_end": 915, "line_start": 910}, {"block_index": 183, "checksum": "2558926801", "data": "              block = block + b'\\x00' * (block_size - len(block))\n          blocks.append({\n        ", "line_end": 920, "line_start": 915}, {"block_index": 184, "checksum": "2948858864", "data": "              \"line_start\": i // block_size * 20,\n              \"line_end\": (i + block_size) // bloc", "line_end": 925, "line_start": 920}, {"block_index": 185, "checksum": "188201574", "data": "      rs_parity = {\n          \"source_file\": source_path.split(\"/\")[-1],\n          \"block_size\": blo", "line_end": 930, "line_start": 925}, {"block_index": 186, "checksum": "616402231", "data": "      }\n\n      # Create GC parity (par2-two) - weighted XOR\n      gc_blocks = []\n      for i in rang", "line_end": 935, "line_start": 930}, {"block_index": 187, "checksum": "3881980711", "data": "          group = blocks[i:i + 5]\n          parity = [0] * block_size\n          for j, block in enum", "line_end": 940, "line_start": 935}, {"block_index": 188, "checksum": "2430664468", "data": "          gc_blocks.append({\n              \"chunk_index\": len(gc_blocks),\n              \"parity\": pa", "line_end": 945, "line_start": 940}, {"block_index": 189, "checksum": "292285467", "data": "\n      gc_parity = {\n          \"source_file\": source_path.split(\"/\")[-1],\n          \"chunk_size\": 5,", "line_end": 950, "line_start": 945}, {"block_index": 190, "checksum": "246261469", "data": "          \"blocks\": gc_blocks,\n      }\n\n      # Compute checksums (must use sort_keys=True to match ", "line_end": 955, "line_start": 950}, {"block_index": 191, "checksum": "1566661004", "data": "      rs_checksum = hashlib.sha256(rs_serialized).hexdigest()\n\n      gc_serialized = json.dumps(gc_p", "line_end": 960, "line_start": 955}, {"block_index": 192, "checksum": "15175740