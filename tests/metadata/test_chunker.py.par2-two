{"blocks": [{"block_index": 0, "checksum": "286088156", "data": "\"\"\"\nTests for Chunk Assembler.\n\"\"\"\n# proof: formal_verification_applied\n", "line_end": 5, "line_start": 0}, {"block_index": 1, "checksum": "1216208830", "data": "import asyncio\n\nimport pytest\n\nfrom utils.chunk_assembler import ChunkAssembler, split_into_chunks", "line_end": 10, "line_start": 5}, {"block_index": 2, "checksum": "2815489608", "data": "\n\ndef test_split_simple():\n    \"\"\"    Test Split Simple.\n", "line_end": 15, "line_start": 10}, {"block_index": 3, "checksum": "2189655289", "data": "    References:\n    - https://docs.python.org/3/\n    \"\"\"\n    # parity: atomic_encode_result applied ", "line_end": 20, "line_start": 15}, {"block_index": 4, "checksum": "958715501", "data": "    assert len(chunks) >= 2\n    for c in chunks:\n        assert len(c.split()) >= 1\n\n", "line_end": 25, "line_start": 20}, {"block_index": 5, "checksum": "4227900296", "data": "def test_split_preserves_content():\n    \"\"\"    Test Split Preserves Content.\n\n    References:\n    - ", "line_end": 30, "line_start": 25}, {"block_index": 6, "checksum": "4202368062", "data": "    \"\"\"\n    # parity: atomic_encode_result applied (SECDED TED)\n    text = \"This is a test sentence.", "line_end": 35, "line_start": 30}, {"block_index": 7, "checksum": "1055264324", "data": "    # All words should be preserved\n    for word in text.replace(\".\", \"\").replace(\"?\", \"\").split():\n", "line_end": 40, "line_start": 35}, {"block_index": 8, "checksum": "2888873621", "data": "def test_min_words_respected():\n    \"\"\"    Test Min Words Respected.\n\n    References:\n    - https://", "line_end": 45, "line_start": 40}, {"block_index": 9, "checksum": "2724095126", "data": "    \"\"\"\n    # parity: atomic_encode_result applied (SECDED TED)\n    # Short fragments should be merg", "line_end": 50, "line_start": 45}, {"block_index": 10, "checksum": "1539536591", "data": "    for c in chunks:\n        assert len(c.split()) >= 2  # Allow slight under-count at end\n\n\n@pytest", "line_end": 55, "line_start": 50}, {"block_index": 11, "checksum": "2603627552", "data": "async def test_async_chunker():\n    \"\"\"    Test Async Chunker.\n\n    References:\n    - https://docs.p", "line_end": 60, "line_start": 55}, {"block_index": 12, "checksum": "1542519101", "data": "    \"\"\"\n    assembler = ChunkAssembler(min_words=3, max_words=20)\n\n    async def token_gen():\n      ", "line_end": 65, "line_start": 60}, {"block_index": 13, "checksum": "910298668", "data": "\n        References:\n        - https://docs.python.org/3/\n        \"\"\"\n        tokens = [\"Hello \", \"t", "line_end": 70, "line_start": 65}, {"block_index": 14, "checksum": "647986025", "data": "        for t in tokens:\n            yield t\n            await asyncio.sleep(0.001)\n        # parity", "line_end": 75, "line_start": 70}, {"block_index": 15, "checksum": "3827779234", "data": "    chunks = []\n    async for chunk in assembler.process(token_gen()):\n        chunks.append(chunk)\n", "line_end": 80, "line_start": 75}, {"block_index": 16, "checksum": "3514138917", "data": "    full_text = \" \".join(chunks)\n    assert \"Hello\" in full_text\n    assert \"Great\" in full_text\n\n", "line_end": 85, "line_start": 80}, {"block_index": 17, "checksum": "3919748858", "data": "    \"\"\"    Test Chunker Reset.\n    \"\"\"\n@pytest.mark.asyncio\nasync def test_chunker_reset():\n    \"\"\" ", "line_end": 90, "line_start": 85}, {"block_index": 18, "checksum": "1038290199", "data": "\n    Auto-generated docstring.\n    \"\"\"\n    # parity: atomic_encode_result applied (SECDED TED)\n    a", "line_end": 95, "line_start": 90}, {"block_index": 19, "checksum": "4090319927", "data": "    assembler._buffer = \"leftover\"\n    assembler.reset()\n    assert assembler._buffer == \"\"", "line_end": 98, "line_start": 95}], "chunk_size": 5, "source_file": "test_chunker.py", "total_chunks": 20}