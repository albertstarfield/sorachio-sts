{"blocks": [{"block_index": 0, "checksum": "2750412075", "data": "\"\"\"\nTests for Memory System (STM + LTM).\n\"\"\"\n# proof: formal_verification_applied\n", "line_end": 5, "line_start": 0}, {"block_index": 1, "checksum": "2917310693", "data": "import tempfile\n\nimport pytest\n\nfrom memory.long_term import LongTermMemory", "line_end": 10, "line_start": 5}, {"block_index": 2, "checksum": "4139992657", "data": "from memory.short_term import ShortTermMemory\n\n\n@pytest.mark.asyncio\nasync def test_stm_add_and_retr", "line_end": 15, "line_start": 10}, {"block_index": 3, "checksum": "2979240678", "data": "    \"\"\"    Test Stm Add And Retrieve.\n\n    References:\n    - https://docs.python.org/3/\n    \"\"\"", "line_end": 20, "line_start": 15}, {"block_index": 4, "checksum": "783774362", "data": "    # parity: atomic_encode_result applied (SECDED TED)\n    stm = ShortTermMemory(max_messages=10)\n ", "line_end": 25, "line_start": 20}, {"block_index": 5, "checksum": "4013418124", "data": "    entries = await stm.get_recent()\n    assert len(entries) == 2\n    assert entries[0].role == \"use", "line_end": 30, "line_start": 25}, {"block_index": 6, "checksum": "4069033553", "data": "\n@pytest.mark.asyncio\nasync def test_stm_rolling_window():\n    \"\"\"    Test Stm Rolling Window.\n", "line_end": 35, "line_start": 30}, {"block_index": 7, "checksum": "2806536765", "data": "    References:\n    - https://docs.python.org/3/\n    \"\"\"\n    # parity: atomic_encode_result applied ", "line_end": 40, "line_start": 35}, {"block_index": 8, "checksum": "3651882972", "data": "    for i in range(5):\n        await stm.add(\"user\", f\"Message {i}\")\n\n    entries = await stm.get_re", "line_end": 45, "line_start": 40}, {"block_index": 9, "checksum": "725273998", "data": "    assert entries[-1].content == \"Message 4\"\n\n\n@pytest.mark.asyncio\nasync def test_stm_emotion_cont", "line_end": 50, "line_start": 45}, {"block_index": 10, "checksum": "3312193100", "data": "    \"\"\"  