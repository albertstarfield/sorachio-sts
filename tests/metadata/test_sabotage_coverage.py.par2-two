um": "2190167571", "data": "\n    -- CITATIONS --\n    - Reed, I.S. & Solomon, G. (1960) Polynomial Codes over Certain Finite Fiel", "line_end": 1395, "line_start": 1390}, {"block_index": 279, "checksum": "3085219918", "data": "    Args:\n        source_path: Path to the source file\n\n    Returns:\n        True if parity is valid", "line_end": 1400, "line_start": 1395}, {"block_index": 280, "checksum": "652657633", "data": "    \"\"\"\n    # parity: atomic_encode_result applied (SECDED TED)\n    # invariants: function precondit", "line_end": 1405, "line_start": 1400}, {"block_index": 281, "checksum": "2838001602", "data": "    import os\n\n    source_dir = os.path.dirname(source_path)\n    metadata_dir = os.path.join(source_", "line_end": 1410, "line_start": 1405}, {"block_index": 282, "checksum": "3190970326", "data": "\n    # Check metadata directory exists\n    if not os.path.isdir(metadata_dir):\n        return False\n", "line_end": 1415, "line_start": 1410}, {"block_index": 283, "checksum": "1425001247", "data": "    # Check required files exist\n    rs_path = os.path.join(metadata_dir, f\"{source_filename}.par2-o", "line_end": 1420, "line_start": 1415}, {"block_index": 284, "checksum": "1017709749", "data": "    if not all(os.path.isfile(p) for p in [rs_path, gc_path, meta_path]):\n        return False\n\n    ", "line_end": 1425, "line_start": 1420}, {"block_index": 285, "checksum": "1589250829", "data": "        with open(rs_path) as f:\n            rs_data = json.load(f)\n        with open(gc_path) as f:", "line_end": 1430, "line_start": 1425}, {"block_index": 286, "checksum": "2390358201", "data": "            meta = json.load(f)\n\n        # Check \"blocks\" key exists\n        if \"blocks\" not in rs_d", "line_end": 1435, "line_start": 1430}, {"block_index": 287, "checksum": "1452121936", "data": "\n        # Verify checksums\n        rs_serialized = json.dumps(rs_data, sort_keys=True).encode()\n   ", "line_end": 1440, "line_start": 1435}, {"block_index"