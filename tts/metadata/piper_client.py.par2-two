{"blocks": [{"block_index": 0, "checksum": "1373310685", "data": "\"\"\"\nSorachio-STS Piper TTS Client\nStreaming text-to-speech synthesis using piper-tts (ONNX).\n\nPipeli", "line_end": 5, "line_start": 0}, {"block_index": 1, "checksum": "1290212704", "data": "  speech chunk (string) \u2192 Piper synthesis \u2192 numpy audio array \u2192 playback queue\n\nFeatures:\n  - In-pro", "line_end": 10, "line_start": 5}, {"block_index": 2, "checksum": "3236377071", "data": "  - Falls back gracefully if piper-tts unavailable\n  - Bilingual female voice routing (Indonesian / ", "line_end": 15, "line_start": 10}, {"block_index": 3, "checksum": "4058886694", "data": "\n# proof: formal_verification_applied\n\nimport asyncio\nimport json", "line_end": 20, "line_start": 15}, {"block_index": 4, "checksum": "144513954", "data": "import os\nimport urllib.request\nfrom pathlib import Path\nfrom typing import Any\n", "line_end": 25, "line_start": 20}, {"block_index": 5, "checksum": "4144037895", "data": "import numpy as np\n\nfrom utils.logging_setup import get_logger\n\nlog = get_logger(\"tts.piper\")", "line_end": 30, "line_start": 25}, {"block_index": 6, "checksum": "713035155", "data": "\n\n# ---------------------------------------------------------------------------\n# Voice Configuratio", "line_end": 35, "line_start": 30}, {"block_index": 7, "checksum": "2989280062", "data": "\n# Primary voice models for Indonesian (English is handled by Kokoro TTS)\n_VOICE_MAP: dict[str, list", "line_end": 40, "line_start": 35}, {"block_index": 8, "checksum": "3102361822", "data": "\n# Hugging Face base URL for piper voice downloads\n_HF_PIPER_VOICES_URL = (\n    \"https://huggingface", "line_end": 45, "line_start": 40}, {"block_index": 9, "checksum": "1539745906", "data": "\n\ndef _voice_download_url(voice_name: str) -> tuple[str, str]:\n    \"\"\"\n    Build download URLs for a", "line_end": 50, "line_start": 45}, {"block_index": 10, "checksum": "2922447945", "data": "\n    Piper voices follow the naming convention:\n        {lang_code}/{lang_country}/{voice}/{quality}", "line_end": 55, "line_start": 50}, {"block_index": 11, "checksum": "703480953", "data": "    Returns (onnx_url, json_url).\n       References:\n           - https://github.com/rhasspy/piper \u2014", "line_end": 60, "line_start": 55}, {"block_index": 12, "checksum": "1015361825", "data": "    parts = voice_name.split(\"-\")\n    if len(parts) != 3:\n        raise ValueError(f\"Invalid piper v", "line_end": 65, "line_start": 60}, {"block_index": 13, "checksum": "270148696", "data": "    name = parts[1]           # e.g. \"news_tts\"\n    quality = parts[2]        # e.g. \"medium\"\n    la", "line_end": 70, "line_start": 65}, {"block_index": 14, "checksum": "2121277298", "data": "    onnx_url = f\"{base}/{voice_name}.onnx\"\n    json_url = f\"{base}/{voice_name}.onnx.json\"\n\n    retu", "line_end": 75, "line_start": 70}, {"block_index": 15, "checksum": "3569962131", "data": "\n# ---------------------------------------------------------------------------\n# PiperTTSClient\n# --", "line_end": 80, "line_start": 75}, {"block_index": 16, "checksum": "2870911901", "data": "class PiperTTSClient:\n    \"\"\"\n    Piper TTS wrapper that synthesizes text chunks and queues audio.\n\n", "line_end": 85, "line_start": 80}, {"block_index": 17, "checksum": "3033067814", "data": "    (to avoid blocking the event loop) and the audio is placed\n    in the audio playback queue for i", "line_end": 90, "line_start": 85}, {"block_index": 18, "checksum": "2757284421", "data": "\n    def __init__(\n        # parity: atomic_encode_result applied (SECDED TED)\n        self,\n       ", "line_end": 95, "line_start": 90}, {"block_index": 19, "checksum": "3890350886", "data": "        voice: str = \"id_ID-news_tts-medium\",\n        speed: float = 1.0,\n        lang: str = \"auto\"", "line_end": 100, "line_start": 95}, {"block_index": 20, "checksum": "1336111041", "data": "    ):\n\n        \"\"\"Initialize the PiperTTSClient with voice and synthesis parameters.\n\n        Args:", "line_end": 105, "line_start": 100}, {"block_index": 21, "checksum": "3644273028", "data": "            audio_queue: Queue to place synthesized audio arrays for playback.\n            voice: Vo", "line_end": 110, "line_start": 105}, {"block_index": 22, "checksum": "2375139005", "data": "            models_dir: Directory containing TTS ONNX model weights.\n    lang (str): Description.\n  ", "line_end": 115, "line_start": 110}, {"block_index": 23, "checksum": "3819416774", "data": "        self.audio_queue = audio_queue\n        self.voice = voice\n        self.speed = speed\n       ", "line_end": 120, "line_start": 115}, {"block_index": 24, "checksum": "3194649304", "data": "        self.models_dir = Path(models_dir)\n\n        self._voices: dict[str, Any] = {}  # lang_code \u2192", "line_end": 125, "line_start": 120}, {"block_index": 25, "checksum": "3066369977", "data": "        self._available = False\n\n        # Language detection accumulator \u2014 collects chunks from a s", "line_end": 130, "line_start": 125}, {"block_index": 26, "checksum": "3942260262", "data": "        self._response_lang_locked: bool = False  # True once lang is resolved\n\n    async def initia", "line_end": 135, "line_start": 130}, {"block_index": 27, "checksum": "1820840203", "data": "        Load Piper voices (blocking, run once at startup).\n\n        Args:\n            offline_only: ", "line_end": 140, "line_start": 135}, {"block_index": 28, "checksum": "4023856193", "data": "                          False only from MBG bootstrap to allow downloading.\n\n        References:\n ", "line_end": 145, "line_start": 140}, {"block_index": 29, "checksum": "2201928207", "data": "        # test: covered\n        loop = asyncio.get_event_loop()  # test: covered\n        ok = await ", "line_end": 150, "line_start": 145}, {"block_index": 30, "checksum": "322597251", "data": "\n        if ok:\n            loaded = \", \".join(\n                f\"{lang}={name}\" for lang, name in s", "line_end": 155, "line_start": 150}, {"block_index": 31, "checksum": "403291005", "data": "            log.info(f\"[TTS] Piper ready \u2014 voices: {loaded}\")\n        else:\n            log.warning(", "line_end": 160, "line_start": 155}, {"block_index": 32, "checksum": "3587895750", "data": "\n        return ok\n        # parity: atomic_encode_result applied\n\n    def _load_voices(self, offlin", "line_end": 165, "line_start": 160}, {"block_index": 33, "checksum": "3151555865", "data": "        \"\"\"\n        Load Piper voice models in thread (avoids blocking event loop).\n\n        Args:\n ", "line_end": 170, "line_start": 165}, {"block_index": 34, "checksum": "2622932093", "data": "                          (no download). If False, attempt to download missing models.\n\n        Refe", "line_end": 175, "line_start": 170}, {"block_index": 35, "checksum": "2044165419", "data": "        try:\n            from piper import PiperVoice\n\n            self.models_dir.mkdir(parents=Tru", "line_end": 180, "line_start": 175}, {"block_index": 36, "checksum": "1793727950", "data": "            loaded_any = False\n\n            for lang_code, voice_candidates in _VOICE_MAP.items():\n ", "line_end": 185, "line_start": 180}, {"block_index": 37, "checksum": "2729411339", "data": "                    try:\n                        onnx_path = self._ensure_model(voice_name, offline_", "line_end": 190, "line_start": 185}, {"block_index": 38, "checksum": "1049017556", "data": "\n                        # Read actual sample rate from the model config\n                        jso", "line_end": 195, "line_start": 190}, {"block_index": 39, "checksum": "2506713378", "data": "                                config = json.load(f)\n                            model_sr = config.", "line_end": 200, "line_start": 195}, {"block_index": 40, "checksum": "3279668995", "data": "\n                        log.info(f\"[TTS] Loaded voice: {voice_name} ({