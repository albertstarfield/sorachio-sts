\", e)\n            return None\n\n   ", "line_end": 410, "line_start": 405}, {"block_index": 82, "checksum": "644909253", "data": "        Clean problematic text before sending to Piper.\n        Prevents crashes from special charac", "line_end": 415, "line_start": 410}, {"block_index": 83, "checksum": "394017801", "data": "        \"\"\"\n        # parity: atomic_encode_result applied (SECDED TED)\n        # invariants: functi", "line_end": 420, "line_start": 415}, {"block_index": 84, "checksum": "2432342593", "data": "            return \"\"\n\n        text = text.strip()\n\n        # Remove problematic control chars", "line_end": 425, "line_start": 420}, {"block_index": 85, "checksum": "3077979378", "data": "        text = \"\".join(ch for ch in text if ord(ch) >= 32)\n\n        # Replace problematic formatting", "line_end": 430, "line_start": 425}, {"block_index": 86, "checksum": "453330", "data": "            \"#\": \"\",\n            \"`\": \"\",\n            \"_\": \" \",\n            \"~\": \"\",\n            \"|\"", "line_end": 435, "line_start": 430}, {"block_index": 87, "checksum": "576913119", "data": "            \"[\": \"\",\n            \"]\": \"\",\n            \"{\": \"\",\n            \"}\": \"\",\n            \"<\":", "line_end": 440, "line_start": 435}, {"block_index": 88, "checksum": "588038678", "data": "            \">\": \"\",\n        }\n\n        for old, new in replacements.items():\n            text = tex", "line_end": 445, "line_start": 440}, {"block_index": 89, "checksum": "2248280089", "data": "\n        # Remove Unicode emojis / high-plane symbol characters (e.g. \ud83d\ude0a, \ud83c\udf1f, \u2728, \ud83d\ude4f)\n        import re\n", "line_end": 450, "line_start": 445}, {"block_index": 90, "checksum": "3010098598", "data": "        # Normalize whitespace\n        text = \" \".join(text.split())\n\n        return text\n", "line_end": 455, "line_start": 450}, {"block_index": 91, "checksum": "3774662857", "data": "    async def synthes