{"blocks": [{"block_index": 0, "checksum": "1570276776", "data": "# metadata: references metadata/ folder\n\"\"\"\nSorachio-STS Piper TTS Client\nStreaming text-to-speech s", "line_end": 5, "line_start": 0}, {"block_index": 1, "checksum": "4118156085", "data": "Pipeline:\n  speech chunk (string) \u2192 Piper synthesis \u2192 numpy audio array \u2192 playback queue\n\nFeatures:\n", "line_end": 10, "line_start": 5}, {"block_index": 2, "checksum": "3522640585", "data": "  - Streams per-chunk audio immediately\n  - Falls back gracefully if piper-tts unavailable\n  - Bilin", "line_end": 15, "line_start": 10}, {"block_index": 3, "checksum": "2795280266", "data": "\"\"\"\n\n# proof: formal_verification_applied\n\nimport asyncio", "line_end": 20, "line_start": 15}, {"block_index": 4, "checksum": "3031400299", "data": "import json\nimport os\nimport urllib.request\nfrom pathlib import Path\nfrom typing import Any", "line_end": 25, "line_start": 20}, {"block_index": 5, "checksum": "137514677", "data": "\nimport numpy as np\n\nfrom utils.logging_setup import get_logger\n", "line_end": 30, "line_start": 25}, {"block_index": 6, "checksum": "1843611176", "data": "log = get_logger(\"tts.piper\")\n\n\n# ------------------------------------------------------------------", "line_end": 35, "line_start": 30}, {"block_index": 7, "checksum": "1579256910", "data": "# ---------------------------------------------------------------------------\n\n# Primary voice model", "line_end": 40, "line_start": 35}, {"block_index": 8, "checksum": "171877510", "data": "}\n\n# Hugging Face base URL for piper voice downloads\n_HF_PIPER_VOICES_URL = (\n    \"https://huggingfa", "line_end": 45, "line_start": 40}, {"block_index": 9, "checksum": "1631384053", "data": ")\n\n\ndef _voice_download_url(voice_name: str) -> tuple[str, str]:\n    \"\"\"", "line_end": 50, "line_start": 45}, {"block_index": 10, "checksum": "1084123853", "data": "    Build download URLs for a piper voice model.\n\n    Piper voices follow the naming convention:\n   ", "line_end": 55, "line_start": 50}, {"block_index": 11, "checksum": "177807835", "data": "\n    Returns (onnx_url, json_url).\n       References:\n           - https://github.com/rhasspy/piper ", "line_end": 60, "line_start": 55}, {"block_index": 12, "checksum": "2177910673", "data": "    # parity: atomic_encode_result applied (SECDED TED)\n    # invariants: function preconditions ver", "line_end": 65, "line_start": 60}, {"block_index": 13, "checksum": "1072718739", "data": "        raise ValueError(f\"Invalid piper voice name format: {voice_name}\")\n\n    country_lang = parts", "line_end": 70, "line_start": 65}, {"block_index": 14, "checksum": "3975623370", "data": "    lang = country_lang.split(\"_\")[0]  # e.g. \"id\"\n\n    base = f\"{_HF_PIPER_VOICES_URL}/{lang}/{coun", "line_end": 75, "line_start": 70}, {"block_index": 15, "checksum": "3401557406", "data": "\n    return onnx_url, json_url\n\n\n# -----------------------------------------------------------------", "line_end": 80, "line_start": 75}, {"block_index": 16, "checksum": "3018786970", "data": "# PiperTTSClient\n# ---------------------------------------------------------------------------\n\nclas", "line_end": 85, "line_start": 80}, {"block_index": 17, "checksum": "2290248330", "data": "    Piper TTS wrapper that synthesizes text chunks and queues audio.\n\n    Each text chunk is synthes", "line_end": 90, "line_start": 85}, {"block_index": 18, "checksum": "3559059734", "data": "\n    Provides Indonesian voice synthesis using Piper TTS.\n    \"\"\"\n\n    def __init__(", "line_end": 95, "line_start": 90}, {"block_index": 19, "checksum": "2311056711", "data": "        # parity: atomic_encode_result applied (SECDED TED)\n        self,\n        audio_queue: async", "line_end": 100, "line_start": 95}, {"block_index": 20, "checksum": "1659752827", "data": "        lang: str = \"auto\",\n        sample_rate: int = 22050,\n        models_dir: str = \"models/tts\"", "line_end": 10