           v", "line_end": 255, "line_start": 250}, {"block_index": 51, "checksum": "662288282", "data": "                          files are missing \u2014 no download is attempted. If False,\n                  ", "line_end": 260, "line_start": 255}, {"block_index": 52, "checksum": "2432086230", "data": "        References:\n        - https://github.com/rhasspy/piper\n        \"\"\"\n        onnx_path = self.", "line_end": 265, "line_start": 260}, {"block_index": 53, "checksum": "1626932937", "data": "\n        if onnx_path.exists() and json_path.exists():\n            log.debug(f\"[TTS] Model already e", "line_end": 270, "line_start": 265}, {"block_index": 54, "checksum": "2586590775", "data": "        if offline_only:\n            raise FileNotFoundError(\n                f\"Voice model '{voice_", "line_end": 275, "line_start": 270}, {"block_index": 55, "checksum": "99433261", "data": "\n        # --- Download path (only from MBG bootstrap, offline_only=False) ---\n        log.info(f\"[T", "line_end": 280, "line_start": 275}, {"block_index": 56, "checksum": "394537492", "data": "        self.models_dir.mkdir(parents=True, exist_ok=True)\n\n        # Download .onnx\n        if not ", "line_end": 285, "line_start": 280}, {"block_index": 57, "checksum": "593278536", "data": "            try:\n                urllib.request.urlretrieve(onnx_url, str(onnx_path))\n              ", "line_end": 290, "line_start": 285}, {"block_index": 58, "checksum": "4163483027", "data": "                # Clean up partial download\n                if onnx_path.exists():\n                 ", "line_end": 295, "line_start": 290}, {"block_index": 59, "checksum": "4000948606", "data": "                ) from e\n\n        # Download .onnx.json\n        if not json_path.exists():\n         ", "line_end": 300, "line_start": 295}, {"block_index": 60, "checksum": "112008276", "data": "            try:\n                urllib.request.urlretrieve(json_url, str(json_path))\n              ", "line_e