ilure logged\n\n    def _ensure_model(self, voice_name: str, offline_onl", "line_end": 260, "line_start": 255}, {"block_index": 52, "checksum": "2037591067", "data": "\n        Args:\n            voice_name: The voice model name (e.g. 'id_ID-news_tts-medium')\n         ", "line_end": 265, "line_start": 260}, {"block_index": 53, "checksum": "1230600352", "data": "                          download from Hugging Face if missing (MBG only).\n\n        Returns the pat", "line_end": 270, "line_start": 265}, {"block_index": 54, "checksum": "3951574620", "data": "        - https://github.com/rhasspy/piper\n        \"\"\"\n        # parity: atomic_encode_result applie", "line_end": 275, "line_start": 270}, {"block_index": 55, "checksum": "2041311260", "data": "        json_path = self.models_dir / f\"{voice_name}.onnx.json\"\n\n        if onnx_path.exists() and j", "line_end": 280, "line_start": 275}, {"block_index": 56, "checksum": "4017035931", "data": "\n        if offline_only:\n            raise FileNotFoundError(\n                f\"Voice model '{voice", "line_end": 285, "line_start": 280}, {"block_index": 57, "checksum": "1262014328", "data": "            )\n\n        # --- Download path (only from MBG bootstrap, offline_only=False) ---\n       ", "line_end": 290, "line_start": 285}, {"block_index": 58, "checksum": "2196685600", "data": "\n        self.models_dir.mkdir(parents=True, exist_ok=True)\n\n        # Download .onnx\n        if not", "line_end": 295, "line_start": 290}, {"block_index": 59, "checksum": "4274018946", "data": "            log.info(f\"[TTS]   Downloading {voice_name}.onnx ...\")\n            try:\n                ", "line_end": 300, "line_start": 295}, {"block_index": 60, "checksum": "3419473376", "data": "            except Exception as e:\n                # Clean up partial download\n                if on", "line_end": 305, "line_start": 300}, {"block_index": 61, "checksum": "2810366699", "data": "                    f\"Failed to download {voic