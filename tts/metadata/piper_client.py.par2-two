5, "line_start": 350}, {"block_index": 71, "checksum": "2928956155", "data": "            first_lang = next(iter(self._voices))\n            return self._voices[first_lang], self.", "line_end": 360, "line_start": 355}, {"block_index": 72, "checksum": "99940998", "data": "    def _detect_text_language(self, text: str) -> str | None:\n        \"\"\"\n        Lightweight langua", "line_end": 365, "line_start": 360}, {"block_index": 73, "checksum": "491112181", "data": "        References:\n        - https://github.com/rhasspy/piper\n        \"\"\"\n        if not text:\n    ", "line_end": 370, "line_start": 365}, {"block_index": 74, "checksum": "4035311880", "data": "\n        # Check for common Indonesian words before relying on naive langdetect n-grams\n        id_k", "line_end": 375, "line_start": 370}, {"block_index": 75, "checksum": "3591183640", "data": "            \"perkenalkan\", \"diri\", \"hari\", \"merasa\", \"teman\", \"setia\", \"sekali\", \"baik\"\n        }\n  ", "line_end": 380, "line_start": 375}, {"block_index": 76, "checksum": "3493365905", "data": "            return \"id\"\n\n        try:\n            from langdetect import DetectorFactory, detect\n   ", "line_end": 385, "line_start": 380}, {"block_index": 77, "checksum": "2984252410", "data": "            DetectorFactory.seed = 0\n            detected = detect(text)\n            if detected in ", "line_end": 390, "line_start": 385}, {"block_index": 78, "checksum": "3627047982", "data": "        except Exception as e:\n            log.warning(\"[Piper] langdetect failed (non-fatal): %s\", ", "line_end": 395, "line_start": 390}, {"block_index": 79, "checksum": "2632942485", "data": "        \"\"\"\n        Clean problematic text before sending to Piper.\n        Prevents crashes from sp", "line_end": 400, "line_start": 395}, {"block_index": 80, "checksum": "1613799328", "data": "        - https://github.com/rhasspy/piper\n        \"\"\"\n\n        if not text:\n            return \"\"", "line_end":