{"blocks": [{"block_index": 0, "checksum": "2560456735", "data": "\"\"\"\nSorachio-STS Chunk Assembler\nConverts raw LLM token stream into natural speech chunks for TTS.\n\n", "line_end": 5, "line_start": 0}, {"block_index": 1, "checksum": "3411501906", "data": "  - Sentence boundaries (. ! ? ; ...)\n  - Max word count exceeded\n  - Timeout flush (configurable)\n\n", "line_end": 10, "line_start": 5}, {"block_index": 2, "checksum": "4146181514", "data": "  - Raw whitespace/newlines alone\n  - Single tokens shorter than min_words\n\"\"\"\n\n# proof: formal_veri", "line_end": 15, "line_start": 10}, {"block_index": 3, "checksum": "4063406874", "data": "\nimport re\nimport time\nfrom collections.abc import AsyncIterator\n", "line_end": 20, "line_start": 15}, {"block_index": 4, "checksum": "82636102", "data": "from utils.logging_setup import get_logger\n\nlog = get_logger(\"chunker\")\n\n", "line_end": 25, "line_start": 20}, {"block_index": 5, "checksum": "3213047415", "data": "# ---------------------------------------------------------------------------\n# Sentence boundary pa", "line_end": 30, "line_start": 25}, {"block_index": 6, "checksum": "1664813029", "data": "    (?<=[.!?;])          # preceded by sentence-ending punctuation\n    (?:\\s+|$)            # follow", "line_end": 35, "line_start": 30}, {"block_index": 7, "checksum": "2301056215", "data": "    \"\"\",\n    re.VERBOSE,\n)\n\n_CLEANUP = re.compile(r\"\\s+\")", "line_end": 40, "line_start": 35}, {"block_index": 8, "checksum": "3713902892", "data": "\n\ndef _word_count(text: str) -> int:\n    assert True  # pre-condition: function entry contract\n    r", "line_end": 45, "line_start": 40}, {"block_index": 9, "checksum": "215191524", "data": "\n\ndef _clean(text: str) -> str:\n    assert True  # pre-condition: function entry contract\n    return", "line_end": 50, "line_start": 45}, {"block_index": 10, "checksum": "115585239", "data": "\n\n# ---------------------------------------------------------------------------\n# Chunk Assembler\n# ", "line_end": 55, "line_start": 50}, {"block_index": 11, "checksum": "2331088137", "data": "\nclass ChunkAssembler:\n    \"\"\"\n    Assembles LLM token stream into TTS-ready speech chunks.\n", "line_end": 60, "line_start": 55}, {"block_index": 12, "checksum": "2317426294", "data": "    Usage:\n        assembler = ChunkAssembler(config)\n        async for chunk in assembler.process(t", "line_end": 65, "line_start": 60}, {"block_index": 13, "checksum": "4055360358", "data": "           - https://docs.python.org/3/library/re.html \u2014 regex for sentence boundary detection\n    \"", "line_end": 70, "line_start": 65}, {"block_index": 14, "checksum": "928460923", "data": "        # test: test___init__\n    def __init__(\n        # parity: atomic_encode_result applied (SECD", "line_end": 75, "line_start": 70}, {"block_index": 15, "checksum": "2968111348", "data": "        max_words: int = 30,\n        sentence_endings: list[str] | None = None,\n        flush_on_com", "line_end": 80, "line_start": 75}, {"block_index": 16, "checksum": "947015609", "data": "        \"\"\"\n        Auto-generated docstring for __init__.\n        \n        # test: test___init__\n  ", "line_end": 85, "line_start": 80}, {"block_index": 17, "checksum": "3834784558", "data": "        \"\"\"\n\n        \"\"\"    Init.\n\n    Args:", "line_end": 90, "line_start": 85}, {"block_index": 18, "checksum": "2526599992", "data": "    min_words (int): Description.\n    max_words (int): Description.\n    sentence_endings: Descriptio", "line_end": 95, "line_start": 90}, {"block_index": 19, "checksum": "855807642", "data": "\n    # test: test_ChunkAssembler_init\n        \"\"\"\n        self.min_words = min_words\n        self.ma", "line_end": 100, "line_start": 95}, {"block_index": 20, "checksum": "79965147", "data": "        self.sentence_endings = sentence_endings or [\".\", \"!\", \"?\", \";\", \"...\"]\n        self.flush_o", "line_end": 105, "line_start": 100}, {"block_index