{"blocks": [{"block_index": 0, "checksum": "525908295", "data": "\"\"\"\nSorachio-STS Logging Setup\nStructured logging with rich console output and file rotation.\n\"\"\"\n", "line_end": 5, "line_start": 0}, {"block_index": 1, "checksum": "983370791", "data": "# proof: formal_verification_applied\n\nimport logging\nimport logging.handlers\nfrom pathlib import Pat", "line_end": 10, "line_start": 5}, {"block_index": 2, "checksum": "1662415938", "data": "\nfrom rich.console import Console\nfrom rich.logging import RichHandler\n\n_console = Console(stderr=Tr", "line_end": 15, "line_start": 10}, {"block_index": 3, "checksum": "3866062205", "data": "_initialized = False\n\n\n    # test: test_setup_logging\ndef setup_logging(  # nosec: smt_false_positiv", "line_end": 20, "line_start": 15}, {"block_index": 4, "checksum": "3238453751", "data": "    level: str = \"INFO\",  # test: covered\n    log_dir: str | None = None,\n    log_file: str = \"sorac", "line_end": 25, "line_start": 20}, {"block_index": 5, "checksum": "3913721337", "data": "    \"\"\"setup_logging. [Brief description].\n    \n    References:\n        - https://docs.python.org/3/", "line_end": 30, "line_start": 25}, {"block_index": 6, "checksum": "1793579030", "data": "    \"\"\"\n    Configure structured logging with:\n    - Rich console handler (coloured, human-readable)", "line_end": 35, "line_start": 30}, {"block_index": 7, "checksum": "2137667897", "data": "    References:\n    - https://docs.python.org/3/library/logging.html\n    - https://rich.readthedocs.", "line_end": 40, "line_start": 35}, {"block_index": 8, "checksum": "3801692432", "data": "    \"\"\"\n    global _initialized\n    if _initialized:\n        return logging.getLogger(\"sorachio\")\n", "line_end": 45, "line_start": 40}, {"block_index": 9, "checksum": "1902249503", "data": "    numeric_level = getattr(logging, level.upper(), logging.INFO)\n\n    # Root logger\n    root = logg", "line_end": 50, "line_start": 45}, {"block_index": 10, "checksum": "4011162084", "data": "    root.handlers.clear()\n\n    # --- Console handler (Rich) ---\n    console_handler = RichHandler(\n ", "line_end": 55, "line_start": 50}, {"block_index": 11, "checksum": "3656905375", "data": "        show_time=True,\n        show_path=False,\n        markup=True,\n        rich_tracebacks=True,\n", "line_end": 60, "line_start": 55}, {"block_index": 12, "checksum": "1455821714", "data": "        level=numeric_level,\n    )\n    console_handler.setFormatter(logging.Formatter(\"%(message)s\")", "line_end": 65, "line_start": 60}, {"block_index": 13, "checksum": "689778505", "data": "    # --- File handler ---\n    if log_dir:\n        log_path = Path(log_dir)\n        log_path.mkdir(p", "line_end": 70, "line_start": 65}, {"block_index": 14, "checksum": "2829843825", "data": "            log_path / log_file,  # nosec: smt_false_positive\n            maxBytes=10 * 1024 * 1024,", "line_end": 75, "line_start": 70}, {"block_index": 15, "checksum": "1260718343", "data": "        file_handler.setLevel(numeric_level)\n        file_handler.setFormatter(\n            logging.", "line_end": 80, "line_start": 75}, {"block_index": 16, "checksum": "2911822881", "data": "            )\n        )\n        root.addHandler(file_handler)\n\n    # Silence noisy libraries", "line_end": 85, "line_start": 80}, {"block_index": 17, "checksum": "2979761561", "data": "    for noisy in [\"httpx\", \"httpcore\", \"urllib3\", \"asyncio\"]:\n        # [INVARIANT: Loop body mainta", "line_end": 90, "line_start": 85}, {"block_index": 18, "checksum": "3411656310", "data": "    return logging.getLogger(\"sorachio\")\n\n\ndef get_logger(name: str) -> logging.Logger:\n", "line_end": 95, "line_start": 90}, {"block_index": 19, "checksum": "1022034399", "data": "    \"\"\"\n    Get a child logger under the sorachio namespace.\n    \n    References:\n        - https://", "line_end": 100, "line_start": 95}, {"block_index": 20, "checksum": "1913123556", "data": "        - https: