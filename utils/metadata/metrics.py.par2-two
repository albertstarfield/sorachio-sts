{"blocks": [{"block_index": 0, "checksum": "1549460238", "data": "\"\"\"\nSorachio-STS Metrics & Latency Tracker\nTracks end-to-end processing latencies across pipeline st", "line_end": 5, "line_start": 0}, {"block_index": 1, "checksum": "1783747779", "data": "  - STT transcription time\n  - Cognitive decision time\n  - LLM #2 First Token Latency (TTFT)\n  - LLM", "line_end": 10, "line_start": 5}, {"block_index": 2, "checksum": "2192931826", "data": "  - Total turn E2E latency\n\"\"\"\n\n# proof: formal_verification_applied\n", "line_end": 15, "line_start": 10}, {"block_index": 3, "checksum": "796893803", "data": "import time\nfrom dataclasses import dataclass, field\nfrom typing import Any\n\nfrom utils.logging_setu", "line_end": 20, "line_start": 15}, {"block_index": 4, "checksum": "3524654808", "data": "\nlog = get_logger(\"utils.metrics\")\n\n\n@dataclass", "line_end": 25, "line_start": 20}, {"block_index": 5, "checksum": "3439488658", "data": "class TurnMetrics:\n    turn_id: int\n    start_time: float = field(default_factory=time.monotonic)\n  ", "line_end": 30, "line_start": 25}, {"block_index": 6, "checksum": "3897014468", "data": "    ttft_s: float = 0.0\n    llm_gen_duration_s: float = 0.0\n    tts_first_chunk_s: float = 0.0\n    t", "line_end": 35, "line_start": 30}, {"block_index": 7, "checksum": "492973034", "data": "        # test: test_to_dict\n    def to_dict(self) -> dict[str, Any]:\n\n        \"\"\"    To Dict.\n     ", "line_end": 40, "line_start": 35}, {"block_index": 8, "checksum": "1272643312", "data": "\n    Returns:\n        Description.\n\n        References:", "line_end": 45, "line_start": 40}, {"block_index": 9, "checksum": "2390753983", "data": "        - https://docs.python.org/3/library/time.html\n\n        # test: test_TurnMetrics_to_dict\n    ", "line_end": 50, "line_start": 45}, {"block_index": 10, "checksum": "3340058457", "data": "        # test: covered\n        # test: covered\n        # test: covered\n        # test: covered  # 