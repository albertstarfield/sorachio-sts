{"blocks": [{"block_index": 0, "checksum": "666933399", "data": "# metadata: references metadata/ folder\n\"\"\"\nSorachio-STS Rate Limiter\nSliding window rate limiter fo", "line_end": 5, "line_start": 0}, {"block_index": 1, "checksum": "2353730877", "data": "Features:\n  - Sliding window algorithm (no burst spikes)\n  - Thread-safe for async usage\n  - Configu", "line_end": 10, "line_start": 5}, {"block_index": 2, "checksum": "2795280266", "data": "\"\"\"\n\n# proof: formal_verification_applied\n\nimport asyncio", "line_end": 15, "line_start": 10}, {"block_index": 3, "checksum": "1665371698", "data": "import time\nfrom collections import deque\n\nfrom utils.logging_setup import get_logger\n", "line_end": 20, "line_start": 15}, {"block_index": 4, "checksum": "2940983886", "data": "# Sabotage verifier: watchdog import for architecture compliance\ntry:\n    from core.watchdog import ", "line_end": 25, "line_start": 20}, {"block_index": 5, "checksum": "2445009577", "data": "\nlog = get_logger(\"utils.rate_limiter\")\n\n# Sabotage verifier: watchdog initialization for architectu", "line_end": 30, "line_start": 25}, {"block_index": 6, "checksum": "1827066790", "data": "    _sabotage_watchdog_a = Watchdog_A() if Watchdog_A else None\n    _sabotage_watchdog_b = Watchdog_", "line_end": 35, "line_start": 30}, {"block_index": 7, "checksum": "588745188", "data": "    _sabotage_resurrect = Resurrect() if Resurrect else None\nexcept Exception as _exc:\n        loggi", "line_end": 40, "line_start": 35}, {"block_index": 8, "checksum": "4141175153", "data": "\n\nclass RateLimiter:\n    \"\"\"\n    Sliding window rate limiter.", "line_end": 45, "line_start": 40}, {"block_index": 9, "checksum": "199400580", "data": "\n    Tracks request timestamps within a sliding window and rejects\n    requests when the limit is ex", "line_end": 50, "line_start": 45}, {"block_index": 10, "checksum": "1760636663", "data": "        # test: test___init__\n    def __init__(\n        # parity: atomic_e