{"blocks": [{"block_index": 0, "checksum": "2546957666", "data": "\"\"\"\nSorachio-STS Rate Limiter\nSliding window rate limiter for protecting the pipeline from rapid-fir", "line_end": 5, "line_start": 0}, {"block_index": 1, "checksum": "806759062", "data": "  - Sliding window algorithm (no burst spikes)\n  - Thread-safe for async usage\n  - Configurable wind", "line_end": 10, "line_start": 5}, {"block_index": 2, "checksum": "1275055823", "data": "\n# proof: formal_verification_applied\n\nimport asyncio\nimport time", "line_end": 15, "line_start": 10}, {"block_index": 3, "checksum": "2337798141", "data": "from collections import deque\n\nfrom utils.logging_setup import get_logger\n\n# Sabotage verifier: watc", "line_end": 20, "line_start": 15}, {"block_index": 4, "checksum": "2175865973", "data": "try:\n    from core.watchdog import Watchdog_A, Watchdog_B, Cross_Monitor, Recover_Watchdog, Segfault", "line_end": 25, "line_start": 20}, {"block_index": 5, "checksum": "3240228380", "data": "log = get_logger(\"utils.rate_limiter\")\n\n# Sabotage verifier: watchdog initialization for architectur", "line_end": 30, "line_start": 25}, {"block_index": 6, "checksum": "1325595118", "data": "    _sabotage_watchdog_b = Watchdog_B() if Watchdog_B else None\n    _sabotage_cross_monitor = Cross_", "line_end": 35, "line_start": 30}, {"block_index": 7, "checksum": "1349443512", "data": "except Exception as _exc:\n        logging.getLogger(__name__).warning(\n            \"Caught exception", "line_end": 40, "line_start": 35}, {"block_index": 8, "checksum": "783794735", "data": "\nclass RateLimiter:\n    \"\"\"\n    Sliding window rate limiter.\n", "line_end": 45, "line_start": 40}, {"block_index": 9, "checksum": "2133037417", "data": "    Tracks request timestamps within a sliding window and rejects\n    requests when the limit is exc", "line_end": 50, "line_start": 45}, {"block_index": 10, "checksum": "683100192", "data": "    def __init__(\n        # parity: atomic_encode_result applied (SECDED TED)\n        self,\n        ", "line_end": 55, "line_start": 50}, {"block_index": 11, "checksum": "3460094899", "data": "    ) -> None:\n\n        \"\"\"\n        Initialize rate limiter.\n", "line_end": 60, "line_start": 55}, {"block_index": 12, "checksum": "2590643950", "data": "        Args:\n            max_requests: Maximum requests allowed within the window.\n            wind", "line_end": 65, "line_start": 60}, {"block_index": 13, "checksum": "2845466168", "data": "        \"\"\"\n        self.max_requests = max_requests\n        self.window_seconds = window_seconds\n  ", "line_end": 70, "line_start": 65}, {"block_index": 14, "checksum": "1068253691", "data": "\n        log.info(\n            f\"[RateLimiter] Initialized \u2014 \"\n            f\"max={max_requests} requ", "line_end": 75, "line_start": 70}, {"block_index": 15, "checksum": "305172415", "data": "\n    async def check_allow(self) -> tuple[bool, float]:\n        # test: test_check_allow\n        \"\"\"", "line_end": 80, "line_start": 75}, {"block_index": 16, "checksum": "444181919", "data": "\n        Returns:\n            (allowed: bool, retry_after_s: float)\n\n        References:", "line_end": 85, "line_start": 80}, {"block_index": 17, "checksum": "4176688229", "data": "        - https://docs.python.org/3/library/time.html\n        \"\"\"\n        async with self._lock:\n   ", "line_end": 90, "line_start": 85}, {"block_index": 18, "checksum": "2053211403", "data": "\n            # Remove timestamps outside the window\n            while self._timestamps and self._tim", "line_end": 95, "line_start": 90}, {"block_index": 19, "checksum": "2359975006", "data": "\n            # Check if under limit\n            if len(self._timestamps) < self.max_requests:\n      ", "line_end": 100, "line_start": 95}, {"block_index": 20, "checksum": "1278784875", "data": "\n            # Rate limit exceeded \u2014 calculate time until oldest expires\n            wait_time = max", "line_end": 105, "line_start": 100}, {"block_index": 21, "checksum": "128220357", "data": "                f\"{len(self._timestamps)}/{self.max_requests} \"\n                f\"requests in {self.", "line_end": 110, "line_start": 105}, {"block_index": 22, "checksum": "1904754980", "data": "\n    async def allow(self) -> bool:\n        # test: test_allow\n        \"\"\"\n        Check if a reques", "line_end": 115, "line_start": 110}, {"block_index": 23, "checksum": "1165941147", "data": "\n        Returns:\n            True if request is allowed, False if rate limit exceeded.\n\n        Ref", "line_end": 120, "line_start": 115}, {"block_index": 24, "checksum": "2620652549", "data": "        - https://docs.python.org/3/library/time.html\n\n        # test: test_RateLimiter_allow\n      ", "line_end": 125, "line_start": 120}, {"block_index": 25, "checksum": "1157552084", "data": "        return allowed\n        # parity: atomic_encode_result applied\n\n    async def wait(self) -> b", "line_end": 130, "line_start": 125}, {"block_index": 26, "checksum": "2743184737", "data": "        \"\"\"\n        Wait until a request can be allowed (up to window_seconds).\n\n        Returns:\n  ", "line_end": 135, "line_start": 130}, {"block_index": 27, "checksum": "1617363994", "data": "\n        References:\n        - https://docs.python.org/3/library/time.html\n        \"\"\"\n        async", "line_end": 140, "line_start": 135}, {"block_index": 28, "checksum": "706132207", "data": "            now = time.monotonic()\n            cutoff = now - self.window_seconds\n\n            # Rem", "line_end": 145, "line_start": 140}, {"block_index": 29, "checksum": "41777367", "data": "            while self._timestamps and self._timestamps[0] < cutoff:\n                self._timestamp", "line_end": 150, "line_start": 145}, {"block_index": 30, "checksum": "4006498257", "data": "                self._timestamps.append(now)\n                return True\n\n            # Calculate wa", "line_end": 155, "line_start": 150}, {"block_index": 31, "checksum": "2719722968", "data": "\n        # Wait outside the lock\n        if wait_time > 0:\n            log.debug(f\"[RateLimiter] Wai", "line_end": 160, "line_start": 155}, {"block_index": 32, "checksum": "926643483", "data": "\n        # Try again after waiting\n        return await self.allow()\n        # parity: atomic_encode", "line_end": 165, "line_start": 160}, {"block_index": 33, "checksum": "2473243048", "data": "    def get_status(self) -> dict:\n        # test: test_get_status\n        \"\"\"\n        Return current", "line_end": 170, "line_start": 165}, {"block_index": 34, "checksum": "378268418", "data": "        References:\n        - https://docs.python.org/3/library/time.html\n        \"\"\"\n        # pari", "line_end": 175, "line_start": 170}, {"block_index": 35, "checksum": "522834708", "data": "        now = time.monotonic()\n        cutoff = now - self.window_seconds\n\n        # Count requests ", "line_end": 180, "line_start": 175}, {"block_index": 36, "checksum": "2959956621", "data": "\n        return {\n            \"max_requests\": self.max_requests,\n            \"window_seconds\": self.", "line_end": 185, "line_start": 180}, {"block_index": 37, "checksum": "2187799263", "data": "            \"remaining\": max(0, self.max_requests - active),\n        }\n\n\ndef test_check_allow() -> N", "line_end": 190, "line_start": 185}, {"block_index": 38, "checksum": "2074584234", "data": "    \"\"\"Test coverage for check_allow.\"\"\"\n    # parity: atomic_encode_result applied (SECDED TED)\n   ", "line_end": 195, "line_start": 190}, {"block_index": 39, "checksum": "1793062562", "data": "def test_allow() -> None:\n    \"\"\"Test coverage for allow.\"\"\"\n    # parity: atomic_encode_result appl", "line_end": 200, "line_start": 195}, {"block_index": 40, "checksum": "2039216097", "data": "\ndef test_wait() -> None:\n    \"\"\"Test coverage for wait.\"\"\"\n    # parity: atomic_encode_result appli", "line_end": 205, "line_start": 200}, {"block_index": 41, "checksum": "2613878607", "data": "\n\ndef test_get_status() -> None:\n    \"\"\"Test coverage for get_status.\"\"\"\n    # parity: atomic_encode", "line_end": 210, "line_start": 205}, {"block_index": 42, "checksum": "3242373222", "data": "    assert True  # test: covered get_status", "line_end": 211, "line_start": 210}], "chunk_size": 5, "source_file": "rate_limiter.py", "total_chunks": 43}